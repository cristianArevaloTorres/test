/*
  Ejecutar en PlataformaPlus, en la misma instancia configurada para el worker.
  Solo consulta SAF y PlataformaPlus; no ejecuta los SP ni modifica datos de negocio.
  La consulta de SAF reproduce la rama TipoGeneracion = 'F' del SP exportado de DEV.
  Antes de usarla como referencia definitiva, confirmar que el SP instalado
  dbo.Sp_Saf_ObtenerCuentasComprobanteFiscalFacturacionXPeriodo no haya cambiado.
  Acotar el rango de anios para evitar leer todo el historico del linked server.
*/
USE [PlataformaPlus];
GO

SET NOCOUNT ON;

DECLARE @AnioDesde int = 2025;
DECLARE @AnioHasta int = 2026;

IF @AnioDesde > @AnioHasta
BEGIN
    RAISERROR('AnioDesde debe ser menor o igual que AnioHasta.', 16, 1);
    RETURN;
END;

IF OBJECT_ID('tempdb..#CuentasConInsumo') IS NOT NULL
    DROP TABLE #CuentasConInsumo;

-- El SP cruza CC_SALDOS_MES y CC_CUENTA solo por NUM_CUENTA. El worker
-- elimina duplicados y recorta espacios al leer la primera columna.
SELECT DISTINCT
       M.ANIO_CORTE AS Anio,
       M.MES_CORTE AS Mes,
       LTRIM(RTRIM(CONVERT(varchar(200), M.NUM_CUENTA))) COLLATE DATABASE_DEFAULT AS NumeroCuenta
INTO #CuentasConInsumo
FROM [BDESBDPPL01\SAFBD].[SAF].[CC].[CC_SALDOS_MES] AS M
INNER JOIN [BDESBDPPL01\SAFBD].[SAF].[CC].[CC_CUENTA] AS C
        ON M.NUM_CUENTA = C.NUM_CUENTA
WHERE M.Cod_Empresa = 'AKALA'
  AND M.ANIO_CORTE BETWEEN @AnioDesde AND @AnioHasta
  AND M.MES_CORTE BETWEEN 1 AND 12
  AND M.IND_ESTADO IN ('A', 'B', 'T')
  AND (M.SAL_TOTAL_CUENTA > 0 OR M.SAL_PROMEDIO > 0)
OPTION (RECOMPILE);

;WITH Encabezados AS
(
    SELECT H.Anio,
           H.Mes,
           H.NumeroCuentaCredito,
           COUNT_BIG(*) AS Cantidad,
           MAX(H.FechaGeneracion) AS FechaGeneracion,
           MAX(CONVERT(int, H.Adenda)) AS Adenda
    FROM dbo.tb_FacturacionLayout AS H
    WHERE H.Sistema = 'CUENTAS'
      AND H.Anio BETWEEN @AnioDesde AND @AnioHasta
    GROUP BY H.Anio, H.Mes, H.NumeroCuentaCredito
)
SELECT I.Anio,
       I.Mes,
       COUNT_BIG(*) AS CuentasConInsumoSAF,
       SUM(CASE WHEN LEN(I.NumeroCuenta) NOT BETWEEN 1 AND 15 THEN 1 ELSE 0 END) AS CuentasInvalidasParaWorker,
       SUM(CASE WHEN H.Cantidad IS NULL THEN 1 ELSE 0 END) AS SinEncabezadoCUENTAS,
       SUM(CASE WHEN H.Cantidad = 1 AND H.FechaGeneracion IS NULL THEN 1 ELSE 0 END) AS EncabezadoSinFecha,
       SUM(CASE WHEN H.Cantidad > 1 THEN 1 ELSE 0 END) AS EncabezadoDuplicado,
       SUM(CASE WHEN H.Cantidad = 1
                     AND H.FechaGeneracion IS NOT NULL
                     AND ISNULL(H.Adenda, 0) = 0
                     AND LEN(I.NumeroCuenta) BETWEEN 1 AND 15
                THEN 1 ELSE 0 END) AS CandidatasConEncabezadoSinAdenda,
       SUM(CASE WHEN H.Cantidad = 1 AND H.Adenda = 1 THEN 1 ELSE 0 END) AS EncabezadoConAdendaMarcada
FROM #CuentasConInsumo AS I
LEFT JOIN Encabezados AS H
       ON H.Anio = I.Anio
      AND H.Mes = I.Mes
      AND H.NumeroCuentaCredito = I.NumeroCuenta
GROUP BY I.Anio, I.Mes
ORDER BY I.Anio DESC, I.Mes DESC
OPTION (RECOMPILE);

/*
  CuentasConInsumoSAF indica los meses/anios que el SP de periodo podria devolver.
  CandidatasConEncabezadoSinAdenda NO descarta layouts 11-18 ya existentes;
  el worker hace esa validacion adicional y tambien puede limitar MaxCuentas.
  Si el linked server no existe con este nombre, consultar la definicion del
  SP instalado para usar el nombre de servidor correspondiente a ese ambiente.
*/
