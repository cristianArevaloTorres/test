/*
    EXTRACTOR DE DATOS PARA HOMOLOGAR B2 CONTRA B3

    Empresa:              2185 - ZURICH ASEGURADORA
    Vigencia:             4067 - 2025-2026
    Periodo Sabana:       2025-10-13 a 2026-09-30
    Periodo Cobranza:     2026-09-01 a 2026-09-30
    Base:                 FlexiForbesv2

    USO
    1. Ejecutar en la base ORIGEN que si contiene la informacion real.
    2. Exportar cada resultset conservando el nombre indicado en __Tabla.
    3. No ejecutar como script de carga: este archivo solo hace SELECT.

    El alcance incluye los datos fuente usados por los SP de Sabana y
    Cobranza B2/B3, la configuracion del Excel y los folios consultados por
    la API Java. No exporta las tablas de cache como insumo: el cache es
    derivado y debe reconstruirse en local despues de cargar las fuentes.
*/

USE [FlexiForbesv2];
GO

SET NOCOUNT ON;
SET XACT_ABORT ON;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

DECLARE @IdEmpresa                int  = 2185,
        @IdVigencia               int  = 4067,
        @FechaInicioSabana        date = '20251013',
        @FechaFinSabana           date = '20260930',
        @FechaFinSabanaExclusiva  date = '20261001',
        @FechaInicioCobranza      date = '20260901',
        @FechaFinCobranza         date = '20260930',
        @FechaFinCobExclusiva     date = '20261001',
        @IdConfiguracion          int,
        @IdCorporativo            int;

IF NOT EXISTS
(
    SELECT 1
    FROM dbo.ff_Empresa
    WHERE EMIdEmpresa = @IdEmpresa
)
    THROW 55000, 'No existe la empresa 2185 en la base origen.', 1;

SELECT @IdConfiguracion = E.EMIdConfiguracion,
       @IdCorporativo = E.EMIdCorporativo
FROM dbo.ff_Empresa AS E
WHERE E.EMIdEmpresa = @IdEmpresa;

IF NOT EXISTS
(
    SELECT 1
    FROM dbo.ff_Vigencia
    WHERE VIIdVigencia = @IdVigencia
      AND VIIdConfiguracion = @IdConfiguracion
)
    THROW 55001, 'La vigencia 4067 no pertenece a la configuracion de la empresa 2185.', 1;

DECLARE @Empresas TABLE
(
    IdEmpresa int NOT NULL PRIMARY KEY
);

INSERT @Empresas(IdEmpresa)
VALUES (@IdEmpresa);

/* Solo se agregan filiales cuando la empresa solicitada es el corporativo. */
IF @IdCorporativo = @IdEmpresa
BEGIN
    INSERT @Empresas(IdEmpresa)
    SELECT E.EMIdEmpresa
    FROM dbo.ff_Empresa AS E
    WHERE E.EMIdCorporativo = @IdEmpresa
      AND E.EMIdEmpresa <> @IdEmpresa
      AND E.EMIdEstatus = 1
      AND NOT EXISTS
          (SELECT 1 FROM @Empresas AS X WHERE X.IdEmpresa = E.EMIdEmpresa);
END;

DECLARE @EmpresasConfiguracion TABLE
(
    IdEmpresa int NOT NULL PRIMARY KEY
);

INSERT @EmpresasConfiguracion(IdEmpresa)
VALUES (0);

INSERT @EmpresasConfiguracion(IdEmpresa)
SELECT E.IdEmpresa
FROM @Empresas AS E
WHERE NOT EXISTS
      (SELECT 1 FROM @EmpresasConfiguracion C WHERE C.IdEmpresa = E.IdEmpresa);

IF ISNULL(@IdCorporativo, 0) <> 0
   AND NOT EXISTS
       (SELECT 1 FROM @EmpresasConfiguracion WHERE IdEmpresa = @IdCorporativo)
BEGIN
    INSERT @EmpresasConfiguracion(IdEmpresa)
    VALUES (@IdCorporativo);
END;

DECLARE @Solicitudes TABLE
(
    IdSolicitud int NOT NULL,
    IdEmpresa   int NOT NULL,
    PRIMARY KEY (IdSolicitud, IdEmpresa)
);

/*
   La vigencia cubre el universo B3. Las fechas adicionales cubren B2, cuyo
   SP de Cobranza no recibe vigencia y decide movimientos por fecha.
*/
INSERT @Solicitudes(IdSolicitud, IdEmpresa)
SELECT DISTINCT S.SOIdSolicitud, S.SOIdEmpresa
FROM dbo.ff_Solicitud AS S
INNER JOIN @Empresas AS E
        ON E.IdEmpresa = S.SOIdEmpresa
WHERE S.SOIdVigencia = @IdVigencia
   OR (S.SOFechaAprovacion >= @FechaInicioSabana
       AND S.SOFechaAprovacion < @FechaFinSabanaExclusiva)
   OR (S.SOFechaEstatus >= @FechaInicioSabana
       AND S.SOFechaEstatus < @FechaFinSabanaExclusiva);

DECLARE @Empleados TABLE
(
    IdEmpleado     int         NOT NULL PRIMARY KEY,
    IdEmpresa      int         NOT NULL,
    NumeroEmpleado varchar(50) NULL
);

INSERT @Empleados(IdEmpleado, IdEmpresa, NumeroEmpleado)
SELECT E.Id, E.EMIdEmpresa, E.EMNumeroEmpleado
FROM dbo.ff_Empleado AS E
INNER JOIN @Empresas AS X
        ON X.IdEmpresa = E.EMIdEmpresa;

DECLARE @Perfiles TABLE
(
    IdPerfil int NOT NULL PRIMARY KEY
);

INSERT @Perfiles(IdPerfil)
SELECT DISTINCT P.PEIdPerfil
FROM dbo.ff_Perfil AS P
INNER JOIN @Empresas AS E
        ON E.IdEmpresa = P.PEIdEmpresa
UNION
SELECT DISTINCT E.EMIdPerfil
FROM dbo.ff_Empleado AS E
INNER JOIN @Empresas AS X
        ON X.IdEmpresa = E.EMIdEmpresa
WHERE E.EMIdPerfil IS NOT NULL;

DECLARE @PlanOpciones TABLE
(
    IdPlanOpcion int NOT NULL PRIMARY KEY
);

INSERT @PlanOpciones(IdPlanOpcion)
SELECT DISTINCT PP.PPIdPlanOpcion
FROM dbo.ff_PlanOpcionPerfil AS PP
WHERE PP.PPIdPerfil IN (SELECT IdPerfil FROM @Perfiles)
UNION
SELECT DISTINCT POS.POIdPlanOpcion
FROM dbo.ff_PlanOpcionSeleccion AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud
       AND S.IdEmpresa = POS.POIdEmpresa
WHERE POS.POIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT POS.POIdPlanOpcion
FROM dbo.ff_PlanOpcionSeleccionCobranza AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud
       AND S.IdEmpresa = POS.POIdEmpresa
WHERE POS.POIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT POS.POIdPlanOpcion
FROM dbo.ff_PlanOpcionSeleccionCobranza2 AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud
       AND S.IdEmpresa = POS.POIdEmpresa
WHERE POS.POIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT EC.ECIdPlanOpcion
FROM dbo.ff_EdoCuenta AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud
       AND S.IdEmpresa = EC.ECIdEmpresa
WHERE EC.ECIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT EC.ECIdPlanOpcion
FROM dbo.ff_EdoCuentaCobranza AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud
       AND S.IdEmpresa = EC.ECIdEmpresa
WHERE EC.ECIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT EC.ECIdPlanOpcion
FROM dbo.ff_EdoCuentaCobranza2 AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud
       AND S.IdEmpresa = EC.ECIdEmpresa
WHERE EC.ECIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT CS.CSIdPlanOpcion
FROM dbo.ff_ConfiguracionSabana AS CS
WHERE CS.CSIdConfiguracion = @IdConfiguracion
  AND CS.CSIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT M.idPlan
FROM dbo.ff_InfoPlanMascota AS M
WHERE M.idPlan IS NOT NULL
  AND
  (
      M.idSolicitud IN (SELECT IdSolicitud FROM @Solicitudes)
      OR M.idBeneficiario IN (SELECT IdEmpleado FROM @Empleados)
  );

DECLARE @Planes TABLE
(
    IdPlan int NOT NULL PRIMARY KEY
);

INSERT @Planes(IdPlan)
SELECT DISTINCT PO.POIdPlan
FROM dbo.ff_PlanOpcion AS PO
WHERE PO.POIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
UNION
/* Compatibilidad: en algunos ambientes InfoPlanMascota.idPlan guarda plan. */
SELECT DISTINCT P.PLIdPlan
FROM dbo.ff_Plan AS P
WHERE P.PLIdPlan IN
      (
          SELECT M.idPlan
          FROM dbo.ff_InfoPlanMascota AS M
          WHERE M.idSolicitud IN (SELECT IdSolicitud FROM @Solicitudes)
             OR M.idBeneficiario IN (SELECT IdEmpleado FROM @Empleados)
      );

DECLARE @Tarifas TABLE
(
    IdTarifa int NOT NULL PRIMARY KEY
);

INSERT @Tarifas(IdTarifa)
SELECT DISTINCT T.TAIdTarifa
FROM dbo.ff_Tarifa AS T
WHERE T.TAIdVigencia = @IdVigencia;

DECLARE @Reportes TABLE
(
    IdReporte int NOT NULL PRIMARY KEY
);

/* 3 = Sabana; 10 = catalogo Cobranza; 11 = layout usado por JDBCCobranza. */
INSERT @Reportes(IdReporte)
SELECT R.catReportesId
FROM dbo.bf_CatReportes AS R
WHERE R.catReportesId IN (3, 10, 11)
   OR R.catReportesNombre LIKE N'%Sabana%'
   OR R.catReportesNombre LIKE N'%Sábana%'
   OR R.catReportesNombre LIKE N'%Cobranza%';

/* ======================================================================
   1. ALCANCE Y CONTEOS
   ====================================================================== */
SELECT N'ALCANCE' AS __Tabla,
       @IdEmpresa AS IdEmpresa,
       @IdCorporativo AS IdCorporativo,
       @IdConfiguracion AS IdConfiguracion,
       @IdVigencia AS IdVigencia,
       @FechaInicioSabana AS FechaInicioSabana,
       @FechaFinSabana AS FechaFinSabana,
       @FechaInicioCobranza AS FechaInicioCobranza,
       @FechaFinCobranza AS FechaFinCobranza,
       (SELECT COUNT(*) FROM @Empresas) AS EmpresasIncluidas,
       (SELECT COUNT(*) FROM @Perfiles) AS Perfiles,
       (SELECT COUNT(*) FROM @Empleados) AS Empleados,
       (SELECT COUNT(*) FROM @Solicitudes) AS Solicitudes,
       (SELECT COUNT(*) FROM @PlanOpciones) AS PlanOpciones,
       (SELECT COUNT(*) FROM @Planes) AS Planes;

SELECT N'EMPRESAS_INCLUIDAS' AS __Tabla, E.*
FROM dbo.ff_Empresa AS E
INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMIdEmpresa
ORDER BY E.EMIdEmpresa;

SELECT N'CONTEOS' AS __Tabla, N'ff_Empleado' AS NombreTabla, COUNT_BIG(*) AS Filas
FROM dbo.ff_Empleado AS T
INNER JOIN @Empresas AS E ON E.IdEmpresa = T.EMIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_Solicitud', COUNT_BIG(*)
FROM dbo.ff_Solicitud AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.SOIdSolicitud AND S.IdEmpresa = T.SOIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_PlanOpcionSeleccion', COUNT_BIG(*)
FROM dbo.ff_PlanOpcionSeleccion AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.POIdSolicitud AND S.IdEmpresa = T.POIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_EdoCuenta', COUNT_BIG(*)
FROM dbo.ff_EdoCuenta AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.ECIdSolicitud AND S.IdEmpresa = T.ECIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_InfoPlanMascota', COUNT_BIG(*)
FROM dbo.ff_InfoPlanMascota AS T
WHERE T.idSolicitud IN (SELECT IdSolicitud FROM @Solicitudes)
   OR T.idBeneficiario IN (SELECT IdEmpleado FROM @Empleados);

/* ======================================================================
   2. EMPRESA, VIGENCIA, PERFILES Y EMPLEADOS
   ====================================================================== */
SELECT N'ff_Empresa' AS __Tabla, E.*
FROM dbo.ff_Empresa AS E
WHERE E.EMIdEmpresa IN (SELECT IdEmpresa FROM @EmpresasConfiguracion)
ORDER BY E.EMIdEmpresa;

SELECT N'ff_Parametro' AS __Tabla, P.*
FROM dbo.ff_Parametro AS P
WHERE P.paIdEmpresa IN (SELECT IdEmpresa FROM @EmpresasConfiguracion)
ORDER BY P.paIdEmpresa, P.paClase;

SELECT N'ff_Vigencia' AS __Tabla, V.*
FROM dbo.ff_Vigencia AS V
WHERE V.VIIdVigencia = @IdVigencia
   OR V.VIIdVigencia IN
      (
          SELECT DISTINCT S.SOIdVigencia
          FROM dbo.ff_Solicitud AS S
          INNER JOIN @Solicitudes AS X
                  ON X.IdSolicitud = S.SOIdSolicitud
                 AND X.IdEmpresa = S.SOIdEmpresa
      )
ORDER BY V.VIIdVigencia;

SELECT N'ff_VigenciaCalendarioPago' AS __Tabla, VC.*
FROM dbo.ff_VigenciaCalendarioPago AS VC
WHERE VC.VCIdVigencia IN
      (
          SELECT V.VIIdVigencia
          FROM dbo.ff_Vigencia AS V
          WHERE V.VIIdVigencia = @IdVigencia
             OR V.VIIdVigencia IN
                (
                    SELECT DISTINCT S.SOIdVigencia
                    FROM dbo.ff_Solicitud AS S
                    INNER JOIN @Solicitudes AS X
                            ON X.IdSolicitud = S.SOIdSolicitud
                           AND X.IdEmpresa = S.SOIdEmpresa
                )
      )
ORDER BY VC.VCIdVigencia;

SELECT N'ff_PeriodicidadPago' AS __Tabla, PP.*
FROM dbo.ff_PeriodicidadPago AS PP
WHERE PP.PPIdPeriodicidadPago IN
      (
          SELECT DISTINCT VC.VCIdPeriodicidadPago
          FROM dbo.ff_VigenciaCalendarioPago AS VC
          WHERE VC.VCIdVigencia = @IdVigencia
             OR VC.VCIdVigencia IN
                (
                    SELECT DISTINCT S.SOIdVigencia
                    FROM dbo.ff_Solicitud AS S
                    INNER JOIN @Solicitudes AS X
                            ON X.IdSolicitud = S.SOIdSolicitud
                           AND X.IdEmpresa = S.SOIdEmpresa
                )
      )
ORDER BY PP.PPIdPeriodicidadPago;

SELECT N'ff_Perfil' AS __Tabla, P.*
FROM dbo.ff_Perfil AS P
WHERE P.PEIdPerfil IN (SELECT IdPerfil FROM @Perfiles)
ORDER BY P.PEIdEmpresa, P.PEIdPerfil;

SELECT N'ff_Rol' AS __Tabla, R.*
FROM dbo.ff_Rol AS R
WHERE R.ROIdRol IN
      (
          SELECT DISTINCT E.EMIdRol
          FROM dbo.ff_Empleado AS E
          WHERE E.Id IN (SELECT IdEmpleado FROM @Empleados)
          UNION
          SELECT DISTINCT P.PEIdRolDefault
          FROM dbo.ff_Perfil AS P
          WHERE P.PEIdPerfil IN (SELECT IdPerfil FROM @Perfiles)
      )
ORDER BY R.ROIdRol;

SELECT N'ff_TipoSalario' AS __Tabla, TS.*
FROM dbo.ff_TipoSalario AS TS
WHERE TS.IdTipoSalario IN
      (
          SELECT DISTINCT E.EMIdTipoSalario
          FROM dbo.ff_Empleado AS E
          WHERE E.Id IN (SELECT IdEmpleado FROM @Empleados)
      )
ORDER BY TS.IdTipoSalario;

SELECT N'ff_Empleado' AS __Tabla, E.*
FROM dbo.ff_Empleado AS E
WHERE E.Id IN (SELECT IdEmpleado FROM @Empleados)
ORDER BY E.EMIdEmpresa, E.EMNumeroEmpleado, E.EMIdParentesco, E.Id;

SELECT N'ff_Empleado_Historico' AS __Tabla, H.*
FROM dbo.ff_Empleado_Historico AS H
INNER JOIN @Empresas AS E ON E.IdEmpresa = H.EMIdEmpresa
WHERE H.EMFechaCambio >= @FechaInicioSabana
  AND H.EMFechaCambio < @FechaFinSabanaExclusiva
ORDER BY H.EMId, H.EMHIdHist;

SELECT N'ff_Transferencia' AS __Tabla, T.*
FROM dbo.ff_Transferencia AS T
WHERE (T.TRIdEmpresaOrigen IN (SELECT IdEmpresa FROM @Empresas)
    OR T.TRIdEmpresaDestino IN (SELECT IdEmpresa FROM @Empresas))
  AND T.TRFechaTransferencia >= @FechaInicioSabana
  AND T.TRFechaTransferencia < @FechaFinSabanaExclusiva
ORDER BY T.TRFechaTransferencia;

/* ======================================================================
   3. SOLICITUDES, SELECCIONES Y MOVIMIENTOS DE COBRANZA
   ====================================================================== */
SELECT N'ff_Solicitud' AS __Tabla, S.*
FROM dbo.ff_Solicitud AS S
INNER JOIN @Solicitudes AS X
        ON X.IdSolicitud = S.SOIdSolicitud AND X.IdEmpresa = S.SOIdEmpresa
ORDER BY S.SOIdEmpresa, S.SOIdVigencia, S.SOIdSolicitud;

SELECT N'ff_PlanOpcionSeleccion' AS __Tabla, POS.*
FROM dbo.ff_PlanOpcionSeleccion AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
ORDER BY POS.POIdEmpresa, POS.POIdSolicitud, POS.POIdEmpleado;

SELECT N'ff_PlanOpcionSeleccionCobranza' AS __Tabla, POS.*
FROM dbo.ff_PlanOpcionSeleccionCobranza AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
ORDER BY POS.POIdEmpresa, POS.POIdSolicitud, POS.POIdEmpleado;

SELECT N'ff_PlanOpcionSeleccionCobranza2' AS __Tabla, POS.*
FROM dbo.ff_PlanOpcionSeleccionCobranza2 AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
ORDER BY POS.POIdEmpresa, POS.POIdSolicitud, POS.POIdEmpleado;

SELECT N'ff_EdoCuenta' AS __Tabla, EC.*
FROM dbo.ff_EdoCuenta AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
ORDER BY EC.ECIdEmpresa, EC.ECIdSolicitud, EC.ECIdEmpleado;

SELECT N'ff_EdoCuentaCobranza' AS __Tabla, EC.*
FROM dbo.ff_EdoCuentaCobranza AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
ORDER BY EC.ECIdEmpresa, EC.ECIdSolicitud, EC.ECIdEmpleado;

SELECT N'ff_EdoCuentaCobranza2' AS __Tabla, EC.*
FROM dbo.ff_EdoCuentaCobranza2 AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
ORDER BY EC.ECIdEmpresa, EC.ECIdSolicitud, EC.ECIdEmpleado;

SELECT N'ff_CobranzaConcentrada' AS __Tabla, CC.*
FROM dbo.ff_CobranzaConcentrada AS CC
INNER JOIN @Empresas AS E ON E.IdEmpresa = CC.CCIdEmpresa
WHERE CC.CCIdVigencia = @IdVigencia
ORDER BY CC.CCIdEmpresa, CC.CCIdVigencia, CC.CCIdEmpleado;

SELECT N'ff_CobranzaSubtotal' AS __Tabla, CS.*
FROM dbo.ff_CobranzaSubtotal AS CS
INNER JOIN @Empresas AS E ON E.IdEmpresa = CS.CSIdEmpresa
ORDER BY CS.CSIdEmpresa;

SELECT N'ff_CompensacionEmpleado' AS __Tabla, CE.*
FROM dbo.ff_CompensacionEmpleado AS CE
WHERE CE.CEIdEmpleado IN (SELECT IdEmpleado FROM @Empleados)
ORDER BY CE.CEIdEmpleado;

SELECT N'ff_CompensacionPlanOpcion' AS __Tabla, CP.*
FROM dbo.ff_CompensacionPlanOpcion AS CP
WHERE CP.CPIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
   OR CP.CPIdCompensacion IN
      (
          SELECT EC.ECIdCompensacion
          FROM dbo.ff_EdoCuenta AS EC
          INNER JOIN @Solicitudes AS S
                  ON S.IdSolicitud = EC.ECIdSolicitud
                 AND S.IdEmpresa = EC.ECIdEmpresa
          WHERE EC.ECIdCompensacion IS NOT NULL
          UNION
          SELECT EC.ECIdCompensacion
          FROM dbo.ff_EdoCuentaCobranza2 AS EC
          INNER JOIN @Solicitudes AS S
                  ON S.IdSolicitud = EC.ECIdSolicitud
                 AND S.IdEmpresa = EC.ECIdEmpresa
          WHERE EC.ECIdCompensacion IS NOT NULL
      );

/* B2/B3 consultan el descuento del periodo anterior: agosto de 2026. */
SELECT N'ff_DescuentoEmpleado' AS __Tabla, DE.*
FROM dbo.ff_DescuentoEmpleado AS DE
WHERE DE.DEIdEmpresa IN (SELECT IdEmpresa FROM @Empresas)
  AND DE.DENumeroEmpleado IN
      (SELECT NumeroEmpleado FROM @Empleados WHERE NumeroEmpleado IS NOT NULL)
  AND DE.DEIdAno = YEAR(DATEADD(MONTH, -1, @FechaFinCobranza))
  AND DE.DEIdMes = MONTH(DATEADD(MONTH, -1, @FechaFinCobranza))
ORDER BY DE.DENumeroEmpleado, DE.DEIdAno, DE.DEIdMes, DE.DEIdQuincena;

/* Referencias legacy: los SP aun consultan septiembre de 2015. Se extraen
   los septiembres de la empresa para evitar depender del identificador con
   letra enye, que sqlcmd interpreta distinto entre codificaciones. */
SELECT N'ff_CobranzaDetallada' AS __Tabla, CD.*
FROM dbo.ff_CobranzaDetallada AS CD
WHERE CD.CDIdEmpresa IN (SELECT IdEmpresa FROM @Empresas)
  AND CD.CDMes = 9
ORDER BY CD.CDIdEmpresa, CD.CDNumeroEmpleado, CD.CDIdPlan;

/* ======================================================================
   4. CONFIGURACION DE SABANA, PLANES, TARIFAS Y CATALOGOS
   ====================================================================== */
SELECT N'ff_ConfiguracionSabana' AS __Tabla, CS.*
FROM dbo.ff_ConfiguracionSabana AS CS
WHERE CS.CSIdConfiguracion = @IdConfiguracion
ORDER BY CS.CSIdTipoSabana, CS.CSIdPlan, CS.CSIdPlanOpcion,
         CS.CSColumna, CS.CSIdConfiguracionSabana;

SELECT N'ff_TipoSabana' AS __Tabla, TS.*
FROM dbo.ff_TipoSabana AS TS
WHERE TS.TSIdTipoSabana IN
      (
          SELECT DISTINCT CS.CSIdTipoSabana
          FROM dbo.ff_ConfiguracionSabana AS CS
          WHERE CS.CSIdConfiguracion = @IdConfiguracion
      );

SELECT N'ff_PlanOpcionPerfil' AS __Tabla, PP.*
FROM dbo.ff_PlanOpcionPerfil AS PP
WHERE PP.PPIdPerfil IN (SELECT IdPerfil FROM @Perfiles)
ORDER BY PP.PPIdPerfil, PP.PPIdPlanOpcion;

SELECT N'ff_PlanOpcion' AS __Tabla, PO.*
FROM dbo.ff_PlanOpcion AS PO
WHERE PO.POIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY PO.POIdPlan, PO.POIdPlanOpcion;

SELECT N'ff_Plan' AS __Tabla, P.*
FROM dbo.ff_Plan AS P
WHERE P.PLIdPlan IN (SELECT IdPlan FROM @Planes)
ORDER BY P.PLIdPlan;

SELECT N'ff_PlanOpcionVigencia' AS __Tabla, POV.*
FROM dbo.ff_PlanOpcionVigencia AS POV
WHERE POV.VCIdVigencia = @IdVigencia
  AND POV.VCIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY POV.VCIdVigencia, POV.VCIdPlanOpcion;

SELECT N'ff_Tarifa' AS __Tabla, T.*
FROM dbo.ff_Tarifa AS T
WHERE T.TAIdTarifa IN (SELECT IdTarifa FROM @Tarifas)
ORDER BY T.TAIdTarifa;

SELECT N'ff_TarifaCosto' AS __Tabla, TC.*
FROM dbo.ff_TarifaCosto AS TC
WHERE TC.TCIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
  AND (TC.TCIdTarifa IN (SELECT IdTarifa FROM @Tarifas)
       OR NOT EXISTS (SELECT 1 FROM @Tarifas))
ORDER BY TC.TCIdTarifa, TC.TCIdPlanOpcion;

SELECT N'ff_TarifaCosto_hist' AS __Tabla, TC.*
FROM dbo.ff_TarifaCosto_hist AS TC
WHERE TC.TCIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY TC.TCIdTarifa, TC.TCIdPlanOpcion, TC.TCIdTarifaCosto;

SELECT N'ff_TarifaCostoPerfil' AS __Tabla, TCP.*
FROM dbo.ff_TarifaCostoPerfil AS TCP
WHERE TCP.TPIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
  AND TCP.TPIdPerfil IN (SELECT IdPerfil FROM @Perfiles)
  AND (TCP.TPIdTarifa IN (SELECT IdTarifa FROM @Tarifas)
       OR NOT EXISTS (SELECT 1 FROM @Tarifas))
ORDER BY TCP.TPIdTarifa, TCP.TPIdPlanOpcion, TCP.TPIdPerfil;

SELECT N'bf_TipoPagoPlan' AS __Tabla, TP.*
FROM dbo.bf_TipoPagoPlan AS TP
WHERE TP.TPIdTipoPago IN
      (
          SELECT DISTINCT P.PLIdTipoPago
          FROM dbo.ff_Plan AS P
          WHERE P.PLIdPlan IN (SELECT IdPlan FROM @Planes)
      )
ORDER BY TP.TPIdTipoPago;

SELECT N'ff_Ramo' AS __Tabla, R.*
FROM dbo.ff_Ramo AS R
WHERE R.RAIdRamo IN
      (
          SELECT DISTINCT P.PLIdRamo
          FROM dbo.ff_Plan AS P
          WHERE P.PLIdPlan IN (SELECT IdPlan FROM @Planes)
      )
