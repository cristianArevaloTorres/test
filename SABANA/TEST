SELECT TOP (100)
       etapa,
       detalle
FROM dbo.bf_RepConf_Debug WITH (NOLOCK)
WHERE etapa IN
(
    N'bf_RepConf_Tabla_fila',
    N'bf_RepConf_Columna',
    N'generar_rs',
    N'escribirTabla_inicio',
    N'escribirTabla_matchColumnas',
    N'escribirTabla_resultado'
)
ORDER BY 1 DESC;

SELECT
    DB_NAME() AS BaseActual,
    @@SERVERNAME AS ServidorActual,
    OBJECT_SCHEMA_NAME(@@PROCID) AS Esquema;


name	MarcasParche	LlamadasFuncion
ff_SabanaGMM_v2	2	2
ff_SabanaVIDA_v2	1	1

catReportesSPId	catReportesId	catReportesSPNombre	catReportesSPOrden	ESid
3	3	ff_Sabana_v2	1	1


SELECT
    O.name,
    (
        LEN(M.definition) -
        LEN(REPLACE(
            M.definition,
            N'BF3_SOLO_SQL_OCULTA_COLUMNAS_B2',
            N''
        ))
    ) / LEN(N'BF3_SOLO_SQL_OCULTA_COLUMNAS_B2')
      AS MarcasParche,
    (
        LEN(M.definition) -
        LEN(REPLACE(
            M.definition,
            N'bf_SabanaQuitarColumnasB2',
            N''
        ))
    ) / LEN(N'bf_SabanaQuitarColumnasB2')
      AS LlamadasFuncion
FROM sys.objects O
JOIN sys.sql_modules M
  ON M.object_id = O.object_id
WHERE O.name IN
(
    N'ff_SabanaGMM_v2',
    N'ff_SabanaVIDA_v2'
);


SELECT
    catReportesSPId,
    catReportesId,
    catReportesSPNombre,
    catReportesSPOrden,
    ESid
FROM dbo.bf_CatReportesSP
WHERE catReportesId = 3
  AND ESid = 1
ORDER BY catReportesSPOrden;






SELECT catReportesSPId,
       catReportesId,
       catReportesSPNombre,
       catReportesSPOrden,
       ESid
FROM dbo.bf_CatReportesSP
WHERE catReportesId = 3
ORDER BY catReportesSPOrden;

SELECT O.name,
       CASE
           WHEN M.definition LIKE
                '%BF3_SOLO_SQL_OCULTA_COLUMNAS_B2%'
           THEN 'PARCHE INSTALADO'
           ELSE 'SIN PARCHE'
       END AS Estado
FROM sys.objects O
JOIN sys.sql_modules M
  ON M.object_id = O.object_id
WHERE O.name IN
(
    'ff_Sabana_v2',
    'ff_Sabana_BF3',
    'ff_SabanaGMM_v2',
    'ff_SabanaGMM_BF3',
    'ff_SabanaVIDA_v2',
    'ff_SabanaVIDA_BF3'
)
ORDER BY O.name;

