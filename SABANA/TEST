(304,'03_LOGICA_OPC',CASE WHEN @ValidaVigencia=1 THEN 'OK' ELSE 'ALERTA' END,
 'FiltraVigencia',CONVERT(varchar(1),@ValidaVigencia),N'Debe ser 1.');

