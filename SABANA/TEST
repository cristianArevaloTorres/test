
SELECT catReportesSPId,
       catReportesId,
       catReportesSPNombre,
       catReportesSPOrden,
       ESid
FROM dbo.bf_CatReportesSP
WHERE catReportesId = 3
ORDER BY catReportesSPOrden;

SELECT O.name,
       CASE
           WHEN M.definition LIKE
                '%BF3_SOLO_SQL_OCULTA_COLUMNAS_B2%'
           THEN 'PARCHE INSTALADO'
           ELSE 'SIN PARCHE'
       END AS Estado
FROM sys.objects O
JOIN sys.sql_modules M
  ON M.object_id = O.object_id
WHERE O.name IN
(
    'ff_Sabana_v2',
    'ff_Sabana_BF3',
    'ff_SabanaGMM_v2',
    'ff_SabanaGMM_BF3',
    'ff_SabanaVIDA_v2',
    'ff_SabanaVIDA_BF3'
)
ORDER BY O.name;

name	Estado
ff_Sabana_BF3	SIN PARCHE
ff_Sabana_v2	SIN PARCHE
ff_SabanaGMM_BF3	SIN PARCHE
ff_SabanaGMM_v2	PARCHE INSTALADO
ff_SabanaVIDA_BF3	SIN PARCHE
ff_SabanaVIDA_v2	PARCHE INSTALADO
