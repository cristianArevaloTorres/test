DECLARE @Objeto int = OBJECT_ID(N'dbo.bf_RepConf_Debug');
DECLARE @ColumnaOrden sysname;

SELECT TOP (1)
       @ColumnaOrden = C.name
FROM sys.columns C
JOIN sys.types T
  ON T.user_type_id = C.user_type_id
WHERE C.object_id = @Objeto
  AND
  (
      C.is_identity = 1
      OR T.name IN
         (
             N'datetime',N'datetime2',N'smalldatetime',
             N'date',N'time',N'bigint',N'int'
         )
  )
ORDER BY
    CASE WHEN C.is_identity = 1 THEN 0 ELSE 1 END,
    CASE WHEN T.name IN
              (N'datetime',N'datetime2',N'smalldatetime')
         THEN 0 ELSE 1 END,
    C.column_id;

IF @ColumnaOrden IS NULL
    THROW 50300,
          'No se encontró columna para ordenar bf_RepConf_Debug.',
          1;

DECLARE @SQL nvarchar(max) =
N'SELECT TOP (150)
         ' + QUOTENAME(@ColumnaOrden) + N' AS Orden,
         etapa,
         detalle
  FROM dbo.bf_RepConf_Debug WITH (NOLOCK)
  WHERE etapa IN
  (
      N''sabana_params_enviados'',
      N''bf_RepConf_Tabla'',
      N''bf_RepConf_Tabla_fila'',
      N''bf_RepConf_Columna'',
      N''generar_rs'',
      N''escribirTabla_inicio'',
      N''escribirTabla_matchColumnas'',
      N''escribirTabla_resultado''
  )
  ORDER BY ' + QUOTENAME(@ColumnaOrden) + N' DESC;';

EXEC sys.sp_executesql @SQL;
