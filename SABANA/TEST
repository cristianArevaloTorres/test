/* ======================================================================
   8. VERSIONES DE OBJETOS: confirma si origen y local tienen el mismo SQL.
   ====================================================================== */
SELECT N'OBJETOS_SQL' AS __Tabla,
       SCHEMA_NAME(O.schema_id) AS Esquema,
       O.name AS Objeto,
       O.type_desc AS Tipo,
       O.create_date AS FechaCreacion,
       O.modify_date AS FechaModificacion,
       DATALENGTH(M.definition) AS BytesDefinicion
FROM sys.objects AS O
LEFT JOIN sys.sql_modules AS M ON M.object_id = O.object_id
WHERE O.name IN
      (N'ff_orquestadorReportes',
       N'ff_SabanaGMM', N'ff_SabanaVIDA',
       N'ff_Sabana_BF3', N'ff_SabanaGMM_BF3',
       N'ff_SabanaVIDA_BF3', N'ff_SabanaOPC_BF3',
       N'ff_SabanaMascotas_BF3', N'ff_Sabana_v2',
       N'ff_SabanaGMM_v2', N'ff_SabanaVIDA_v2', N'ff_SabanaOPC_v2',
       N'ObtenCobranzaConcentrada',
       N'ObtenCobranzaConcentrada_otro_V2_BF3',
       N'ReporteCobranzaConcentrada_BF3_Cache',
       N'ff_CobranzaSincronizacion_V3_bf3',
       N'ff_ObtenEmpleadosCob_v2_bf3',
       N'ff_ObtenCobranzaDesg_Adaptada',
       N'ff_ObtenCobranzaDesg_Adaptada_bf3_nousar')
ORDER BY O.name;

