INSERT #Empleados(IdEmpresa,IdEmpleado,NumeroEmpleado)
SELECT X.IdEmpresa,X.IdEmpleado,MAX(X.NumeroEmpleado)
FROM
(
    SELECT E.EMIdEmpresa,E.Id,E.EMNumeroEmpleado
    FROM dbo.ff_Empleado AS E
    WHERE E.EMIdEmpresa IN(SELECT IdEmpresa FROM #Empresas)
      AND E.EMIdEstatus=1
      AND E.EMNumeroEmpleado NOT LIKE 'TEST%'
      AND E.EMIdPerfil IN(SELECT IdPerfil FROM #Perfiles)
    UNION ALL
    SELECT S.IdEmpresa,S.IdEmpleado,S.NumeroEmpleado
    FROM #Solicitudes AS S
    WHERE S.IdEmpleado IS NOT NULL
    UNION ALL
    SELECT P.POIdEmpresa,P.POIdEmpleado,P.PONumeroEmpleado
    FROM dbo.ff_PlanOpcionSeleccionCobranza AS P
    WHERE P.POIdEmpresa IN(SELECT IdEmpresa FROM #Empresas)
      AND P.POIdVigencia IN(SELECT IdVigencia FROM #Vigencias)
    UNION ALL
    SELECT P.POIdEmpresa,P.POIdEmpleado,P.PONumeroEmpleado
    FROM dbo.ff_PlanOpcionSeleccionCobranza2 AS P
    WHERE P.POIdEmpresa IN(SELECT IdEmpresa FROM #Empresas)
      AND P.POIdVigencia IN(SELECT IdVigencia FROM #Vigencias)
) AS X(IdEmpresa,IdEmpleado,NumeroEmpleado)
WHERE X.IdEmpleado IS NOT NULL
GROUP BY X.IdEmpresa,X.IdEmpleado;

