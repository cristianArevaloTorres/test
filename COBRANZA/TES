$ErrorActionPreference = 'Stop'

$RepoFront = 'C:\repo\reportes\FRONT'
$TargetBranch = 'issue-reportesabanaQA'
$Commit = '5400e776'
$StashName = 'temporal-antes-de-subir-5400e776'

Set-Location -LiteralPath $RepoFront

git rev-parse --is-inside-work-tree | Out-Null
if ($LASTEXITCODE -ne 0) { throw "No es un repositorio Git: $RepoFront" }

git cat-file -e "$Commit`^{commit}"
if ($LASTEXITCODE -ne 0) { throw "No existe localmente el commit $Commit." }

$OriginalBranch = (git branch --show-current).Trim()
if ([string]::IsNullOrWhiteSpace($OriginalBranch)) {
    throw 'No fue posible determinar la rama local actual.'
}

$HadLocalChanges = -not [string]::IsNullOrWhiteSpace((git status --porcelain | Out-String))
if ($HadLocalChanges) {
    # Guarda de forma temporal .vs, package-lock.json, global.ts y cualquier
    # otro cambio no confirmado. El commit 5400e776 no se modifica.
    git stash push -u -m $StashName
    if ($LASTEXITCODE -ne 0) { throw 'No fue posible guardar temporalmente los cambios locales.' }
}

git fetch origin
if ($LASTEXITCODE -ne 0) { throw 'Fallo git fetch.' }

git show-ref --verify --quiet "refs/remotes/origin/$TargetBranch"
if ($LASTEXITCODE -ne 0) { throw "No existe origin/$TargetBranch." }

# Se parte exactamente de la rama remota para conservar el trabajo que ya contiene.
# Se usa una rama temporal para no alterar ni mezclar la rama QA local.
$TempBranch = "entrega-5400e776-$([DateTime]::Now.ToString('yyyyMMddHHmmss'))"
git switch -c $TempBranch "origin/$TargetBranch"
if ($LASTEXITCODE -ne 0) { throw "No fue posible crear la rama temporal desde origin/$TargetBranch." }

git cherry-pick $Commit
if ($LASTEXITCODE -ne 0) {
    Write-Host ''
    Write-Host 'El cherry-pick encontro conflictos. No se hizo push.' -ForegroundColor Red
    Write-Host 'Resuelva los archivos, ejecute git add sobre ellos y despues: git cherry-pick --continue' -ForegroundColor Yellow
    Write-Host 'Para cancelar y volver al estado anterior: git cherry-pick --abort' -ForegroundColor Yellow
    throw "No fue posible aplicar el commit $Commit automaticamente."
}

git push origin "HEAD:$TargetBranch"
if ($LASTEXITCODE -ne 0) { throw "No fue posible enviar el commit a $TargetBranch." }

git switch $OriginalBranch
if ($LASTEXITCODE -ne 0) { throw "El push termino, pero no fue posible volver a $OriginalBranch." }

git branch -D $TempBranch | Out-Null

if ($HadLocalChanges) {
    git stash pop
    if ($LASTEXITCODE -ne 0) {
        throw 'El push termino, pero revise el stash: los cambios locales no pudieron restaurarse automaticamente.'
    }
}

Write-Host ''
Write-Host "Commit $Commit enviado correctamente a origin/$TargetBranch." -ForegroundColor Green
git status --short
