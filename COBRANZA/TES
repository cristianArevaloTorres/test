Set-Location 'C:\repo\reportes\APIREPORTS'

# Guardar temporalmente los cambios locales que no forman parte del commit
git stash push -u -m "Cambios locales antes de actualizar rama"

# Descargar e integrar el commit remoto
git fetch origin
git rebase origin/ReporteSabanaHomologacionOK-clean

# Subir el commit de Cobranza
git push -u origin ReporteSabanaHomologacionOK-clean

# Recuperar los cambios locales guardados
git stash pop

git status
Si el rebase presenta conflictos:
git status
Corrige los archivos marcados y después ejecuta:
git add -- ruta/del/archivo-corregido
git rebase --continue
git push -u origin ReporteSabanaHomologacionOK-clean
git stash pop
