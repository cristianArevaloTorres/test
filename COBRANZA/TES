FROM dbo.ff_Tarifa T
WHERE T.TAIdVigencia IN(SELECT IdVigencia FROM #Vigencias);

CREATE TABLE #CacheBase
(
    CacheId bigint NOT NULL PRIMARY KEY
);

IF @IncluirLineaBase=1
BEGIN
    INSERT #CacheBase(CacheId)
    SELECT CacheId
    FROM
    (
        SELECT C.CacheId,
               ROW_NUMBER() OVER
               (PARTITION BY C.IdVigencia
                ORDER BY COALESCE(C.FechaCargaFin,C.FechaCargaInicio) DESC,
                         C.CacheId DESC) AS RN
        FROM dbo.bf_CobranzaCache_ConsultaV2 C
        WHERE C.IdEmpresa=@IdEmpresa
          AND C.IdVigencia IN(SELECT IdVigencia FROM #Vigencias)
          AND C.EsUniverso=1
          AND C.Estado='COMPLETA'
    ) AS X
    WHERE RN=1;
END;

