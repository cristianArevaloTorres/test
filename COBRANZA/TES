       ON E.IdEmpresa=EC.ECidEmpresa
      AND E.IdEmpleado=EC.ECidEmpleado
LEFT JOIN #NumerosEmpleado N
       ON N.IdEmpresa=EC.ECidEmpresa
      AND N.NumeroEmpleado=EC.ECNumeroEmpleado
LEFT JOIN #Solicitudes S
       ON S.IdEmpresa=EC.ECidEmpresa
      AND S.IdSolicitud=EC.ECidSolicitud
WHERE EC.ECidEmpresa=@IdEmpresa
  AND EC.ECidEstadoCuenta IS NOT NULL
  AND (E.IdEmpleado IS NOT NULL
       OR N.NumeroEmpleado IS NOT NULL
       OR S.IdSolicitud IS NOT NULL)
OPTION(RECOMPILE);

SET @FilasPaso=(SELECT COUNT(*) FROM #EdoCuenta2);
RAISERROR(N'[EXPORT 186] Estado de cuenta 2 relacionado: %d filas.',0,1,@FilasPaso) WITH NOWAIT;

/* Se agregan solicitudes historicas referidas por el estado de cuenta acotado. */
INSERT #Solicitudes(IdEmpresa,IdSolicitud,IdEmpleado,NumeroEmpleado,IdVigencia)
SELECT DISTINCT S.SOIdEmpresa,S.SOIdSolicitud,S.SOIdEmpleado,
       S.SONumEmpleado,S.SOIdVigencia
FROM dbo.ff_Solicitud AS S
INNER JOIN
(
    SELECT EC.ECidEmpresa,EC.ECidSolicitud
    FROM dbo.ff_EdoCuentaCobranza EC
    INNER JOIN #EdoCuenta1 K ON K.IdEstadoCuenta=EC.ECidEstadoCuenta
    WHERE EC.ECidSolicitud IS NOT NULL
    UNION
    SELECT EC.ECidEmpresa,EC.ECidSolicitud
    FROM dbo.ff_EdoCuentaCobranza2 EC
    INNER JOIN #EdoCuenta2 K ON K.IdEstadoCuenta=EC.ECidEstadoCuenta
    WHERE EC.ECidSolicitud IS NOT NULL
) R ON R.ECidEmpresa=S.SOIdEmpresa AND R.ECidSolicitud=S.SOIdSolicitud
WHERE S.SOIdEmpresa=@IdEmpresa
  AND NOT EXISTS
      (SELECT 1 FROM #Solicitudes X
       WHERE X.IdEmpresa=S.SOIdEmpresa AND X.IdSolicitud=S.SOIdSolicitud)
OPTION(RECOMPILE);

CREATE TABLE #PlanOpciones
(
    IdPlanOpcion int NOT NULL PRIMARY KEY
);

INSERT #PlanOpciones(IdPlanOpcion)
SELECT DISTINCT IdPlanOpcion
FROM
(
    SELECT P.POIdPlanOpcion AS IdPlanOpcion
    FROM dbo.ff_PlanOpcionSeleccionCobranza P
    WHERE P.POIdEmpresa IN(SELECT IdEmpresa FROM #Empresas)
      AND P.POIdVigencia IN(SELECT IdVigencia FROM #Vigencias)
    UNION ALL
    SELECT P.POIdPlanOpcion
    FROM dbo.ff_PlanOpcionSeleccionCobranza2 P
    WHERE P.POIdEmpresa IN(SELECT IdEmpresa FROM #Empresas)
      AND P.POIdVigencia IN(SELECT IdVigencia FROM #Vigencias)
    UNION ALL
    SELECT EC.ECidPlanOpcion
    FROM dbo.ff_EdoCuentaCobranza EC
    INNER JOIN #EdoCuenta1 K ON K.IdEstadoCuenta=EC.ECidEstadoCuenta
    UNION ALL
    SELECT EC.ECidPlanOpcion
    FROM dbo.ff_EdoCuentaCobranza2 EC
    INNER JOIN #EdoCuenta2 K ON K.IdEstadoCuenta=EC.ECidEstadoCuenta
) AS P
WHERE IdPlanOpcion IS NOT NULL;

SET @FilasPaso=(SELECT COUNT(*) FROM #PlanOpciones);
RAISERROR(N'[EXPORT 186] Planes-opcion relacionados: %d. Iniciando resultsets.',0,1,@FilasPaso) WITH NOWAIT;

CREATE TABLE #Planes
(
    IdPlan int NOT NULL PRIMARY KEY
);

INSERT #Planes(IdPlan)
SELECT DISTINCT PO.POIdPlan
FROM dbo.ff_PlanOpcion PO
WHERE PO.POIdPlanOpcion IN(SELECT IdPlanOpcion FROM #PlanOpciones);

CREATE TABLE #Tarifas
(
    IdTarifa int NOT NULL PRIMARY KEY
);

INSERT #Tarifas(IdTarifa)
