/*
    SELECTS PARA EXTRAER EL UNIVERSO DE COBRANZA B2/B3
    Empresa:    917
    B2:         2026-09-01 a 2026-09-30 (vigencia de referencia 3933)
    B3:         vigencia 4251
    Base:       FlexiForbesv2

    IMPORTANTE
    - Este script NO modifica tablas permanentes; solamente declara variables
      de tabla en la sesion y devuelve resultsets.
    - Ejecutarlo en la base ORIGEN que contiene la informacion real.
    - Cada resultset inicia con una columna __Tabla para facilitar su
      identificacion al exportar/importar.
    - Se incluye la empresa 917 y, si es corporativo, sus empresas hijas,
      reproduciendo el alcance utilizado por el SP B3.
*/

USE [FlexiForbesv2];
GO

SET NOCOUNT ON;
SET XACT_ABORT ON;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

DECLARE @IdEmpresa       int  = 917,
        @IdVigenciaB2    int  = 3933,
        @IdVigenciaB3    int  = 4251,
        @FecIni           date = '20260901',
        @FecFin           date = '20260930',
        @FecFinExclusiva  date = '20261001',
        @IdConfiguracion  int;

IF NOT EXISTS
(
    SELECT 1
    FROM dbo.ff_Empresa
    WHERE EMidEmpresa = @IdEmpresa
)
    THROW 55000, 'No existe la empresa 917 en la base origen.', 1;

SELECT @IdConfiguracion = E.EMIdConfiguracion
FROM dbo.ff_Empresa AS E
WHERE E.EMIdEmpresa = @IdEmpresa;

DECLARE @Empresas TABLE
(
    IdEmpresa int NOT NULL PRIMARY KEY
);

INSERT @Empresas(IdEmpresa)
VALUES (@IdEmpresa);

/* El SP B3 tambien procesa las filiales cuando 917 es corporativo. */
IF EXISTS
(
    SELECT 1
    FROM dbo.ff_Empresa
    WHERE EMidEmpresa = @IdEmpresa
      AND EMidCorporativo = @IdEmpresa
      AND EMidEstatus = 1
)
BEGIN
    INSERT @Empresas(IdEmpresa)
    SELECT E.EMidEmpresa
    FROM dbo.ff_Empresa AS E
    WHERE E.EMidCorporativo = @IdEmpresa
      AND E.EMidEmpresa <> @IdEmpresa
      AND E.EMidEstatus = 1
      AND NOT EXISTS
          (SELECT 1 FROM @Empresas AS X WHERE X.IdEmpresa = E.EMidEmpresa);
END;

DECLARE @Vigencias TABLE
(
    IdVigencia int NOT NULL PRIMARY KEY
);

INSERT @Vigencias(IdVigencia)
VALUES (@IdVigenciaB2), (@IdVigenciaB3);

DECLARE @Solicitudes TABLE
(
    IdSolicitud int NOT NULL,
    IdEmpresa   int NOT NULL,
    PRIMARY KEY(IdSolicitud, IdEmpresa)
);

/*
   Se toman las solicitudes de ambas vigencias y, para cubrir exactamente el
   SP B2 (que no recibe vigencia), cualquier solicitud aprobada en el rango.
*/
INSERT @Solicitudes(IdSolicitud, IdEmpresa)
SELECT DISTINCT S.SOIdSolicitud, S.SOIdEmpresa
FROM dbo.ff_Solicitud AS S
INNER JOIN @Empresas AS E
        ON E.IdEmpresa = S.SOIdEmpresa
WHERE S.SOIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
   OR (S.SOFechaAprovacion >= @FecIni
       AND S.SOFechaAprovacion < @FecFinExclusiva);

DECLARE @Empleados TABLE
(
    IdEmpleado     int         NOT NULL PRIMARY KEY,
    IdEmpresa      int         NOT NULL,
    NumeroEmpleado varchar(20) NULL
);

INSERT @Empleados(IdEmpleado, IdEmpresa, NumeroEmpleado)
SELECT E.Id, E.EMIdEmpresa, E.EMNumeroEmpleado
FROM dbo.ff_Empleado AS E
INNER JOIN @Empresas AS X
        ON X.IdEmpresa = E.EMIdEmpresa;

DECLARE @Perfiles TABLE
(
    IdPerfil int NOT NULL PRIMARY KEY
);

INSERT @Perfiles(IdPerfil)
SELECT DISTINCT P.PEIdPerfil
FROM dbo.ff_Perfil AS P
INNER JOIN @Empresas AS E
        ON E.IdEmpresa = P.PEIdEmpresa;

/* ========================================================================
   1. RESUMEN: permite revisar cuanto se va a extraer antes de exportar.
   ======================================================================== */
SELECT N'ALCANCE' AS __Tabla,
       @IdEmpresa AS IdEmpresaSolicitada,
       @IdVigenciaB2 AS IdVigenciaB2Referencia,
       @IdVigenciaB3 AS IdVigenciaB3,
       @FecIni AS FecIni,
       @FecFin AS FecFin,
       (SELECT COUNT(*) FROM @Empresas) AS EmpresasIncluidas,
       (SELECT COUNT(*) FROM @Perfiles) AS Perfiles,
       (SELECT COUNT(*) FROM @Empleados) AS Empleados,
       (SELECT COUNT(*) FROM @Solicitudes) AS Solicitudes;

SELECT N'EMPRESAS_INCLUIDAS' AS __Tabla, E.*
FROM dbo.ff_Empresa AS E
INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMidEmpresa
ORDER BY E.EMidEmpresa;

SELECT N'CONTEOS' AS __Tabla, N'ff_Solicitud' AS NombreTabla,
       COUNT_BIG(*) AS Filas
FROM dbo.ff_Solicitud AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.SOIdSolicitud AND S.IdEmpresa = T.SOIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_Empleado', COUNT_BIG(*)
FROM dbo.ff_Empleado AS T
INNER JOIN @Empresas AS E ON E.IdEmpresa = T.EMIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_EdoCuenta', COUNT_BIG(*)
FROM dbo.ff_EdoCuenta AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.ECIdSolicitud AND S.IdEmpresa = T.ECIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_EdoCuentaCobranza', COUNT_BIG(*)
FROM dbo.ff_EdoCuentaCobranza AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.ECIdSolicitud AND S.IdEmpresa = T.ECIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_EdoCuentaCobranza2', COUNT_BIG(*)
FROM dbo.ff_EdoCuentaCobranza2 AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.ECIdSolicitud AND S.IdEmpresa = T.ECIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_PlanOpcionSeleccion', COUNT_BIG(*)
FROM dbo.ff_PlanOpcionSeleccion AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.POIdSolicitud AND S.IdEmpresa = T.POIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_PlanOpcionSeleccionCobranza', COUNT_BIG(*)
FROM dbo.ff_PlanOpcionSeleccionCobranza AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.POIdSolicitud AND S.IdEmpresa = T.POIdEmpresa
UNION ALL
SELECT N'CONTEOS', N'ff_PlanOpcionSeleccionCobranza2', COUNT_BIG(*)
FROM dbo.ff_PlanOpcionSeleccionCobranza2 AS T
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = T.POIdSolicitud AND S.IdEmpresa = T.POIdEmpresa
ORDER BY NombreTabla;

/* ========================================================================
   2. EMPRESA, VIGENCIAS, PERFILES Y PERIODICIDAD.
   ======================================================================== */
SELECT N'ff_Empresa' AS __Tabla, E.*
FROM dbo.ff_Empresa AS E
INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMidEmpresa
ORDER BY E.EMidEmpresa;

SELECT N'ff_Parametro' AS __Tabla, P.*
FROM dbo.ff_Parametro AS P
INNER JOIN @Empresas AS E ON E.IdEmpresa = P.paIdEmpresa
ORDER BY P.paIdEmpresa, P.paClase;

SELECT N'ff_Perfil' AS __Tabla, P.*
FROM dbo.ff_Perfil AS P
INNER JOIN @Empresas AS E ON E.IdEmpresa = P.PEIdEmpresa
ORDER BY P.PEIdEmpresa, P.PEIdPerfil;

SELECT N'ff_Rol' AS __Tabla, R.*
FROM dbo.ff_Rol AS R
WHERE R.ROIdRol IN
(
    SELECT DISTINCT E.EMIdRol
    FROM dbo.ff_Empleado AS E
    INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMIdEmpresa
    UNION
    SELECT DISTINCT P.PEIdRolDefault
    FROM dbo.ff_Perfil AS P
    INNER JOIN @Empresas AS X ON X.IdEmpresa = P.PEIdEmpresa
)
ORDER BY R.ROIdRol;

SELECT N'ff_TipoSalario' AS __Tabla, TS.*
FROM dbo.ff_TipoSalario AS TS
WHERE TS.IdTipoSalario IN
(
    SELECT DISTINCT E.EMIdTipoSalario
    FROM dbo.ff_Empleado AS E
    INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMIdEmpresa
)
ORDER BY TS.IdTipoSalario;

SELECT N'ff_Vigencia' AS __Tabla, V.*
FROM dbo.ff_Vigencia AS V
WHERE V.VIIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
  AND EXISTS
      (
          SELECT 1
          FROM dbo.ff_Empresa AS E
          INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMidEmpresa
          WHERE E.EMidConfiguracion = V.VIIdConfiguracion
      )
ORDER BY V.VIIdVigencia;

SELECT N'ff_VigenciaCalendarioPago' AS __Tabla, VC.*
FROM dbo.ff_VigenciaCalendarioPago AS VC
WHERE VC.VCIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
ORDER BY VC.VCIdVigencia;

SELECT N'ff_PeriodicidadPago' AS __Tabla, PP.*
FROM dbo.ff_PeriodicidadPago AS PP
WHERE PP.PPIdPeriodicidadPago IN
(
    SELECT DISTINCT VC.VCIdPeriodicidadPago
    FROM dbo.ff_VigenciaCalendarioPago AS VC
    WHERE VC.VCIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
)
ORDER BY PP.PPIdPeriodicidadPago;

/* ========================================================================
   3. EMPLEADOS, HISTORICO Y TRANSFERENCIAS.
   ======================================================================== */
SELECT N'ff_Empleado' AS __Tabla, E.*
FROM dbo.ff_Empleado AS E
INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMIdEmpresa
ORDER BY E.EMIdEmpresa, E.EMNumeroEmpleado, E.EMIdParentesco;

/* El historico solo se usa en cobranza no-actual; se acota al rango probado. */
SELECT N'ff_Empleado_Historico' AS __Tabla, H.*
FROM dbo.ff_Empleado_Historico AS H
INNER JOIN @Empresas AS E ON E.IdEmpresa = H.EMIdEmpresa
WHERE H.EMFechaCambio >= @FecIni
  AND H.EMFechaCambio < @FecFinExclusiva
ORDER BY H.EMId, H.EMHIdHist;

SELECT N'ff_Transferencia' AS __Tabla, T.*
FROM dbo.ff_Transferencia AS T
WHERE (T.TRIdEmpresaOrigen IN (SELECT IdEmpresa FROM @Empresas)
    OR T.TRIdEmpresaDestino IN (SELECT IdEmpresa FROM @Empresas))
  AND T.TRFechaTransferencia >= @FecIni
  AND T.TRFechaTransferencia < @FecFinExclusiva
ORDER BY T.TRFechaTransferencia;

/* ========================================================================
   4. SOLICITUDES Y MOVIMIENTOS QUE ALIMENTAN COBRANZA.
   ======================================================================== */
SELECT N'ff_Solicitud' AS __Tabla, S.*
FROM dbo.ff_Solicitud AS S
INNER JOIN @Solicitudes AS X
        ON X.IdSolicitud = S.SOIdSolicitud AND X.IdEmpresa = S.SOIdEmpresa
ORDER BY S.SOIdEmpresa, S.SOIdVigencia, S.SOIdSolicitud;

SELECT N'ff_EdoCuenta' AS __Tabla, EC.*
FROM dbo.ff_EdoCuenta AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
ORDER BY EC.ECIdEmpresa, EC.ECIdSolicitud, EC.ECIdEmpleado;

SELECT N'ff_EdoCuentaCobranza' AS __Tabla, EC.*
FROM dbo.ff_EdoCuentaCobranza AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
ORDER BY EC.ECIdEmpresa, EC.ECIdSolicitud, EC.ECIdEmpleado;

SELECT N'ff_EdoCuentaCobranza2' AS __Tabla, EC.*
FROM dbo.ff_EdoCuentaCobranza2 AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
ORDER BY EC.ECIdEmpresa, EC.ECIdSolicitud, EC.ECIdEmpleado;

SELECT N'ff_PlanOpcionSeleccion' AS __Tabla, POS.*
FROM dbo.ff_PlanOpcionSeleccion AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
ORDER BY POS.POIdEmpresa, POS.POIdSolicitud, POS.POIdEmpleado;

SELECT N'ff_PlanOpcionSeleccionCobranza' AS __Tabla, POS.*
FROM dbo.ff_PlanOpcionSeleccionCobranza AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
ORDER BY POS.POIdEmpresa, POS.POIdSolicitud, POS.POIdEmpleado;

SELECT N'ff_PlanOpcionSeleccionCobranza2' AS __Tabla, POS.*
FROM dbo.ff_PlanOpcionSeleccionCobranza2 AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
ORDER BY POS.POIdEmpresa, POS.POIdSolicitud, POS.POIdEmpleado;

/* Historico del resultado; B3 consulta el periodo anterior (agosto 2026). */
SELECT N'ff_CobranzaConcentrada' AS __Tabla, CC.*
FROM dbo.ff_CobranzaConcentrada AS CC
INNER JOIN @Empresas AS E ON E.IdEmpresa = CC.CCIdEmpresa
WHERE CC.CCIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
ORDER BY CC.CCIdEmpresa, CC.CCIdVigencia, CC.CCIdEmpleado;

SELECT N'ff_CompensacionEmpleado' AS __Tabla, CE.*
FROM dbo.ff_CompensacionEmpleado AS CE
WHERE CE.CEIdEmpleado IN (SELECT IdEmpleado FROM @Empleados)
ORDER BY CE.CEIdEmpleado;

SELECT N'ff_CompensacionPlanOpcion' AS __Tabla, CP.*
FROM dbo.ff_CompensacionPlanOpcion AS CP
WHERE CP.CPIdPlanOpcion IN
(
    SELECT DISTINCT EC.ECIdPlanOpcion
    FROM dbo.ff_EdoCuenta AS EC
    INNER JOIN @Solicitudes AS S
            ON S.IdSolicitud = EC.ECIdSolicitud
           AND S.IdEmpresa = EC.ECIdEmpresa
    WHERE EC.ECIdPlanOpcion IS NOT NULL
)
OR CP.CPIdCompensacion IN
(
    SELECT EC.ECIdCompensacion
    FROM dbo.ff_EdoCuenta AS EC
    INNER JOIN @Solicitudes AS S
            ON S.IdSolicitud = EC.ECIdSolicitud
           AND S.IdEmpresa = EC.ECIdEmpresa
    WHERE EC.ECIdCompensacion IS NOT NULL
    UNION
    SELECT EC.ECIdCompensacion
    FROM dbo.ff_EdoCuentaCobranza2 AS EC
    INNER JOIN @Solicitudes AS S
            ON S.IdSolicitud = EC.ECIdSolicitud
           AND S.IdEmpresa = EC.ECIdEmpresa
    WHERE EC.ECIdCompensacion IS NOT NULL
);

SELECT N'ff_CobranzaSubtotal' AS __Tabla, CS.*
FROM dbo.ff_CobranzaSubtotal AS CS
INNER JOIN @Empresas AS E ON E.IdEmpresa = CS.CSIdEmpresa
ORDER BY CS.CSIdEmpresa;

/* El SP la relaciona por numero de empleado; se refuerza con la empresa. */
SELECT N'ff_DescuentoEmpleado' AS __Tabla, DE.*
FROM dbo.ff_DescuentoEmpleado AS DE
WHERE DE.DEIdEmpresa IN (SELECT IdEmpresa FROM @Empresas)
  AND DE.DENumeroEmpleado IN
      (SELECT NumeroEmpleado FROM @Empleados WHERE NumeroEmpleado IS NOT NULL)
  AND DE.DEIdAno = YEAR(DATEADD(MONTH, -1, @FecFin))
  AND DE.DEIdMes = MONTH(DATEADD(MONTH, -1, @FecFin))
ORDER BY DE.DENumeroEmpleado, DE.DEIdAno, DE.DEIdMes, DE.DEIdQuincena;

/* ========================================================================
   5. CONFIGURACION DE PLANES Y CATALOGOS REFERENCIADOS.
   ======================================================================== */
SELECT N'ff_PlanOpcionPerfil' AS __Tabla, PP.*
FROM dbo.ff_PlanOpcionPerfil AS PP
WHERE PP.PPIdPerfil IN (SELECT IdPerfil FROM @Perfiles)
ORDER BY PP.PPIdPerfil, PP.PPIdPlanOpcion;

DECLARE @PlanOpciones TABLE
(
    IdPlanOpcion int NOT NULL PRIMARY KEY
);

INSERT @PlanOpciones(IdPlanOpcion)
SELECT DISTINCT PP.PPIdPlanOpcion
FROM dbo.ff_PlanOpcionPerfil AS PP
WHERE PP.PPIdPerfil IN (SELECT IdPerfil FROM @Perfiles)
UNION
SELECT DISTINCT POS.POIdPlanOpcion
FROM dbo.ff_PlanOpcionSeleccion AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
WHERE POS.POIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT POS.POIdPlanOpcion
FROM dbo.ff_PlanOpcionSeleccionCobranza AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
WHERE POS.POIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT POS.POIdPlanOpcion
FROM dbo.ff_PlanOpcionSeleccionCobranza2 AS POS
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = POS.POIdSolicitud AND S.IdEmpresa = POS.POIdEmpresa
WHERE POS.POIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT EC.ECIdPlanOpcion
FROM dbo.ff_EdoCuenta AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
WHERE EC.ECIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT EC.ECIdPlanOpcion
FROM dbo.ff_EdoCuentaCobranza AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
WHERE EC.ECIdPlanOpcion IS NOT NULL
UNION
SELECT DISTINCT EC.ECIdPlanOpcion
FROM dbo.ff_EdoCuentaCobranza2 AS EC
INNER JOIN @Solicitudes AS S
        ON S.IdSolicitud = EC.ECIdSolicitud AND S.IdEmpresa = EC.ECIdEmpresa
WHERE EC.ECIdPlanOpcion IS NOT NULL;

DECLARE @Planes TABLE
(
    IdPlan int NOT NULL PRIMARY KEY
);

INSERT @Planes(IdPlan)
SELECT DISTINCT PO.POIdPlan
FROM dbo.ff_PlanOpcion AS PO
WHERE PO.POIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones);

DECLARE @Tarifas TABLE
(
    IdTarifa int NOT NULL PRIMARY KEY
);

INSERT @Tarifas(IdTarifa)
SELECT DISTINCT T.TAIdTarifa
FROM dbo.ff_Tarifa AS T
WHERE T.TAIdVigencia IN (SELECT IdVigencia FROM @Vigencias);

SELECT N'ff_PlanOpcion' AS __Tabla, PO.*
FROM dbo.ff_PlanOpcion AS PO
WHERE PO.POIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY PO.POIdPlan, PO.POIdPlanOpcion;

SELECT N'ff_Plan' AS __Tabla, P.*
FROM dbo.ff_Plan AS P
WHERE P.PLIdPlan IN (SELECT IdPlan FROM @Planes)
ORDER BY P.PLIdPlan;

SELECT N'ff_PlanOpcionVigencia' AS __Tabla, POV.*
FROM dbo.ff_PlanOpcionVigencia AS POV
WHERE POV.VCIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
  AND POV.VCIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY POV.VCIdVigencia, POV.VCIdPlanOpcion;

SELECT N'ff_Tarifa' AS __Tabla, T.*
FROM dbo.ff_Tarifa AS T
WHERE T.TAIdTarifa IN (SELECT IdTarifa FROM @Tarifas)
ORDER BY T.TAIdTarifa;

SELECT N'ff_TarifaCosto' AS __Tabla, TC.*
FROM dbo.ff_TarifaCosto AS TC
WHERE TC.TCIdTarifa IN (SELECT IdTarifa FROM @Tarifas)
  AND TC.TCIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY TC.TCIdTarifa, TC.TCIdPlanOpcion;

SELECT N'ff_TarifaCostoPerfil' AS __Tabla, TCP.*
FROM dbo.ff_TarifaCostoPerfil AS TCP
WHERE TCP.TPIdTarifa IN (SELECT IdTarifa FROM @Tarifas)
  AND TCP.TPIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
  AND TCP.TPIdPerfil IN (SELECT IdPerfil FROM @Perfiles)
ORDER BY TCP.TPIdTarifa, TCP.TPIdPlanOpcion, TCP.TPIdPerfil;

SELECT N'bf_TipoPagoPlan' AS __Tabla, TP.*
FROM dbo.bf_TipoPagoPlan AS TP
WHERE TP.TPIdTipoPago IN
(
    SELECT DISTINCT P.PLIdTipoPago
    FROM dbo.ff_Plan AS P
    WHERE P.PLIdPlan IN (SELECT IdPlan FROM @Planes)
)
ORDER BY TP.TPIdTipoPago;

SELECT N'ff_Ramo' AS __Tabla, R.*
FROM dbo.ff_Ramo AS R
WHERE R.RAIdRamo IN
(
    SELECT DISTINCT P.PLIdRamo
    FROM dbo.ff_Plan AS P
    WHERE P.PLIdPlan IN (SELECT IdPlan FROM @Planes)
)
ORDER BY R.RAIdRamo;

SELECT N'ff_ConcepAgrupaCob' AS __Tabla, CA.*
FROM dbo.ff_ConcepAgrupaCob AS CA
INNER JOIN @Empresas AS E ON E.IdEmpresa = CA.CAIdEmpresa
WHERE CA.CAIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY CA.CAIdEmpresa, CA.CAIdPlanOpcion;

SELECT N'ff_GMMDesgCob' AS __Tabla, G.*
FROM dbo.ff_GMMDesgCob AS G
INNER JOIN @Empresas AS E ON E.IdEmpresa = G.GDIdEmpresa
WHERE G.GDIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY G.GDIdEmpresa, G.GDIdPlanOpcion;

SELECT N'ff_ValidaSAVida' AS __Tabla, V.*
FROM dbo.ff_ValidaSAVida AS V
WHERE V.VSIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
  AND V.VSIdEmpleado IN (SELECT IdEmpleado FROM @Empleados)
  AND V.VSIdPlanOpcion IN (SELECT IdPlanOpcion FROM @PlanOpciones)
ORDER BY V.VSIdVigencia, V.VSIdEmpleado, V.VSIdPlanOpcion;

SELECT N'ff_ConfiguracionParentesco' AS __Tabla, C.*
FROM dbo.ff_ConfiguracionParentesco AS C
WHERE C.PCIdConfiguracion IN
(
    SELECT DISTINCT E.EMIdConfiguracion
    FROM dbo.ff_Empresa AS E
    INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMIdEmpresa
)
ORDER BY C.PCIdConfiguracion;

SELECT N'ff_Sexo' AS __Tabla, S.*
FROM dbo.ff_Sexo AS S
WHERE S.SEIdSexo IN
(
    SELECT DISTINCT E.EMIdSexo
    FROM dbo.ff_Empleado AS E
    INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMIdEmpresa
)
ORDER BY S.SEIdSexo;

SELECT N'ff_GrupoParentesco' AS __Tabla, GP.*
FROM dbo.ff_GrupoParentesco AS GP
WHERE GP.GPIdGrupoParentesco IN
(
    SELECT DISTINCT POS.POIdGrupoParentesco
    FROM dbo.ff_PlanOpcionSeleccion AS POS
    INNER JOIN @Solicitudes AS S
            ON S.IdSolicitud = POS.POIdSolicitud
           AND S.IdEmpresa = POS.POIdEmpresa
    WHERE POS.POIdGrupoParentesco IS NOT NULL
    UNION
    SELECT DISTINCT POS.POIdGrupoParentesco
    FROM dbo.ff_PlanOpcionSeleccionCobranza AS POS
    INNER JOIN @Solicitudes AS S
            ON S.IdSolicitud = POS.POIdSolicitud
           AND S.IdEmpresa = POS.POIdEmpresa
    WHERE POS.POIdGrupoParentesco IS NOT NULL
    UNION
    SELECT DISTINCT POS.POIdGrupoParentesco
    FROM dbo.ff_PlanOpcionSeleccionCobranza2 AS POS
    INNER JOIN @Solicitudes AS S
            ON S.IdSolicitud = POS.POIdSolicitud
           AND S.IdEmpresa = POS.POIdEmpresa
    WHERE POS.POIdGrupoParentesco IS NOT NULL
)
ORDER BY GP.GPIdGrupoParentesco;

SELECT N'ff_GrupoParentescoParentesco' AS __Tabla, GPP.*
FROM dbo.ff_GrupoParentescoParentesco AS GPP
WHERE GPP.GPIdGrupoParentesco IN
(
    SELECT DISTINCT POS.POIdGrupoParentesco
    FROM dbo.ff_PlanOpcionSeleccionCobranza2 AS POS
    INNER JOIN @Solicitudes AS S
            ON S.IdSolicitud = POS.POIdSolicitud
           AND S.IdEmpresa = POS.POIdEmpresa
    WHERE POS.POIdGrupoParentesco IS NOT NULL
)
ORDER BY GPP.GPIdGrupoParentesco;

SELECT N'ff_Parentesco' AS __Tabla, P.*
FROM dbo.ff_Parentesco AS P
WHERE P.PAIdParentesco IN
(
    SELECT DISTINCT E.EMIdParentesco
    FROM dbo.ff_Empleado AS E
    INNER JOIN @Empresas AS X ON X.IdEmpresa = E.EMIdEmpresa
    WHERE E.EMIdParentesco IS NOT NULL
)
ORDER BY P.PAIdParentesco;

SELECT N'ff_TablaEncabezado' AS __Tabla, EN.*
FROM dbo.ff_TablaEncabezado AS EN
INNER JOIN @Empresas AS E ON E.IdEmpresa = EN.ENIdEmpresa
ORDER BY EN.ENIdEmpresa, EN.ENClave;

SELECT N'ff_TablaEncabezadoDetalle' AS __Tabla, TD.*
FROM dbo.ff_TablaEncabezadoDetalle AS TD
WHERE TD.TEEnClave IN
(
    SELECT EN.ENClave
    FROM dbo.ff_TablaEncabezado AS EN
    INNER JOIN @Empresas AS E ON E.IdEmpresa = EN.ENIdEmpresa
)
ORDER BY TD.TEEnClave, TD.TEIdDetalle;

SELECT N'bf_MobileDatoAseguradoraProveedor' AS __Tabla, AP.*
FROM dbo.bf_MobileDatoAseguradoraProveedor AS AP
WHERE AP.DAPIdAseguradoraProveedor IN
(
    SELECT DISTINCT P.PLIdAseguradora
    FROM dbo.ff_Plan AS P
    WHERE P.PLIdPlan IN (SELECT IdPlan FROM @Planes)
)
ORDER BY AP.DAPIdAseguradoraProveedor;

/* ========================================================================
   6. COBROS CON TARJETA (solo si la empresa tiene planes tipo TC).
   ======================================================================== */
SELECT N'bf_RegistroTarjetaEmpleado' AS __Tabla, RT.*
FROM dbo.bf_RegistroTarjetaEmpleado AS RT
WHERE RT.RTEIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
ORDER BY RT.RTEIdVigencia, RT.RTEIdEmpleadoTitular;

SELECT N'bf_BanwireRecibos' AS __Tabla, BR.*
FROM dbo.bf_BanwireRecibos AS BR
WHERE EXISTS
(
    SELECT 1
    FROM dbo.bf_RegistroTarjetaEmpleado AS RT
    WHERE RT.RTEIdRegistroTarjeta = BR.BRIdRegistroTarjeta
      AND RT.RTEIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
)
ORDER BY BR.BRIdRegistroTarjeta, BR.BRFechaDeCobro;

SELECT N'bf_BanwireRecibosDetalle' AS __Tabla, BD.*
FROM dbo.bf_BanwireRecibosDetalle AS BD
WHERE EXISTS
(
    SELECT 1
    FROM dbo.bf_BanwireRecibos AS BR
    INNER JOIN dbo.bf_RegistroTarjetaEmpleado AS RT
            ON RT.RTEIdRegistroTarjeta = BR.BRIdRegistroTarjeta
    WHERE RT.RTEIdVigencia IN (SELECT IdVigencia FROM @Vigencias)
      AND BD.BRDIdDetalle = BR.BRIdDetalle
      AND BD.BRDIdDelEmpleado = RT.RTEIdEmpleadoTitular
)
ORDER BY BD.BRDIdDelEmpleado, BD.BRDIdDetalle;

/* ========================================================================
   7. CACHE B3 EXISTENTE. Es informacion derivada: sirve para diagnostico;
      normalmente NO debe copiarse a local, se reconstruye ejecutando el SP.
   ======================================================================== */
IF OBJECT_ID(N'dbo.bf_CobranzaCache_ConsultaV2') IS NOT NULL
BEGIN
    EXEC sys.sp_executesql
        N'SELECT N''bf_CobranzaCache_ConsultaV2'' AS __Tabla, C.*
          FROM dbo.bf_CobranzaCache_ConsultaV2 AS C
          WHERE (C.IdEmpresa = @P_IdEmpresa
                 OR C.IdEmpresa IN
                    (SELECT E.EMidEmpresa
                     FROM dbo.ff_Empresa AS E
                     WHERE E.EMidCorporativo = @P_IdEmpresa
                       AND E.EMidEstatus = 1))
            AND C.IdVigencia IN (@P_VigenciaB2, @P_VigenciaB3)
          ORDER BY C.IdVigencia, C.CacheId DESC;',
        N'@P_IdEmpresa int, @P_VigenciaB2 int, @P_VigenciaB3 int',
        @P_IdEmpresa = @IdEmpresa,
        @P_VigenciaB2 = @IdVigenciaB2,
        @P_VigenciaB3 = @IdVigenciaB3;
END;

/* Definiciones de los SP: util para confirmar las dependencias del origen. */
SELECT N'SP_DEFINITION' AS __Tabla,
       O.name AS Procedimiento,
       OBJECT_DEFINITION(O.object_id) AS Definicion
FROM sys.objects AS O
WHERE O.type = 'P'
  AND O.name IN
      (N'ObtenCobranzaConcentrada',
       N'ObtenCobranzaConcentrada_otro_V2_BF3',
       N'ReporteCobranzaConcentrada_BF3_Cache',
       N'ff_CobranzaSincronizacion_V3_bf3',
       N'ff_ObtenEmpleadosCob_v2_bf3',
       N'ff_ObtenCobranzaDesg_Adaptada_bf3_nousar')
ORDER BY O.name;
