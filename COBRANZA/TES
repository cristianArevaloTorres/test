WHERE EXISTS(SELECT 1 FROM #NumerosEmpleado N
             WHERE N.IdEmpresa=D.DEIdEmpresa
               AND N.NumeroEmpleado=D.DENumeroEmpleado);

SELECT N'dbo.ff_CompensacionEmpleado' AS __Tabla,C.*
FROM dbo.ff_CompensacionEmpleado C
WHERE C.CEIdEmpleado IN(SELECT IdEmpleado FROM #Empleados);

SELECT N'dbo.ff_CompensacionPlanOpcion' AS __Tabla,C.*
FROM dbo.ff_CompensacionPlanOpcion C
WHERE C.CPIdPlanOpcion IN(SELECT IdPlanOpcion FROM #PlanOpciones)
   OR C.CPIdCompensacion IN
      (
          SELECT EC.ECidCompensacion FROM dbo.ff_EdoCuentaCobranza EC
          INNER JOIN #EdoCuenta1 K ON K.IdEstadoCuenta=EC.ECidEstadoCuenta
          WHERE EC.ECidEmpresa=@IdEmpresa
            AND EC.ECidCompensacion IS NOT NULL
          UNION
          SELECT EC.ECidCompensacion FROM dbo.ff_EdoCuentaCobranza2 EC
          INNER JOIN #EdoCuenta2 K ON K.IdEstadoCuenta=EC.ECidEstadoCuenta
          WHERE EC.ECidEmpresa=@IdEmpresa
            AND EC.ECidCompensacion IS NOT NULL
      );

SELECT N'dbo.ff_CobranzaConcentrada' AS __Tabla,C.*
FROM dbo.ff_CobranzaConcentrada C
WHERE C.ccIdEmpresa IN(SELECT IdEmpresa FROM #Empresas)
  AND C.ccIdEmpleado IN(SELECT IdEmpleado FROM #Empleados);

SELECT N'dbo.ff_CobranzaSubtotal' AS __Tabla,C.*
FROM dbo.ff_CobranzaSubtotal C
WHERE C.CsIdEmpresa IN(SELECT IdEmpresa FROM #Empresas);

