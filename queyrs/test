SELECT
    E.Id,
    E.EMIdEmpresa,
    EMP.EMNombre,
    E.EMNumeroEmpleado,
    E.EMIdEstatus,
    E.EMIdPerfil,
    P.PEAdministrador,
    E.EMApellidoPaterno,
    E.EMApellidoMaterno,
    E.EMNombre1
FROM dbo.ff_Empleado E WITH (NOLOCK)
INNER JOIN dbo.ff_Empresa EMP WITH (NOLOCK)
    ON EMP.EMIdEmpresa = E.EMIdEmpresa
LEFT JOIN dbo.ff_Perfil P WITH (NOLOCK)
    ON P.PEIdPerfil = E.EMIdPerfil
WHERE E.EMNumeroEmpleado IN
(
    'QA26CW0001',
    'QA26CW0002',
    'QA26CW0003',
    'QA26CW0004',
    'QA26CW0005',
    'QA26CW0006',
    'QA26CW0007'
)
ORDER BY E.EMNumeroEmpleado, E.EMIdEmpresa;



DECLARE @IdAdministrador INT = 123; -- Sustituir por el ID del administrador con el que iniciaste sesión

EXEC dbo.ff_ConsultaEmpleadosEmpresa
     @IdCorporativo     = 516,
     @IdEmpresas        = '517,661',
     @Busca             = 'QA26CW000',
     @Operador1         = 'contiene',
     @CampoBusca        = 'EMNumeroEmpleado',
     @BusquedaAvanzada  = 0,
     @OperadorAvanzado  = 'and',
     @Busca2            = '',
     @Operador2         = 'contiene',
     @CampoBusca2       = 'EMNumeroEmpleado',
     @idAdm             = @IdAdministrador;








/*
  CADENA FORD - FASE 3 DE CIERRE

  SOLO LECTURA:
    - No modifica datos.
    - No ejecuta operaciones de empleados.
    - Confirma los datos de configuracion que faltan para implementar/probar.
*/

SET NOCOUNT ON;
SET LOCK_TIMEOUT 15000;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

SELECT
    '00_CONTEXTO' AS bloque,
    CONVERT(NVARCHAR(128), SERVERPROPERTY('ServerName')) AS servidor,
    DB_NAME() AS baseDatos,
    CONVERT(NVARCHAR(128), SERVERPROPERTY('ProductVersion')) AS versionSql;

/* 01. Mapeo exacto entre la empresa externa Ford y la empresa interna BeFlex. */
IF OBJECT_ID('dbo.ff_Empresa', 'U') IS NOT NULL
   AND COL_LENGTH('dbo.ff_Empresa', 'EMIdEmpresaFlexiForbes') IS NOT NULL
BEGIN
    SELECT
        '01_MAPEO_EMPRESAS_FORD' AS bloque,
        E.EMIdEmpresa,
        E.EMNombre,
        E.EMIdEmpresaFlexiForbes AS claveExternaFord,
        E.EMIdCorporativo,
        E.EMIdConfiguracion,
        E.EMPrefijo,
        E.EMIdEstatus
    FROM dbo.ff_Empresa E
    WHERE E.EMIdEmpresa IN (517, 518, 661)
       OR CONVERT(VARCHAR(100), E.EMIdEmpresaFlexiForbes) IN ('109', '137')
    ORDER BY E.EMIdEmpresa;

    SELECT
        '02_VALIDACION_UNICIDAD_EMPRESA_EXTERNA' AS bloque,
        CONVERT(VARCHAR(100), E.EMIdEmpresaFlexiForbes) AS claveExternaFord,
        COUNT(*) AS empresasActivas,
        MIN(E.EMIdEmpresa) AS primeraEmpresaInterna,
        MAX(E.EMIdEmpresa) AS ultimaEmpresaInterna,
        CASE WHEN COUNT(*) = 1 THEN 'OK' ELSE 'MAPEO_AMBIGUO' END AS validacion
    FROM dbo.ff_Empresa E
    WHERE E.EMIdEstatus = 1
      AND CONVERT(VARCHAR(100), E.EMIdEmpresaFlexiForbes) IN ('109', '137')
    GROUP BY CONVERT(VARCHAR(100), E.EMIdEmpresaFlexiForbes)
    ORDER BY claveExternaFord;
END
ELSE
    SELECT '01_MAPEO_EMPRESAS_FORD' AS bloque,
           'No existe ff_Empresa.EMIdEmpresaFlexiForbes' AS advertencia;

/* 03. Perfiles que el SP Ford asigna directamente. */
IF OBJECT_ID('dbo.ff_Perfil', 'U') IS NOT NULL
BEGIN
    SELECT
        '03_PERFILES_FORD' AS bloque,
        P.PEIdEmpresa,
        P.PEIdPerfil,
        P.PEAdministrador,
        P.PEIdRolDefault,
        P.PEIdEstatus
    FROM dbo.ff_Perfil P
    WHERE P.PEIdPerfil IN (1792, 2242, 1790, 2241, 5344, 5346)
    ORDER BY P.PEIdEmpresa, P.PEIdPerfil;
END
ELSE
    SELECT '03_PERFILES_FORD' AS bloque, 'No existe dbo.ff_Perfil' AS advertencia;

/* 04. Roles que pueden ser seleccionados por ff_XCMTitularesAlta_Base. */
IF OBJECT_ID('dbo.ff_Rol', 'U') IS NOT NULL
BEGIN
    SELECT
        '04_ROLES_DEFAULT_FORD' AS bloque,
        R.ROIdEmpresa,
        R.ROIdRol,
        R.RODefault,
        R.ROIdEstatus
    FROM dbo.ff_Rol R
    WHERE R.ROIdEmpresa IN (517, 518, 661)
      AND R.ROIdEstatus = 1
      AND R.RODefault = 1
    ORDER BY R.ROIdEmpresa, R.ROIdRol;
END
ELSE
    SELECT '04_ROLES_DEFAULT_FORD' AS bloque, 'No existe dbo.ff_Rol' AS advertencia;

/* 05. Usuario tecnico usado dentro del SP. No se consulta ninguna credencial. */
IF OBJECT_ID('dbo.ff_administrador', 'U') IS NOT NULL
BEGIN
    SELECT
        '05_USUARIO_TECNICO_FORD' AS bloque,
        A.ADIdAdministrador,
        A.ADClaveAcceso,
        A.ADIdEstatus
    FROM dbo.ff_administrador A
    WHERE A.ADClaveAcceso = 'FORDCARGA';
END
ELSE
    SELECT '05_USUARIO_TECNICO_FORD' AS bloque, 'No existe dbo.ff_administrador' AS advertencia;

/* 06. Flujo B2/B3 configurado actualmente para Ford. */
IF OBJECT_ID('dbo.bf_ConfiguracionFlujoCargaMasiva', 'U') IS NOT NULL
BEGIN
    EXEC sys.sp_executesql N'
        SELECT
            ''06_FLUJO_CARGA_MASIVA_FORD'' AS bloque,
            CFIdEmpresa,
            CFFlujoPantalla,
            CFFlujoAutomatico,
            CFIdEstatus
        FROM dbo.bf_ConfiguracionFlujoCargaMasiva
        WHERE CFIdEmpresa IN (517, 518, 661)
        ORDER BY CFIdEmpresa;';
END
ELSE
    SELECT '06_FLUJO_CARGA_MASIVA_FORD' AS bloque,
           'La tabla bf_ConfiguracionFlujoCargaMasiva no esta desplegada en esta base' AS advertencia;

/* 07. Contrato exacto que utiliza el motor Java para leer operacion y plantilla. */
SELECT
    '07_DEFINICIONES_MOTOR_B2' AS bloque,
    V.nombreObjeto,
    CASE WHEN OBJECT_ID(V.nombreObjeto) IS NULL THEN 0 ELSE 1 END AS existe,
    OBJECT_DEFINITION(OBJECT_ID(V.nombreObjeto)) AS definicion
FROM
(
    VALUES
      ('dbo.ff_CCMOperacionPropiedades'),
      ('dbo.ff_CPlantillaCampos'),
      ('dbo.ff_CMCSexo')
) V(nombreObjeto)
ORDER BY V.nombreObjeto;

/* 08. Parametros del SP Ford que no provienen directamente de la plantilla. */
IF OBJECT_ID('dbo.ff_XCMTitularesAltaCMFORD', 'P') IS NOT NULL
   AND OBJECT_ID('dbo.ff_ConfiguracionPlantilla', 'U') IS NOT NULL
   AND OBJECT_ID('dbo.ff_Campo', 'U') IS NOT NULL
BEGIN
    SELECT
        '08_COBERTURA_PARAMETROS_SP_FORD' AS bloque,
        P.parameter_id,
        P.name AS parametroSP,
        TYPE_NAME(P.user_type_id) AS tipoDato,
        CASE
            WHEN C.CAIdCampo IS NOT NULL THEN 'PLANTILLA_3748'
            WHEN P.name = '@EMIdEmpresa' THEN 'CONTEXTO_Y_RECALCULADO_POR_SP'
            WHEN P.name IN ('@EMIdEstatus', '@EMPerfil') THEN 'COMPATIBILIDAD_REQUERIDA'
            ELSE 'REVISAR'
        END AS origenEsperado
    FROM sys.parameters P
    LEFT JOIN
    (
        SELECT DISTINCT C.CAIdCampo, LTRIM(RTRIM(C.CANombreCampo)) AS CANombreCampo
        FROM dbo.ff_ConfiguracionPlantilla CP
        INNER JOIN dbo.ff_Campo C ON C.CAIdCampo = CP.CAIdCampo
        WHERE CP.PLIdPlantilla = 3748
          AND CP.CPIdEstatus = 1
    ) C
      ON C.CANombreCampo = SUBSTRING(P.name, 2, 256)
    WHERE P.object_id = OBJECT_ID('dbo.ff_XCMTitularesAltaCMFORD')
    ORDER BY P.parameter_id;
END

/* 09. Disponibilidad de catalogos de oficina utilizados por el SP Ford. */
IF OBJECT_ID('dbo.ff_TablaEncabezado', 'U') IS NOT NULL
   AND OBJECT_ID('dbo.ff_TablaEncabezadoDetalle', 'U') IS NOT NULL
BEGIN
    SELECT
        '09_CATALOGOS_OFICINA_FORD' AS bloque,
        H.ENIdEmpresa,
        H.ENEncabezado,
        COUNT(*) AS detallesActivos,
        COUNT(DISTINCT LEFT(LTRIM(RTRIM(D.TEDescripcion)), 5)) AS clavesDistintas
    FROM dbo.ff_TablaEncabezado H
    INNER JOIN dbo.ff_TablaEncabezadoDetalle D
        ON D.TEEnClave = H.ENClave
    WHERE H.ENIdEmpresa IN (517, 518, 661)
      AND H.ENIdEstatus = 1
      AND H.ENEncabezado IN ('area', 'FORD MOTOR')
    GROUP BY H.ENIdEmpresa, H.ENEncabezado
    ORDER BY H.ENIdEmpresa, H.ENEncabezado;
END
ELSE
    SELECT '09_CATALOGOS_OFICINA_FORD' AS bloque,
           'Faltan tablas de encabezados/catalogos' AS advertencia;

