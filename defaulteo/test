<div #controlesBusqueda id="controlesBusqueda" class="guided-special-defaulteo">
    <div class="card w-100 workflow-card search-card">
        <div class="card-body px-3">
            <header class="workflow-card__header search-header">
                <div class="section-heading">
                    <span class="step-badge">1</span>
                    <div>
                        <h2>Busca a los empleados</h2>
                        <p>Selecciona una o varias empresas y utiliza los criterios necesarios para localizar la población.</p>
                    </div>
                </div>
            </header>
            <div class="row">
                <div class="col-8 justify-content-start align-items-end">
                    <button type="button" class="help-button" data-bs-toggle="modal" data-bs-target="#modalAyuda"
                        (click)="buscaAyuda()" title="Abrir ayuda">
                        <span class="px-1" data-bs-toggle="tooltip" title="Ayuda">
                            <img src="/assets/iconos/Icono_VER AYUDA.PNG" alt="" />
                        </span>
                        Ayuda
                    </button>
                </div>
                <div class="col-4">
                    <label class="text-general-color label-text" for="selectVigencia">Vigencia (más actual): </label>
                    <!-- CREA06 (obs 21-jul): combo de vigencia deshabilitado; siempre se opera sobre la vigencia mas actual (vigente). -->
                    <select class="form-select input-text-font" [disabled]="true" id="selectVigencia" #selectVigencia
                        style=" margin-right:  8px" required (ngModelChange)="obtenerMultivigencia(selectVigencia.value)"
                        [(ngModel)]="idVigenciaSeleccionada">
                        <option *ngFor="let vigencia of comboVigencias" [value]="vigencia.VIidVigencia">{{vigencia.ViNombre}}
                        </option>
                    </select>
                </div>
            </div>
            <hr>
            <!-- Busqueda avanzada -->
            <div class="row search-layout"> <!-- Fila busqueda normal -->
                <div class="col-5"> <!-- Empresa -->
                    <div class="col-12 mb-3 ml-1 mr-1 w-100">
                        <label class="text-general-color label-text">Empresa: </label>
                        <div *ngIf="errorRep.empresas">
                            <label class="label-text" style="color:red">Falta seleccionar uno o más empresas.</label>
                        </div>
                        <div class="w-100 h-100">
                            <div style="max-height: 250px;" class="card scroll" id="arbolEmpresas">
                                <div *ngIf="arbol.length == 0" class="mat-app-background spinner-wrapper">
                                    <mat-progress-spinner mode="indeterminate" color="accent" diameter="50" strokeWidth="5">
                                    </mat-progress-spinner>
                                </div>
                                <div *ngIf="arbol.length > 0" class="mat-app-background basic-container tree-padding">
                                    <tree-checklist-component [datainput]="arbol" (result)=" seleccionEmpresa($event)">Cargando
                                    </tree-checklist-component>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-2"> <!-- Atributo campo 1-->
                    <label class="text-general-color label-text">Búsqueda por:</label>
                    <select class="form-select input-text-font" [(ngModel)]="parametrosBusqueda.idAtributo1">
                        <option *ngFor="let option of atributoEmpleado" [value]="option.key">
                            {{ option.value }}
                        </option>
                    </select>
                </div>
                <div class="col-2"> <!-- Operador comparacion 1-->
                    <label class="text-general-color label-text">Operador:</label>
                    <select class="form-select input-text-font" [(ngModel)]="parametrosBusqueda.idTipoOperador1">
                        <option *ngFor="let option of tipoOperador" [value]="option.key">
                            {{ option.value }}
                        </option>
                    </select>
                </div>
                <div class="col-2"> <!-- Paremtro busqueda 1-->
                    <label class="text-general-color label-text">Valor:</label>
                    <input #inputBuscar1 type="text" maxlength="35" 
                    class="form-control input-text-font" 
                    [class.is-invalid]="errorRep.parametroBusqueda1" 
                    placeholder="Introduce tu búsqueda" 
                    aria-label="Valor del primer criterio de búsqueda"
                    aria-describedby="buttonBuscar" 
                    name="inputBuscar1" id="inputBuscar1"
                    [(ngModel)]="parametrosBusqueda.parametroBusqueda1"
                    (keyup)="validarParametros(1)"
                    (change)="validarInput(inputBuscar1.value);"> 
                </div>
                <div class="col-1 search-button-column"> <!-- Buton busqueda-->
                    <button (click)="busquedaAvanzada();" class="btn btn-primary search-button" type="button" id="buttonBuscar" [disabled]="loadEditar">
                        <img src="/assets/iconos/Icono_BUSCAR.PNG" width="20" height="20" />
                        <span>{{ loadEditar ? 'Buscando...' : 'Buscar' }}</span>
                    </button>
                </div>
            </div>
            <div class="row advanced-search-row"> <!-- Fila busqueda avanzada -->
                <div class="col-2 advanced-toggle-column"> <!-- Check busqueda avanzada -->
                    <label class="text-general-color label-text" for="esBusquedaAvanzada">Búsqueda avanzada:&nbsp;&nbsp;</label>
                    <input  type="checkbox" id="esBusquedaAvanzada" name="avanzada" [(ngModel)]="esBusquedaAvanzada">
                </div>
                <div class="col-2 advanced-reset-column" [hidden]="!esBusquedaAvanzada"> <!-- Buton resetear formulario-->
                    <label class="text-general-color label-text">Limpiar formulario:</label>
                    <button (click)="reiniciarFormularioBusqueda();" class="btn icon-buttons" type="button" id="buttonLimpiarBusqueda" style="margin-top: 1.2em;" title="Reiniciar formulario" aria-label="Limpiar criterios de búsqueda">
                        <img src="/assets/iconos/Icono_ELIMINAR.PNG" width="24" height="24" />  
                    </button>
                </div>
                <div class="col-1" [hidden]="!esBusquedaAvanzada"> <!-- Operador-->
                    <label class="text-general-color label-text">Operador:</label>
                    <select class="form-select input-text-font" [(ngModel)]="parametrosBusqueda.idTipoOperadorAvanzado">
                        <option *ngFor="let option of tipoOperadorLogico" [value]="option.key">
                            {{ option.value }}
                        </option>
                    </select>
                </div>
                <div class="col-2" [hidden]="!esBusquedaAvanzada"> <!-- Atributo campo 2-->
                    <label class="text-general-color label-text">Búsqueda por:</label>
                    <select class="form-select input-text-font" [(ngModel)]="parametrosBusqueda.idAtributo2">
                        <option *ngFor="let option of atributoEmpleado" [value]="option.key">
                            {{ option.value }}
                        </option>
                    </select>
                </div>
                <div class="col-2" [hidden]="!esBusquedaAvanzada"> <!-- Operador comparacion 2-->
                    <label class="text-general-color label-text">Operador:</label>
                    <select class="form-select input-text-font" [(ngModel)]="parametrosBusqueda.idTipoOperador2">
                        <option *ngFor="let option of tipoOperador" [value]="option.key">
                            {{ option.value }}
                        </option>
                    </select>
                </div>
                <div class="col-2" [hidden]="!esBusquedaAvanzada"> <!-- Paremtro busqueda 2-->
                    <label class="text-general-color label-text">Valor:</label>
                    <input #inputBuscar2 type="text" maxlength="35" 
                    class="form-control input-text-font" 
                    [class.is-invalid]="errorRep.parametroBusqueda2" 
                    placeholder="Introduce tu búsqueda" 
                    aria-label="Valor del segundo criterio de búsqueda"
                    aria-describedby="buttonBuscar" 
                    name="inputBuscar2" id="inputBuscar2"
                    [(ngModel)]="parametrosBusqueda.parametroBusqueda2"
                    (keyup)="validarParametros(2)"
                    (change)="validarInput(inputBuscar2.value);"> 
                </div>
            </div>

            <!-- Seccion defaulteo (CREA06 casos especiales: ocultada en F1; se reemplaza por opciones especiales en fases siguientes) -->
            <div *ngIf="false" [ngStyle]="{'display': seccionDefaulteo}">
                <div class="row pb-2 align-items-end">
                    <div class="col-4">
                        <label class="text-general-color label-text" for="opcionesCampo">Tipo asignación de planes</label>
                        <select class="form-select input-text-font" (change)="asignarTipoDefaulteo(tiposPlanes.value)" id="tiposPlanes"
                            #tiposPlanes required>
                            <ng-container *ngFor="let obj of planesDefaulteo">
                                <option value="{{obj.TDIdTipoDefaulteo}}">
                                    {{obj.Nombre}}
                                </option>
                            </ng-container>
                        </select>
                    </div>
                    <div class="col-2">
                        <button class="btn btn-primary label-text w-100" (click)="iniciarDefaulteo(modalCarga,modalReporte)">
                            Generar Solicitudes
                        </button></div>
                    <div class="col-2">
                        <button (click)="restaurarSeccionDefaulteo();componentBlock=false;" class="btn btn-danger label-text">
                            Cancelar
                        </button>
                    </div>
                    <div class="col-2"></div>
                    <div class="col-2"></div>
                </div>
            </div>
            <!-- Termina seccion defaulteo -->
            <br>
            <!-- CREA06 (mejoras ago-2026 + obs 12-ago): el aviso de "sin resultados" va JUNTO a la busqueda
                 (antes vivia al final del DOM y se perdia) y con el MISMO estilo que la pantalla de
                 "Crear y actualizar solicitudes" (texto centrado h5 text-general-color, sin caja). -->
            <div *ngIf="!existenDatosTabla && msjNoHayDatos" class="text-center align-items-center">
                <p style="width: 100%;" class="h5 text-general-color">No existen datos que se ajusten a tu búsqueda.</p>
            </div>
            <!-- ################# Results table ################# -->
            <ng-container *ngIf="existenDatosTabla">
                <div class="row workflow-card results-card">
                    <header class="workflow-card__header results-header">
                        <div class="section-heading">
                            <span class="step-badge">2</span>
                            <div>
                                <h2>Selecciona y prepara empleados</h2>
                                <p>{{ collectionSize }} resultado(s) encontrados · {{ empleadosSeleccionados.length }} seleccionado(s)</p>
                            </div>
                        </div>
                        <span class="result-count">{{ collectionSize }} resultado(s)</span>
                    </header>
                    <div class="table-responsive results-table-wrap">
                        <table class="table text-center results-table">
                            <thead>
                                <tr>
                                    <th class="p-1 sticky-top table-headers">Acción
                                        <br>
                                        <input  type="checkbox" (click)="seleccionarTodos($event)"  >
                                    </th>
                                    <ng-container *ngFor="let dato of datosTabla[0]">
                                        <ng-container *ngIf="  dato.key == 'nombreEmpresa' ||   dato.key == 'numEmpleado' ||  dato.key == 'perfil' || dato.key == 'ApellidoPaterno' || dato.key == 'ApellidoMaterno' || dato.key == 'Nombre1' || dato.key == 'Nombre2' || dato.key == 'fechaNacimiento'  || dato.key == 'edad' || dato.key == 'parentesco'  || dato.key == 'NumeroSolicitud'   ">
                                            <th class="p-1 sticky-top table-headers">{{ dato.key }}</th>
                                        </ng-container>
                                    </ng-container>
                                    <!-- CREA06 casos especiales: columnas nuevas (F2). Mejoras ago-2026: se retira la
                                         columna "Tipo defaulteo" por renglon; el tipo se toma del combo "Tipo asignacion
                                         de planes" (Opciones defaulteo) o de la columna TipoDefaulteo del layout. -->
                                    <th class="p-1 sticky-top table-headers">Estatus solicitud vigente actual</th>
                                    <th class="p-1 sticky-top table-headers">Numero de sol vigencia anterior</th>
                                    <th class="p-1 sticky-top table-headers">Estatus solicitud vig anterior</th>
                                </tr>
                            </thead>
                            <tbody id="BodyRespuestas">
                                <tr class="table-data" *ngFor="let fila of datosTabla | slice: (page-1) * pageSize : (page-1) * pageSize + pageSize">
                                    <ng-container *ngFor="let dato of fila">
                                        <ng-container *ngIf=" dato.key == 'seleccion'">
                                            <td>
                                                <span class="px-1" data-bs-toggle="tooltip" title="seleccionar">
                                                    <input (click)="generarListaEmpleados(fila)" type="checkbox" [(ngModel)]="dato.value" >
                                                </span>
                                            </td>
                                        </ng-container>
                                        <ng-container
                                            *ngIf="  dato.key == 'nombreEmpresa' || dato.key == 'numEmpleado' ||  dato.key == 'perfil' || dato.key == 'ApellidoPaterno' || dato.key == 'ApellidoMaterno' || dato.key == 'Nombre1' || dato.key == 'Nombre2' || dato.key == 'fechaNacimiento'  || dato.key == 'edad' || dato.key == 'parentesco'  || dato.key == 'NumeroSolicitud'     ">
                                            <td class="text-center text-uppercase table-data">{{ dato.value }}</td>
                                        </ng-container>
                                    </ng-container>
                                    <!-- CREA06 casos especiales: 4 columnas nuevas (F2 stub, se autopueblan cuando el backend devuelva las keys) -->
                                    <td class="text-center text-uppercase table-data">{{ colVal(fila, 'estatusSolicitudVigActual') || '-' }}</td>
                                    <td class="text-center text-uppercase table-data">{{ colVal(fila, 'numeroSolicitudVigAnterior') || '-' }}</td>
                                    <td class="text-center text-uppercase table-data">{{ colVal(fila, 'estatusSolicitudVigAnterior') || '-' }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- PAGINADO -->
                <div class="row">
                    <div class="row w-100 px-4 pt-1 justify-content-center">
                        <ngb-pagination [pageSize]="pageSize" [collectionSize]="collectionSize" [(page)]="page"
                            [boundaryLinks]="true" [maxSize]="15">
                        </ngb-pagination>
                    </div>
                    <div class="row w-100 pb-1 justify-content-center">
                        <div class="col-2"></div>
                        <div class="col-4 justify-content-center text-general-color label-text">
                            <input type="number" class="number text-center input-text-font" name="numerPageSize" [value]="pageSize"
                                [(ngModel)]="pageSize" [min]="1" [max]="collectionSize">
                            Resultados por página
                        </div>
                        <div class="col-4 justify-content-center text-general-color label-text">
                            Elementos mostrados {{ ((this.page - 1) * this.pageSize) + 1 }} -
                            {{ (((this.page - 1) * this.pageSize + this.pageSize)) > collectionSize ? collectionSize : ((this.page -
                            1)
                            * this.pageSize + this.pageSize) }}
                            de {{ collectionSize }}
                        </div>
                        <div class="col-2"></div>
                    </div>
                </div>
            </ng-container>
            <!-- CREA06 (incidencia 8): los paneles de carga/ejecucion de layout quedan FUERA del *ngIf de
                 resultados, para poder cargar y ejecutar un layout ya llenado sin repetir la busqueda (paso 1). -->
