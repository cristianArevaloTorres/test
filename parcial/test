DECLARE @IdCotizacion INT = 12345;

SELECT
    cd.Id AS IdCotizacionDetalle,
    cd.IdCotizacion,
    cd.FechaSolicitud,
    a.Nombre AS Aseguradora,
    a.ClaveHomologado,
    cd.IdConvenio,
    cd.IdPaqueteConvenio,
    cd.AMIS,
    cd.Paquete,
    cd.PrimaTotalAnual,
    x.XmlRespuesta.value(
        'string((/Movimientos/Movimiento/CodigoError)[1])',
        'nvarchar(4000)'
    ) AS CodigoError,
    cd.XMLSolicitud,
    cd.XMLRecepcion
FROM CotizacionDetalle cd
INNER JOIN Aseguradora a
    ON a.Id = cd.IdAseguradora
OUTER APPLY (
    SELECT TRY_CONVERT(xml, cd.XMLRecepcion) AS XmlRespuesta
) x
WHERE cd.IdCotizacion = @IdCotizacion
  AND UPPER(a.ClaveHomologado) = 'QUALITAS'
ORDER BY cd.FechaSolicitud DESC;
Necesito especialmente XMLSolicitud y XMLRecepcion.
