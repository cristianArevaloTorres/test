/*
  DIAGNOSTICO DEL ROL REAL QUE ENTREGA LOS ICONOS A BF3

  SOLO LECTURA:
    - No crea, actualiza ni elimina datos permanentes.
    - No ejecuta procedimientos de negocio.
    - Puede ejecutarse varias veces.

  CASO:
    - Corporativo CENTINELA: 2920.
    - Empresa hija CENTINELA: 2921.
    - El HTML renderizado en BF3 cargo estas rutas:
        Botones administrador_ADMINISTRACION.png
        Botones administrador_SEGURIDAD.PNG
        369_64_logout.png
    - La configuracion revisada previamente en el rol 8097 contiene:
        Boton_ADMINISTRACION.PNG
        Boton_SEGURIDAD.PNG
        Boton_CERRAR SESION.PNG

  OBJETIVO:
    1. Comparar el rol predeterminado del perfil contra el rol realmente
       asignado a cada administrador en ff_AdministradorEmpresa.
    2. Reproducir el filtro que utiliza el API Java para consultar menus:
           MRidEstatus <> 2
       El API no filtra exclusivamente MRidEstatus = 1.
    3. Localizar exactamente que rol conserva los nombres observados en HTML.
    4. Comparar CENTINELA con los cuatro corporativos que funcionaron.
*/

SET NOCOUNT ON;
SET LOCK_TIMEOUT 15000;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

DECLARE @IdCorporativoCentinela INT = 2920;
DECLARE @IdEmpresaCentinela INT = 2921;

/*
  Corporativos que funcionaron en las pruebas anteriores.
  Si las cuatro pruebas fueron otras, cambiar solamente estos valores.
*/
DECLARE @CorporativosCorrectos TABLE
(
    IdCorporativo INT NOT NULL PRIMARY KEY
);

INSERT INTO @CorporativosCorrectos (IdCorporativo)
VALUES (718), (721), (723), (727);

DECLARE @EmpresasComparadas TABLE
(
    Tipo VARCHAR(20) NOT NULL,
    IdCorporativo INT NOT NULL,
    IdEmpresa INT NOT NULL PRIMARY KEY
);

INSERT INTO @EmpresasComparadas (Tipo, IdCorporativo, IdEmpresa)
SELECT
    'CENTINELA',
    @IdCorporativoCentinela,
    @IdEmpresaCentinela;

INSERT INTO @EmpresasComparadas (Tipo, IdCorporativo, IdEmpresa)
SELECT
    'FUNCIONA',
    C.IdCorporativo,
    E.EMidEmpresa
FROM @CorporativosCorrectos C
INNER JOIN dbo.ff_Empresa E
    ON E.EMidCorporativo = C.IdCorporativo
   AND E.EMidEmpresa <> C.IdCorporativo
   AND E.EMidEstatus = 1
WHERE NOT EXISTS
(
    SELECT 1
    FROM @EmpresasComparadas X
    WHERE X.IdEmpresa = E.EMidEmpresa
);

/* 00. Servidor y base. Sirve para contrastarlos con la conexion del API. */
SELECT
    '00_CONTEXTO' AS bloque,
    CONVERT(NVARCHAR(128), SERVERPROPERTY('ServerName')) AS servidor,
    DB_NAME() AS baseDatos,
    GETDATE() AS fechaConsulta,
    @IdCorporativoCentinela AS corporativoCentinela,
    @IdEmpresaCentinela AS empresaCentinela;

/* 01. Confirma las empresas hijas incluidas en la comparacion. */
SELECT
    '01_EMPRESAS_COMPARADAS' AS bloque,
    X.Tipo,
    X.IdCorporativo,
    X.IdEmpresa,
    E.EMNombre AS empresa,
    E.EMRazonSocial,
    E.EMidEstatus
FROM @EmpresasComparadas X
LEFT JOIN dbo.ff_Empresa E
    ON E.EMidEmpresa = X.IdEmpresa
ORDER BY
    CASE WHEN X.Tipo = 'CENTINELA' THEN 0 ELSE 1 END,
    X.IdCorporativo,
    X.IdEmpresa;

/*
  02. Comprobacion principal.

  El login administrativo devuelve AEIdRol. Ese es el idRol que el navegador
  envia al endpoint de menus. No basta con que PEIdRolDefault este correcto.
*/
SELECT
    '02_ROL_REAL_DEL_ADMINISTRADOR' AS bloque,
    X.Tipo,
    X.IdCorporativo,
    X.IdEmpresa,
    E.EMNombre AS empresa,
    AE.ADIdAdministrador AS idAdministrador,
    AE.AEIdEstatus AS estatusAsignacion,
    AE.AEIdPerfil AS perfilAsignado,
    P.PENombre AS perfil,
    P.PEAdministrador,
    P.PEIdEstatus AS estatusPerfil,
    P.PEIdRolDefault AS rolPredeterminadoPerfil,
    AE.AEIdRol AS rolDevueltoPorLogin,
    R.RODescripcionCorta AS descripcionRolLogin,
    R.ROAdministrador,
    R.ROIdEstatus AS estatusRolLogin,
    CASE
        WHEN AE.AEIdRol IS NULL
            THEN 'SIN_ROL_EN_ASIGNACION'
        WHEN P.PEIdRolDefault IS NULL
            THEN 'SIN_ROL_PREDETERMINADO_EN_PERFIL'
        WHEN AE.AEIdRol = P.PEIdRolDefault
            THEN 'ROL_LOGIN_IGUAL_AL_PREDETERMINADO'
        ELSE 'ALERTA_ROL_LOGIN_DISTINTO_AL_PREDETERMINADO'
    END AS dictamenRol
FROM @EmpresasComparadas X
LEFT JOIN dbo.ff_Empresa E
    ON E.EMidEmpresa = X.IdEmpresa
LEFT JOIN dbo.ff_AdministradorEmpresa AE
    ON AE.AEIdEmpresa = X.IdEmpresa
   AND AE.AEIdEstatus = 1
LEFT JOIN dbo.ff_Perfil P
    ON P.PEIdPerfil = AE.AEIdPerfil
LEFT JOIN dbo.ff_Rol R
    ON R.ROIdRol = AE.AEIdRol
ORDER BY
    CASE WHEN X.Tipo = 'CENTINELA' THEN 0 ELSE 1 END,
    X.IdEmpresa,
    AE.ADIdAdministrador;

/*
  03. Resumen por rol de login.
  filasConsumidasPorApi cuenta estatus 0 y 1 porque Java usa <> 2.
*/
;WITH RolesAsignados AS
(
    SELECT DISTINCT
        X.Tipo,
        X.IdCorporativo,
        X.IdEmpresa,
        AE.AEIdRol AS IdRol
    FROM @EmpresasComparadas X
    INNER JOIN dbo.ff_AdministradorEmpresa AE
        ON AE.AEIdEmpresa = X.IdEmpresa
       AND AE.AEIdEstatus = 1
)
SELECT
    '03_RESUMEN_MENUS_ROL_LOGIN' AS bloque,
    RA.Tipo,
    RA.IdCorporativo,
    RA.IdEmpresa,
    RA.IdRol,
    R.RODescripcionCorta AS rol,
    R.ROAdministrador,
    R.ROIdEstatus AS estatusRol,
    SUM(CASE WHEN MR.MRidEstatus = 1 THEN 1 ELSE 0 END) AS filasActivas,
    SUM(CASE WHEN MR.MRidEstatus = 0 THEN 1 ELSE 0 END) AS filasEstatusCero,
    SUM(CASE WHEN MR.MRidEstatus <> 2 THEN 1 ELSE 0 END) AS filasConsumidasPorApi,
    COUNT(DISTINCT CASE WHEN MR.MRidEstatus <> 2 THEN MR.MRidMenu END)
        AS menusDistintosConsumidosPorApi,
    SUM(CASE
            WHEN MR.MRidEstatus <> 2
             AND LTRIM(RTRIM(ISNULL(MR.MRImagenMenu, ''))) IN
                 (
                     'Botones administrador_ADMINISTRACION.png',
                     'Botones administrador_SEGURIDAD.PNG',
                     '369_64_logout.png'
                 )
            THEN 1 ELSE 0
        END) AS rutasObservadasEnHtml
FROM RolesAsignados RA
LEFT JOIN dbo.ff_Rol R
    ON R.ROIdRol = RA.IdRol
LEFT JOIN dbo.ff_MenuRol2 MR
    ON MR.MRidRol = RA.IdRol
GROUP BY
    RA.Tipo,
    RA.IdCorporativo,
    RA.IdEmpresa,
    RA.IdRol,
    R.RODescripcionCorta,
    R.ROAdministrador,
    R.ROIdEstatus
ORDER BY
    CASE WHEN RA.Tipo = 'CENTINELA' THEN 0 ELSE 1 END,
    RA.IdEmpresa,
    RA.IdRol;

/*
  04. Reproduce la consulta del DAO JDBCFfMenusRol.consultarMenusPorRol2.
  Para los empates de MEOrden, el API no define un segundo criterio; por eso
  el orden entre duplicados no esta garantizado.
*/
;WITH RolesCentinela AS
(
    SELECT DISTINCT AE.AEIdRol AS IdRol
    FROM dbo.ff_AdministradorEmpresa AE
    WHERE AE.AEIdEmpresa = @IdEmpresaCentinela
      AND AE.AEIdEstatus = 1
)
SELECT
    '04_RESPUESTA_QUE_PUEDE_ENTREGAR_EL_API' AS bloque,
    RC.IdRol,
    R.RODescripcionCorta AS rol,
    MR.MRidMenuRol,
    MR.MRidMenu,
    M.MENombreMenu AS menu,
    M.MEPadre AS esMenuPadre,
    M.MEMenuPadre AS idMenuPadre,
    M.MEOrden AS ordenUsadoPorApi,
    MR.MRidEstatus,
    MR.MRImagenMenu,
    MR.MRRutaBanner,
    CASE
        WHEN LTRIM(RTRIM(ISNULL(MR.MRImagenMenu, ''))) IN
             (
                 'Botones administrador_ADMINISTRACION.png',
                 'Botones administrador_SEGURIDAD.PNG',
                 '369_64_logout.png'
             )
            THEN 'COINCIDE_CON_HTML_CENTINELA'
        WHEN LTRIM(RTRIM(ISNULL(MR.MRImagenMenu, ''))) IN
             (
                 'Boton_ADMINISTRACION.PNG',
                 'Boton_SEGURIDAD.PNG',
                 'Boton_CERRAR SESION.PNG'
             )
            THEN 'RUTA_ESPERADA_DE_MIGRACION'
        ELSE 'OTRA_RUTA'
    END AS dictamenRuta,
    COUNT(*) OVER
    (
        PARTITION BY RC.IdRol, MR.MRidMenu
    ) AS filasDelMismoMenuConsumidasPorApi
FROM RolesCentinela RC
INNER JOIN dbo.ff_Rol R
    ON R.ROIdRol = RC.IdRol
INNER JOIN dbo.ff_MenuRol2 MR
    ON MR.MRidRol = RC.IdRol
INNER JOIN dbo.ff_Menu M
    ON M.MEidMenu = MR.MRidMenu
WHERE MR.MRidEstatus <> 2
ORDER BY
    RC.IdRol,
    M.MEOrden;

/* 05. Localiza en que empresa y rol existen las tres rutas vistas en HTML. */
SELECT
    '05_DUENO_DE_RUTAS_OBSERVADAS_EN_HTML' AS bloque,
    R.ROIdEmpresa,
    E.EMIdCorporativo,
    E.EMNombre AS empresa,
    R.ROIdRol,
    R.RODescripcionCorta AS rol,
    R.ROAdministrador,
    R.ROIdEstatus AS estatusRol,
    MR.MRidMenuRol,
    MR.MRidMenu,
    M.MENombreMenu AS menu,
    M.MEOrden,
    MR.MRidEstatus AS estatusMenuRol,
    MR.MRImagenMenu
FROM dbo.ff_MenuRol2 MR
INNER JOIN dbo.ff_Rol R
    ON R.ROIdRol = MR.MRidRol
LEFT JOIN dbo.ff_Empresa E
    ON E.EMidEmpresa = R.ROIdEmpresa
LEFT JOIN dbo.ff_Menu M
    ON M.MEidMenu = MR.MRidMenu
WHERE LTRIM(RTRIM(ISNULL(MR.MRImagenMenu, ''))) IN
      (
          'Botones administrador_ADMINISTRACION.png',
          'Botones administrador_SEGURIDAD.PNG',
          '369_64_logout.png'
      )
ORDER BY
    CASE WHEN R.ROIdEmpresa = @IdEmpresaCentinela THEN 0 ELSE 1 END,
    R.ROIdEmpresa,
    R.ROIdRol,
    M.MEOrden,
    MR.MRidMenuRol;

/*
  06. Dictamen automatico para CENTINELA.

  Si las rutas del HTML no existen en ningun rol asignado a sus administradores,
  la respuesta visible no puede provenir de las filas consultadas en esta base.
  En ese caso se debe comparar SERVERPROPERTY/DB_NAME contra el datasource del
  API de QA y capturar en Network el idRol enviado a menu/rol/2.
*/
SELECT
    '06_DICTAMEN_CENTINELA' AS bloque,
    @IdEmpresaCentinela AS idEmpresa,
    CASE
        WHEN EXISTS
        (
            SELECT 1
            FROM dbo.ff_AdministradorEmpresa AE
            INNER JOIN dbo.ff_Perfil P
                ON P.PEIdPerfil = AE.AEIdPerfil
            WHERE AE.AEIdEmpresa = @IdEmpresaCentinela
              AND AE.AEIdEstatus = 1
              AND ISNULL(AE.AEIdRol, -1) <> ISNULL(P.PEIdRolDefault, -1)
        )
            THEN 'ROL_DE_LOGIN_DISTINTO_AL_ROL_MIGRADO'
        WHEN EXISTS
        (
            SELECT 1
            FROM dbo.ff_AdministradorEmpresa AE
            INNER JOIN dbo.ff_MenuRol2 MR
                ON MR.MRidRol = AE.AEIdRol
               AND MR.MRidEstatus <> 2
            WHERE AE.AEIdEmpresa = @IdEmpresaCentinela
              AND AE.AEIdEstatus = 1
              AND LTRIM(RTRIM(ISNULL(MR.MRImagenMenu, ''))) IN
                  (
                      'Botones administrador_ADMINISTRACION.png',
                      'Botones administrador_SEGURIDAD.PNG',
                      '369_64_logout.png'
                  )
        )
            THEN 'EL_ROL_REAL_CONSERVA_LAS_RUTAS_GRISES'
        ELSE 'HTML_NO_COINCIDE_CON_ESTA_BD_REVISAR_DATASOURCE_O_IDROL_DEL_API'
    END AS dictamen;

