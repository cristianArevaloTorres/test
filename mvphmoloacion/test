            var versionnav = arreglo[1];
            //alert(this.nombrenav+":"+this.versionnav);
            //console.log('' + this.nombrenav);
            if (('' + nombrenav) == 'Safari') {
                localStorage.setItem('systemRead', 'iOS');
            }
        }
