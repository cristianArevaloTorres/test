/*
  COMPARACION DE ICONOS: HAPAG 496 VS CENTINELA 2921

  SOLO LECTURA:
    - No crea, actualiza ni elimina datos.
    - Ejecutar en FlexiForbesv2 de QA.

  Referencias identificadas:
    - Corporativo HAPAG: 495.
    - Empresa hija HAPAG: 496.
    - Corporativo CENTINELA: 2920.
    - Empresa hija CENTINELA: 2921.
*/

SET NOCOUNT ON;
SET LOCK_TIMEOUT 15000;
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

DECLARE @IdEmpresaHapag INT = 496;
DECLARE @IdEmpresaDestino INT = 2921;

/* 00. Confirma identidad de ambas empresas. */
SELECT
    '00_EMPRESAS' AS bloque,
    E.EMidEmpresa,
    E.EMidCorporativo,
    E.EMNombre,
    E.EMRazonSocial,
    E.EMidEstatus
FROM dbo.ff_Empresa E
WHERE E.EMidEmpresa IN (@IdEmpresaHapag, @IdEmpresaDestino)
ORDER BY E.EMidEmpresa;

/* 01. Roles activos y cantidad de menus activos. */
SELECT
    '01_ROLES' AS bloque,
    R.ROIdEmpresa,
    E.EMNombre AS empresa,
    R.ROIdRol,
    R.RODescripcionCorta,
    R.ROAdministrador,
    R.ROIdEstatus,
    SUM(CASE WHEN MR.MRidEstatus = 1 THEN 1 ELSE 0 END) AS filasMenuActivas
FROM dbo.ff_Rol R
LEFT JOIN dbo.ff_Empresa E
    ON E.EMidEmpresa = R.ROIdEmpresa
LEFT JOIN dbo.ff_MenuRol2 MR
    ON MR.MRidRol = R.ROIdRol
WHERE R.ROIdEmpresa IN (@IdEmpresaHapag, @IdEmpresaDestino)
  AND R.ROIdEstatus = 1
GROUP BY
    R.ROIdEmpresa,
    E.EMNombre,
    R.ROIdRol,
    R.RODescripcionCorta,
    R.ROAdministrador,
    R.ROIdEstatus
ORDER BY R.ROIdEmpresa, R.ROAdministrador DESC, R.ROIdRol;

/*
  02. Iconos activos de menus padre. Son los que construyen la barra lateral
  observada en la captura de Hapag.
*/
SELECT
    '02_ICONOS_MENU_PADRE' AS bloque,
    R.ROIdEmpresa,
    E.EMNombre AS empresa,
    R.ROIdRol,
    R.RODescripcionCorta,
    R.ROAdministrador,
    MR.MRidMenuRol,
    MR.MRidMenu,
    M.MENombreMenu AS menu,
    M.MEOrden AS ordenMenu,
    MR.MRImagenMenu,
    CASE
        WHEN MR.MRImagenMenu LIKE '%StilosDefault/img/shared/sidebar/%'
            THEN 'ICONO_COMPARTIDO_BF3'
        ELSE 'ICONO_PROPIO_DE_EMPRESA'
    END AS tipoRuta
FROM dbo.ff_Rol R
INNER JOIN dbo.ff_MenuRol2 MR
    ON MR.MRidRol = R.ROIdRol
   AND MR.MRidEstatus = 1
INNER JOIN dbo.ff_Menu M
    ON M.MEidMenu = MR.MRidMenu
   AND M.MEPadre = 1
LEFT JOIN dbo.ff_Empresa E
    ON E.EMidEmpresa = R.ROIdEmpresa
WHERE R.ROIdEmpresa IN (@IdEmpresaHapag, @IdEmpresaDestino)
  AND R.ROIdEstatus = 1
ORDER BY
    R.ROIdEmpresa,
    R.ROAdministrador DESC,
    R.ROIdRol,
    M.MEOrden,
    MR.MRidMenuRol;

/* 03. Resumen de rutas compartidas contra rutas propias. */
SELECT
    '03_RESUMEN_TIPO_ICONO' AS bloque,
    R.ROIdEmpresa,
    E.EMNombre AS empresa,
    SUM(CASE
            WHEN MR.MRidEstatus = 1
             AND MR.MRImagenMenu LIKE '%StilosDefault/img/shared/sidebar/%'
            THEN 1 ELSE 0
        END) AS iconosCompartidosBF3,
    SUM(CASE
            WHEN MR.MRidEstatus = 1
             AND MR.MRImagenMenu NOT LIKE '%StilosDefault/img/shared/sidebar/%'
            THEN 1 ELSE 0
        END) AS iconosPropiosEmpresa,
    SUM(CASE
            WHEN MR.MRidEstatus = 1
             AND NULLIF(LTRIM(RTRIM(MR.MRImagenMenu)), '') IS NULL
            THEN 1 ELSE 0
        END) AS iconosSinRuta
FROM dbo.ff_Rol R
INNER JOIN dbo.ff_MenuRol2 MR
    ON MR.MRidRol = R.ROIdRol
LEFT JOIN dbo.ff_Empresa E
    ON E.EMidEmpresa = R.ROIdEmpresa
WHERE R.ROIdEmpresa IN (@IdEmpresaHapag, @IdEmpresaDestino)
  AND R.ROIdEstatus = 1
GROUP BY R.ROIdEmpresa, E.EMNombre
ORDER BY R.ROIdEmpresa;

