/* ================================================================
   VALIDACIONES PREVIAS. No modifican datos.
   ================================================================ */

IF NOT EXISTS
(
    SELECT 1
    FROM dbo.ff_Plantilla
    WHERE PLIdPlantilla = @IdPlantilla
)
BEGIN
    THROW 50000, 'No existe la plantilla 12062 en ff_Plantilla.', 1;
END;

/* Mostrar cualquier diferencia encontrada en el catalogo de campos. */
SELECT
    d.IdCampo,
    d.CANombreCampo AS NombreEsperado,
    RTRIM(c.CANombreCampo) AS NombreActual,
    d.CALongitud AS LongitudEsperada,
    LTRIM(RTRIM(c.CALongitud)) AS LongitudActual,
    d.CATipoDato AS TipoEsperado,
    c.CATipoDato AS TipoActual
FROM @ConfiguracionDeseada d
LEFT JOIN dbo.ff_Campo c
    ON c.CAIdCampo = d.IdCampo
WHERE c.CAIdCampo IS NULL
   OR RTRIM(c.CANombreCampo) <> d.CANombreCampo
   OR LTRIM(RTRIM(c.CALongitud)) <> d.CALongitud
   OR c.CATipoDato <> d.CATipoDato
   OR c.CAIdEstatus <> 1;

IF EXISTS
(
    SELECT 1
    FROM @ConfiguracionDeseada d
    LEFT JOIN dbo.ff_Campo c
        ON c.CAIdCampo = d.IdCampo
    WHERE c.CAIdCampo IS NULL
       OR RTRIM(c.CANombreCampo) <> d.CANombreCampo
       OR LTRIM(RTRIM(c.CALongitud)) <> d.CALongitud
       OR c.CATipoDato <> d.CATipoDato
       OR c.CAIdEstatus <> 1
)
BEGIN
    THROW 50001,
          'Los campos requeridos no coinciden con ff_Campo. No se aplicaron cambios.',
          1;
END;

IF OBJECT_ID(N'dbo.ff_CPlantillaCampos', N'P') IS NULL
BEGIN
    THROW 50002, 'No existe el procedimiento dbo.ff_CPlantillaCampos.', 1;
END;

IF OBJECT_ID(N'dbo.ff_CMCSexo_BF3', N'P') IS NULL
BEGIN
    THROW 50003, 'No existe el procedimiento dbo.ff_CMCSexo_BF3.', 1;
END;

IF OBJECT_ID(N'tempdb..#SexoBF3', N'U') IS NOT NULL
    DROP TABLE #SexoBF3;

CREATE TABLE #SexoBF3
(
    Clave VARCHAR(100),
    Valor INT
);

INSERT INTO #SexoBF3 (Clave, Valor)
EXEC dbo.ff_CMCSexo_BF3;

IF NOT EXISTS (SELECT 1 FROM #SexoBF3 WHERE UPPER(Clave) = 'MASCULINO')
   OR NOT EXISTS (SELECT 1 FROM #SexoBF3 WHERE UPPER(Clave) = 'FEMENINO')
BEGIN
    DROP TABLE #SexoBF3;
    THROW 50004,
          'ff_CMCSexo_BF3 debe contener MASCULINO y FEMENINO.',
          1;
END;

BEGIN TRY
    BEGIN TRANSACTION;

    DECLARE @CPIdTitular INT =
        ISNULL
        (
            (
                SELECT TOP (1) CPIdTitular
                FROM dbo.ff_ConfiguracionPlantilla
                WHERE PLIdPlantilla = @IdPlantilla
                ORDER BY CPIdConfiguracionPlantilla
            ),
            1
        );

    /* Agregar relaciones que todavia no existen en la plantilla. */
    INSERT INTO dbo.ff_ConfiguracionPlantilla
    (
        PLIdPlantilla,
        CAIdCampo,
        REIdRegla,
        CPIdTitular,
        CPHabilitado,
        CPVisible,
        CPEtiqueta,
        CPRequerido,
        CPRangoValores,
        CPOrden,
        CPEncriptado,
        CPIdEstatus,
        CPFechaEstatus,
        CPUsuarioAdd,
        CPFechaAdd,
        CPUsuarioUMod,
        CPFechaUMod,
        CPUsuarioDel,
        CPFechaDel,
        CPConfirmacion
    )
    SELECT
        @IdPlantilla,
        d.IdCampo,
        0,
        @CPIdTitular,
        1,
        1,
        d.CPEtiqueta,
        d.CPRequerido,
        CASE
            WHEN d.CANombreCampo = 'EMIdSexo'
                THEN 'ff_CMCSexo_BF3:'
            ELSE NULL
        END,
        d.CPOrden,
        0,
        1,
        GETDATE(),
        @Usuario,
        GETDATE(),
        @Usuario,
        GETDATE(),
        NULL,
        NULL,
        0
    FROM @ConfiguracionDeseada d
    WHERE NOT EXISTS
    (
        SELECT 1
        FROM dbo.ff_ConfiguracionPlantilla cp
        WHERE cp.PLIdPlantilla = @IdPlantilla
          AND cp.CAIdCampo = d.IdCampo
    );

    /* Configurar y reactivar los campos solicitados. */
    UPDATE cp
       SET cp.CPEtiqueta = d.CPEtiqueta,
           cp.CPOrden = d.CPOrden,
           cp.CPRequerido = d.CPRequerido,
           cp.CPHabilitado = 1,
           cp.CPVisible = 1,
           cp.CPRangoValores = CASE
                                   WHEN d.CANombreCampo = 'EMIdSexo'
                                       THEN 'ff_CMCSexo_BF3:'
                                   ELSE cp.CPRangoValores
                               END,
           cp.CPEncriptado = 0,
           cp.CPIdEstatus = 1,
           cp.CPFechaEstatus = GETDATE(),
           cp.CPUsuarioUMod = @Usuario,
           cp.CPFechaUMod = GETDATE(),
           cp.CPUsuarioDel = NULL,
           cp.CPFechaDel = NULL
    FROM dbo.ff_ConfiguracionPlantilla cp
    INNER JOIN @ConfiguracionDeseada d
        ON d.IdCampo = cp.CAIdCampo
    WHERE cp.PLIdPlantilla = @IdPlantilla;

    /* Conservar solamente una configuracion por campo. */
    ;WITH ConfiguracionesDuplicadas AS
    (
        SELECT
            cp.CPIdConfiguracionPlantilla,
            ROW_NUMBER() OVER
            (
                PARTITION BY cp.CAIdCampo
                ORDER BY cp.CPIdConfiguracionPlantilla
            ) AS NumeroFila
        FROM dbo.ff_ConfiguracionPlantilla cp
        INNER JOIN @ConfiguracionDeseada d
            ON d.IdCampo = cp.CAIdCampo
        WHERE cp.PLIdPlantilla = @IdPlantilla
    )
    UPDATE cp
       SET cp.CPIdEstatus = 2,
           cp.CPFechaEstatus = GETDATE(),
           cp.CPUsuarioUMod = @Usuario,
           cp.CPFechaUMod = GETDATE(),
           cp.CPUsuarioDel = @Usuario,
           cp.CPFechaDel = GETDATE()
    FROM dbo.ff_ConfiguracionPlantilla cp
    INNER JOIN ConfiguracionesDuplicadas d
        ON d.CPIdConfiguracionPlantilla = cp.CPIdConfiguracionPlantilla
    WHERE d.NumeroFila > 1;

    /* Desactivar campos que no pertenecen al nuevo layout. */
    UPDATE cp
       SET cp.CPIdEstatus = 2,
           cp.CPFechaEstatus = GETDATE(),
           cp.CPUsuarioUMod = @Usuario,
           cp.CPFechaUMod = GETDATE(),
           cp.CPUsuarioDel = @Usuario,
           cp.CPFechaDel = GETDATE()
    FROM dbo.ff_ConfiguracionPlantilla cp
    WHERE cp.PLIdPlantilla = @IdPlantilla
      AND NOT EXISTS
          (
              SELECT 1
              FROM @ConfiguracionDeseada d
              WHERE d.IdCampo = cp.CAIdCampo
          );

    /*
       Para la plantilla 12062 se usa CPOrden. Las demas plantillas conservan
       el orden anterior por CPIdConfiguracionPlantilla.
    */
    EXEC sys.sp_executesql N'
ALTER PROCEDURE dbo.ff_CPlantillaCampos
(
    @IdPlantilla INT
)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT
        cp.CPIdConfiguracionPlantilla,
        CANombreCampo = RTRIM(c.CANombreCampo),
        c.CADescripcionCampo,
        c.CATabla,
        c.CATipoDato,
        c.CALongitud,
        c.CATipoValor,
        c.CACaracteresValidos,
        cp.CPRangoValores,
        cp.CPRequerido,
        cp.CPEncriptado
    FROM dbo.ff_ConfiguracionPlantilla cp
    INNER JOIN dbo.ff_Campo c
        ON cp.CAIdCampo = c.CAIdCampo
    WHERE cp.PLIdPlantilla = @IdPlantilla
      AND cp.CPIdEstatus = 1
      AND c.CAIdEstatus = 1
    ORDER BY
        CASE
            WHEN @IdPlantilla = 12062
                THEN ISNULL(cp.CPOrden, cp.CPIdConfiguracionPlantilla)
            ELSE cp.CPIdConfiguracionPlantilla
        END,
        cp.CPIdConfiguracionPlantilla;
END;';

    /* Validar antes de confirmar la transaccion. */
    IF
    (
        SELECT COUNT(*)
        FROM dbo.ff_ConfiguracionPlantilla cp
        INNER JOIN dbo.ff_Campo c
            ON c.CAIdCampo = cp.CAIdCampo
        WHERE cp.PLIdPlantilla = @IdPlantilla
          AND cp.CPIdEstatus = 1
          AND c.CAIdEstatus = 1
    ) <> 23
    BEGIN
        THROW 50005,
              'La plantilla no quedo con los 23 campos activos esperados.',
              1;
    END;

    IF EXISTS
    (
        SELECT cp.CPOrden
        FROM dbo.ff_ConfiguracionPlantilla cp
        INNER JOIN dbo.ff_Campo c
            ON c.CAIdCampo = cp.CAIdCampo
        WHERE cp.PLIdPlantilla = @IdPlantilla
          AND cp.CPIdEstatus = 1
          AND c.CAIdEstatus = 1
        GROUP BY cp.CPOrden
        HAVING COUNT(*) > 1
    )
    BEGIN
        THROW 50006,
              'La plantilla contiene valores CPOrden duplicados.',
              1;
    END;

    COMMIT TRANSACTION;
END TRY
BEGIN CATCH
    IF @@TRANCOUNT > 0
        ROLLBACK TRANSACTION;

    IF OBJECT_ID(N'tempdb..#SexoBF3', N'U') IS NOT NULL
        DROP TABLE #SexoBF3;

    THROW;
END CATCH;

/* ================================================================
   VERIFICACION FINAL
   ================================================================ */

SELECT
    cp.CAIdCampo AS IdCampo,
    RTRIM(c.CANombreCampo) AS CANombreCampo,
    RTRIM(cp.CPEtiqueta) AS CPEtiqueta,
    cp.CPOrden,
    LTRIM(RTRIM(c.CALongitud)) AS CALongitud,
    c.CATipoDato,
    cp.CPRequerido,
    cp.CPRangoValores,
    cp.CPIdEstatus
FROM dbo.ff_ConfiguracionPlantilla cp
INNER JOIN dbo.ff_Campo c
    ON c.CAIdCampo = cp.CAIdCampo
WHERE cp.PLIdPlantilla = @IdPlantilla
  AND cp.CPIdEstatus = 1
  AND c.CAIdEstatus = 1
ORDER BY cp.CPOrden;

/* Este es el orden que recibira el servicio. */
EXEC dbo.ff_CPlantillaCampos @IdPlantilla = 12062;

/* Debe devolver MASCULINO y FEMENINO. */
SELECT Clave, Valor
FROM #SexoBF3
ORDER BY Valor;

