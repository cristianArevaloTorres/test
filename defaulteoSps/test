IF NOT EXISTS (SELECT 1 FROM #SexoBF3 WHERE UPPER(Clave) = 'MASCULINO')
   OR NOT EXISTS (SELECT 1 FROM #SexoBF3 WHERE UPPER(Clave) = 'FEMENINO')
BEGIN
    THROW 50003,
          'ff_CMCSexo_BF3 no contiene MASCULINO y FEMENINO. No se aplicaron cambios.',
