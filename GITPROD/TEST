# ============================================================
# FUNCIÓN PARA RESOLVER ÚNICAMENTE GLOBAL.TS
# ============================================================

function Resolver-GlobalTsConVersionDestino {
    param(
        [Parameter(Mandatory)]
        [string]$Commit
    )

    $Conflictos = @(
        git diff --name-only --diff-filter=U
    )

    $OtrosConflictos = @(
        $Conflictos | Where-Object { $_ -ne $ArchivoGlobal }
    )

    if ($OtrosConflictos.Count -gt 0) {
        Write-Host ''
        Write-Host "El commit $Commit tiene conflictos que requieren revisión manual:" -ForegroundColor Red

        $OtrosConflictos | ForEach-Object {
            Write-Host "  $_" -ForegroundColor Red
        }

        throw 'El proceso se detuvo para no resolver incorrectamente otros archivos.'
    }

    if ($ArchivoGlobal -notin $Conflictos) {
        Write-Host ''
        Write-Host 'El error no corresponde al conflicto esperado en global.ts.' -ForegroundColor Red
        git status
        throw "No se pudo resolver automáticamente el commit $Commit."
    }

    Write-Host ''
    Write-Host "Resolviendo $ArchivoGlobal..." -ForegroundColor Cyan
    Write-Host 'Se conservará la versión de PRE-MAIN-REPORTS.' -ForegroundColor Cyan

    # ours = versión de PRE-MAIN-REPORTS.
    # Evita introducir la configuración de QA.
    git checkout --ours -- $ArchivoGlobal
    if ($LASTEXITCODE -ne 0) {
        throw "No fue posible conservar la versión destino de $ArchivoGlobal."
    }

    git add -- $ArchivoGlobal
    if ($LASTEXITCODE -ne 0) {
        throw "No fue posible marcar $ArchivoGlobal como resuelto."
    }

    git diff --cached --quiet
    $ResultadoDiff = $LASTEXITCODE

    if ($ResultadoDiff -eq 0) {
        Write-Host "El commit $Commit quedó vacío y será omitido." -ForegroundColor Yellow

        git cherry-pick --skip
        if ($LASTEXITCODE -ne 0) {
            throw "No fue posible omitir el commit $Commit."
        }
    }
    elseif ($ResultadoDiff -eq 1) {
        Write-Host "Continuando el commit $Commit con los demás cambios..." -ForegroundColor Cyan

        git cherry-pick --continue
        if ($LASTEXITCODE -ne 0) {
            throw "No fue posible continuar el commit $Commit."
        }
    }
    else {
        throw 'No fue posible revisar los cambios preparados.'
    }
}

# ============================================================
# CONTINUAR FRONT DESDE EL CONFLICTO ACTUAL
# ============================================================

Set-Location -LiteralPath $RepoFront

git rev-parse --is-inside-work-tree | Out-Null
if ($LASTEXITCODE -ne 0) {
    throw "No es un repositorio Git: $RepoFront"
}

$RamaActual = (git branch --show-current).Trim()

if ($RamaActual -ne $RamaDestino) {
    throw "Front está en $RamaActual. Se esperaba la rama $RamaDestino."
}

$GitDir = (git rev-parse --absolute-git-dir).Trim()
$CherryPickHead = Join-Path $GitDir 'CHERRY_PICK_HEAD'

if (-not (Test-Path -LiteralPath $CherryPickHead)) {
    throw 'No existe el cherry-pick pendiente esperado. No se modificó nada.'
}

$CommitActivo = (git rev-parse CHERRY_PICK_HEAD).Trim()

if ($CommitActivo -ne $CommitEnConflicto) {
    throw "El commit activo es $CommitActivo y se esperaba $CommitEnConflicto."
}

Write-Host ''
Write-Host "Continuando Front desde $CommitActivo..." -ForegroundColor Cyan

Resolver-GlobalTsConVersionDestino -Commit $CommitActivo

# Confirmar que terminó el cherry-pick actual.
if (Test-Path -LiteralPath $CherryPickHead) {
    throw 'El primer cherry-pick continúa pendiente.'
}

$Pendientes = git status --porcelain

if (-not [string]::IsNullOrWhiteSpace(($Pendientes | Out-String))) {
    Write-Host 'Front todavía contiene cambios inesperados:' -ForegroundColor Red
    git status --short
    throw 'No se continuarán los demás commits.'
}

# ============================================================
# VALIDAR COMMITS RESTANTES
# ============================================================

Write-Host ''
Write-Host "Validando $($CommitsRestantesFront.Count) commits restantes de Front..." -ForegroundColor Cyan

foreach ($Commit in $CommitsRestantesFront) {
    git cat-file -e "${Commit}^{commit}"
    if ($LASTEXITCODE -ne 0) {
        throw "No existe localmente el commit $Commit."
    }

    git merge-base --is-ancestor $Commit $RamaOrigenFront
    if ($LASTEXITCODE -ne 0) {
        throw "El commit $Commit no pertenece a $RamaOrigenFront."
    }

    $Registro = @(
        (git rev-list --parents -n 1 $Commit) -split '\s+'
    )

    if ($Registro.Count -ne 2) {
        throw "El commit $Commit es un merge y no será aplicado."
    }
}

Write-Host ''
Write-Host 'COMMITS RESTANTES QUE SE APLICARÁN:' -ForegroundColor Green

foreach ($Commit in $CommitsRestantesFront) {
    git --no-pager show `
        --no-patch `
        --date=format:'%Y-%m-%d %H:%M:%S' `
        --format='%H | %ad | %an <%ae> | %s' `
        $Commit
}

$Confirmacion = Read-Host "`nEscribe CONTINUAR FRONT para aplicarlos"

if ($Confirmacion -ne 'CONTINUAR FRONT') {
    throw 'Proceso cancelado. El primer conflicto sí quedó resuelto, pero no se aplicaron los restantes.'
}

# ============================================================
# APLICAR LOS 19 COMMITS RESTANTES
# ============================================================

$Aplicados = 0

foreach ($Commit in $CommitsRestantesFront) {
    Write-Host ''
    Write-Host "Aplicando $Commit..." -ForegroundColor Cyan

    git cherry-pick --allow-empty $Commit

    if ($LASTEXITCODE -eq 0) {
        $Aplicados++
        continue
    }

    $Conflictos = @(
        git diff --name-only --diff-filter=U
    )

    # Si el único conflicto vuelve a ser global.ts,
    # se conserva automáticamente la configuración destino.
    if (
        $Conflictos.Count -eq 1 -and
        $Conflictos[0] -eq $ArchivoGlobal
    ) {
        Resolver-GlobalTsConVersionDestino -Commit $Commit
        $Aplicados++
        continue
    }

    Write-Host ''
    Write-Host "EL PROCESO SE DETUVO EN: $Commit" -ForegroundColor Red
    Write-Host 'Conflictos pendientes:' -ForegroundColor Yellow
    git status --short

    Write-Host ''
    Write-Host 'Para cancelar únicamente el commit actual:' -ForegroundColor Yellow
    Write-Host '  git cherry-pick --abort'

    throw "Conflicto manual durante el cherry-pick de $Commit."
}

# ============================================================
# VALIDAR FRONT
# ============================================================

$EstadoFinalFront = git status --porcelain

if (-not [string]::IsNullOrWhiteSpace(($EstadoFinalFront | Out-String))) {
    Write-Host 'Front terminó con cambios pendientes:' -ForegroundColor Red
    git status --short
    throw 'No se realizará ningún push.'
}

Write-Host ''
Write-Host 'FRONT TERMINADO CORRECTAMENTE' -ForegroundColor Green
Write-Host "Commits restantes aplicados: $Aplicados" -ForegroundColor Green

git --no-pager log --oneline -20

# ============================================================
# PUSH DE FRONT Y API REPORTS
# ============================================================

if ($HacerPushDeAmbos) {
    $Publicaciones = @(
        @{
            Nombre = 'FRONT'
            Ruta   = $RepoFront
        },
        @{
            Nombre = 'API REPORTS'
            Ruta   = $RepoApiReports
        }
    )

    foreach ($Publicacion in $Publicaciones) {
        Write-Host ''
        Write-Host "Preparando push de $($Publicacion.Nombre)..." -ForegroundColor Cyan

        Push-Location -LiteralPath $Publicacion.Ruta

        try {
            git show-ref --verify --quiet "refs/heads/$RamaDestino"
            if ($LASTEXITCODE -ne 0) {
                throw "No existe localmente $RamaDestino en $($Publicacion.Nombre)."
            }

            Write-Host "Commits locales pendientes de push:" -ForegroundColor Cyan
            git --no-pager log --oneline "origin/$RamaDestino..$RamaDestino"

            $ConfirmarPush = Read-Host "Escribe PUBLICAR $($Publicacion.Nombre)"

            if ($ConfirmarPush -ne "PUBLICAR $($Publicacion.Nombre)") {
                throw "No se autorizó el push de $($Publicacion.Nombre)."
            }

            git push -u origin "$RamaDestino`:$RamaDestino"

            if ($LASTEXITCODE -ne 0) {
                throw "Falló el push de $($Publicacion.Nombre)."
            }

            Write-Host "$($Publicacion.Nombre) publicado correctamente." -ForegroundColor Green
        }
        finally {
            Pop-Location
        }
    }
}
else {
    Write-Host ''
    Write-Host 'No se realizó push porque $HacerPushDeAmbos está en $false.' -ForegroundColor Yellow
}
