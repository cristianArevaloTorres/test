$ErrorActionPreference = 'Stop'

$RepoFront = 'C:\repo\reportes\FRONT'
$RepoApiReports = 'C:\repo\reportes\APIREPORTS'
$RamaDestino = 'PRE-MAIN-REPORTS'

$CommitsRestantes = @(
    '45c6def3018306d4ee2ee878c77c3823289ab889',
    'eff155abc8af8d7bec2c9c9b2cb1355c41426a9e',
    '7f7aad48a9423ff54fd50c03739958e798b4052d',
    'afddc69c10ec5313a89e3396cb21ca63a327c95c',
    '438a891651a5cdf227d194a2503cdce30a7e6a72',
    '23437799caaaced20fa34baa8d33210dacaa5478',
    'c9f0bf923ad9117e76088633c05d4c7ff28b48c5',
    'd714c5d9be8ecf4f4bca61dabc1748bdc271483c',
    '03586c8b640f62c961d917c4c18247353f7823d4',
    'df7009df60ed4c3aa202facd36b44301a496d58e',
    '487391e05df39d2d93e8427a4bcf82d25afbdd14',
    '22fb7323bded92f5e007c29576eec9192c5b7815',
    '6bf349be0de3d5d1250069faab40df3be53fe132',
    '01aa164b8a63975e28f29dc3a61064f9f7d4e309',
    '32509fec8fdbbbbd226d01e4233bfad198cdb216',
    'f5411c2918a94b07eeabef046fffd6b9e0203647',
    '7cd081ea54c4ce6ac10b2ebc2330e56a47f4ec01',
    'f213401d9c1ad51160ad0b504bdfc708e6f97028'
)

$ArchivosProtegidos = @(
    'src/app/services/calculadora-retiro.service.ts',
    'src/app/services/global.ts',
    'src/environments/environment.prod.ts',
    'src/environments/environment.ts'
)

Set-Location -LiteralPath $RepoFront

# ============================================================
# VALIDACIONES INICIALES
# ============================================================

$RamaActual = (git branch --show-current).Trim()

if ($RamaActual -ne $RamaDestino) {
    throw "Estás en $RamaActual. Se esperaba $RamaDestino."
}

$GitDir = (git rev-parse --absolute-git-dir).Trim()

if (Test-Path -LiteralPath (Join-Path $GitDir 'CHERRY_PICK_HEAD')) {
    throw 'Todavía existe un cherry-pick pendiente.'
}

$EstadoInicial = git status --porcelain

if (-not [string]::IsNullOrWhiteSpace(($EstadoInicial | Out-String))) {
    Write-Host 'Front contiene cambios locales:' -ForegroundColor Red
    git status --short
    throw 'El repositorio debe estar limpio.'
}

foreach ($Commit in $CommitsRestantes) {
    git cat-file -e "${Commit}^{commit}"

    if ($LASTEXITCODE -ne 0) {
        throw "No existe localmente el commit $Commit."
    }

    $Registro = @(
        (git rev-list --parents -n 1 $Commit) -split '\s+'
    )

    if ($Registro.Count -ne 2) {
        throw "El commit $Commit es un merge."
    }
}

Write-Host ''
Write-Host 'COMMITS RESTANTES DE FRONT:' -ForegroundColor Cyan

foreach ($Commit in $CommitsRestantes) {
    git --no-pager show `
        --no-patch `
        --date=format:'%Y-%m-%d %H:%M:%S' `
        --format='%h | %ad | %s' `
        $Commit
}

$Confirmacion = Read-Host "`nEscribe APLICAR RESTO FRONT"

if ($Confirmacion -ne 'APLICAR RESTO FRONT') {
    throw 'Proceso cancelado.'
}

# ============================================================
# APLICAR COMMITS
# ============================================================

foreach ($Commit in $CommitsRestantes) {
    Write-Host ''
    Write-Host "Aplicando $Commit..." -ForegroundColor Cyan

    $HeadAnterior = (git rev-parse HEAD).Trim()

    $ArchivosDelCommit = @(
        git diff-tree `
            --no-commit-id `
            --name-only `
            -r `
            $Commit
    )

    $ProtegidosEnCommit = @(
        $ArchivosDelCommit | Where-Object {
            $_ -in $ArchivosProtegidos
        }
    )

    git cherry-pick --allow-empty $Commit
    $ResultadoCherryPick = $LASTEXITCODE

    if ($ResultadoCherryPick -eq 0) {
        # El commit se aplicó, pero puede contener cambios limpios
        # en archivos de configuración que no deben pasar a PRE-MAIN.
        if ($ProtegidosEnCommit.Count -gt 0) {
            Write-Host 'Restaurando archivos protegidos de PRE-MAIN-REPORTS:' -ForegroundColor Yellow
            $ProtegidosEnCommit | ForEach-Object {
                Write-Host "  $_" -ForegroundColor Yellow
            }

            git restore `
                --source=$HeadAnterior `
                --staged `
                --worktree `
                -- $ProtegidosEnCommit

            if ($LASTEXITCODE -ne 0) {
                throw "No fue posible proteger la configuración después de $Commit."
            }

            git diff --cached --quiet
            $ResultadoAjuste = $LASTEXITCODE

            if ($ResultadoAjuste -eq 1) {
                git -c core.editor=true commit --amend --no-edit --allow-empty

                if ($LASTEXITCODE -ne 0) {
                    throw "No fue posible ajustar el commit $Commit."
                }
            }
            elseif ($ResultadoAjuste -ne 0) {
                throw "No fue posible validar el ajuste del commit $Commit."
            }
        }

        continue
    }

    # ========================================================
    # TRATAMIENTO DE CONFLICTOS
    # ========================================================

    $Conflictos = @(
        git diff --name-only --diff-filter=U
    )

    if ($Conflictos.Count -eq 0) {
        Write-Host 'El commit no produjo cambios nuevos; será omitido.' -ForegroundColor Yellow

        git cherry-pick --skip

        if ($LASTEXITCODE -ne 0) {
            throw "No fue posible omitir $Commit."
        }

        continue
    }

    $ConflictosProtegidos = @(
        $Conflictos | Where-Object {
            $_ -in $ArchivosProtegidos
        }
    )

    if ($ConflictosProtegidos.Count -gt 0) {
        Write-Host 'Conservando la versión PRE-MAIN de archivos protegidos:' -ForegroundColor Yellow

        $ConflictosProtegidos | ForEach-Object {
            Write-Host "  $_" -ForegroundColor Yellow
        }

        git restore `
            --source=HEAD `
            --staged `
            --worktree `
            -- $ConflictosProtegidos

        if ($LASTEXITCODE -ne 0) {
            throw "No fue posible resolver los archivos protegidos de $Commit."
        }
    }

    $ConflictosRestantes = @(
        git diff --name-only --diff-filter=U
    )

    if ($ConflictosRestantes.Count -gt 0) {
        Write-Host ''
        Write-Host "El proceso se detuvo en $Commit." -ForegroundColor Red
        Write-Host 'Estos conflictos sí requieren revisión:' -ForegroundColor Red

        $ConflictosRestantes | ForEach-Object {
            Write-Host "  $_" -ForegroundColor Red
        }

        throw "Conflicto manual en $Commit."
    }

    git diff --cached --quiet
    $ResultadoPreparado = $LASTEXITCODE

    if ($ResultadoPreparado -eq 0) {
        git cherry-pick --skip

        if ($LASTEXITCODE -ne 0) {
            throw "No fue posible omitir el commit vacío $Commit."
        }
    }
    elseif ($ResultadoPreparado -eq 1) {
        git -c core.editor=true cherry-pick --continue

        if ($LASTEXITCODE -ne 0) {
            throw "No fue posible continuar el commit $Commit."
        }
    }
    else {
        throw "No fue posible validar el commit $Commit."
    }
}

# ============================================================
# VALIDACIÓN FINAL DE FRONT
# ============================================================

$EstadoFinal = git status --porcelain

if (-not [string]::IsNullOrWhiteSpace(($EstadoFinal | Out-String))) {
    Write-Host 'Front terminó con cambios pendientes:' -ForegroundColor Red
    git status --short
    throw 'No se realizará ningún push.'
}

Write-Host ''
Write-Host 'FRONT TERMINADO CORRECTAMENTE' -ForegroundColor Green
git --no-pager log --oneline -20

# ============================================================
# PUBLICAR FRONT Y API REPORTS
# ============================================================

$Publicaciones = @(
    @{
        Nombre = 'FRONT'
        Ruta   = $RepoFront
    },
    @{
        Nombre = 'API REPORTS'
        Ruta   = $RepoApiReports
    }
)

foreach ($Publicacion in $Publicaciones) {
    Push-Location -LiteralPath $Publicacion.Ruta

    try {
        Write-Host ''
        Write-Host "REPOSITORIO: $($Publicacion.Nombre)" -ForegroundColor Cyan

        git show-ref --verify --quiet "refs/heads/$RamaDestino"

        if ($LASTEXITCODE -ne 0) {
            throw "No existe localmente $RamaDestino en $($Publicacion.Nombre)."
        }

        Write-Host 'Commits locales pendientes de publicación:' -ForegroundColor Cyan
        git --no-pager log --oneline "origin/$RamaDestino..$RamaDestino"

        $ConfirmarPush = Read-Host "Escribe PUBLICAR $($Publicacion.Nombre)"

        if ($ConfirmarPush -ne "PUBLICAR $($Publicacion.Nombre)") {
            throw "No se autorizó el push de $($Publicacion.Nombre)."
        }

        git push -u origin "$RamaDestino`:$RamaDestino"

        if ($LASTEXITCODE -ne 0) {
            throw "Falló el push de $($Publicacion.Nombre)."
        }

        Write-Host "$($Publicacion.Nombre) publicado correctamente." -ForegroundColor Green
    }
    finally {
        Pop-Location
    }
}
