$ErrorActionPreference = 'Stop'

Set-Location 'C:\repo\reportes\APIREPORTS'

$CommitEsperado = '22f437eb62cc338429e479a3d571447eeb1d0d63'
$Repositorio = 'src/main/java/com/lockton/rpt/repositories/CtlRptGenRepository.java'
$Properties = 'src/main/resources/application.properties'
$Utf8SinBom = [System.Text.UTF8Encoding]::new($false)

$RamaActual = (git branch --show-current).Trim()
if ($RamaActual -ne 'PRE-MAIN-REPORTS') {
    throw "La rama actual es $RamaActual; se esperaba PRE-MAIN-REPORTS."
}

$CommitActivo = (git rev-parse CHERRY_PICK_HEAD).Trim()
if ($CommitActivo -ne $CommitEsperado) {
    throw "El cherry-pick activo es $CommitActivo; se esperaba $CommitEsperado."
}

# Combinar ambas versiones del repositorio:
# conserva el método existente y agrega los dos métodos nuevos.
$ContenidoRepositorio = @'
package com.lockton.rpt.repositories;

import java.util.List;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import com.lockton.rpt.models.entities.ControlReporteGen;

@Repository
public interface CtlRptGenRepository extends JpaRepository<ControlReporteGen, Long> {
    boolean existsByCRptIdUsuarioSolicitudAndCRptIdReporteAndCRptIdEmpresaAndCRptParamsAndCRptIdEstatus(
            Integer cRptIdUsuarioSolicitud,
            Integer cRptIdReporte,
            Integer cRptIdEmpresa,
            String cRptParams,
            Integer cRptIdEstatus
    );

    @Query(
            "SELECT CASE WHEN COUNT(c) > 0 THEN true ELSE false END " +
                    "FROM ControlReporteGen c " +
                    "WHERE c.cRptIdUsuarioSolicitud = :cRptIdUsuarioSolicitud " +
                    "AND c.cRptIdReporte = :cRptIdReporte " +
                    "AND c.cRptIdEmpresa = :cRptIdEmpresa " +
                    "AND c.cRptParams = :cRptParams " +
                    "AND c.cRptIdEstatus = :cRptIdEstatus"
    )
    boolean existsControlReporteGen(
            @Param("cRptIdUsuarioSolicitud") Integer cRptIdUsuarioSolicitud,
            @Param("cRptIdReporte") Integer cRptIdReporte,
            @Param("cRptIdEmpresa") Integer cRptIdEmpresa,
            @Param("cRptParams") String cRptParams,
            @Param("cRptIdEstatus") Integer cRptIdEstatus
    );

    @Query(
            "SELECT c FROM ControlReporteGen c " +
                    "WHERE c.cRptIdUsuarioSolicitud = :idUsuario " +
                    "AND c.cRptIdReporte = :idReporte " +
                    "AND c.cRptIdEmpresa = :idEmpresa " +
                    "AND c.cRptParams = :params " +
                    "AND c.cRptIdEstatus IN (:estatus) " +
                    "ORDER BY c.cRptId ASC"
    )
    List<ControlReporteGen> findSolicitudesActivas(
            @Param("idUsuario") Integer idUsuario,
            @Param("idReporte") Integer idReporte,
            @Param("idEmpresa") Integer idEmpresa,
            @Param("params") String params,
            @Param("estatus") List<Integer> estatus
    );
}
'@

$RutaRepositorio = Join-Path (Get-Location) $Repositorio

[System.IO.File]::WriteAllText(
    $RutaRepositorio,
    $ContenidoRepositorio + [Environment]::NewLine,
    $Utf8SinBom
)

# Conservar application.properties de PRE-MAIN-REPORTS.
git checkout --ours -- $Properties

if ($LASTEXITCODE -ne 0) {
    throw 'No se pudo recuperar application.properties de PRE-MAIN-REPORTS.'
}

$RutaProperties = Join-Path (Get-Location) $Properties
$ContenidoProperties = [System.IO.File]::ReadAllText($RutaProperties)
$Ancla = 'spring.task.queuecapacity=50'

if (-not $ContenidoProperties.Contains($Ancla)) {
    throw "No se encontró la línea '$Ancla' en application.properties."
}

$SaltoLinea = if ($ContenidoProperties.Contains("`r`n")) {
    "`r`n"
}
else {
    "`n"
}

$LineasCobranza = @(
    '# Cobranza se procesa de forma serial para no competir por memoria/conexiones.'
    '# Las solicitudes adicionales permanecen EN_ESPERA en una cola acotada.'
    'cobranza.queue.capacity=5'
    'cobranza.queue.lock-timeout-ms=30000'
    ''
    '# La precarga automatica queda deshabilitada. Solo se habilita de forma'
    '# explicita despues de una prueba de carga controlada.'
    'cobranza.cache.worker.enabled=false'
)

$BloqueCobranza = $LineasCobranza -join $SaltoLinea

$ContenidoProperties = $ContenidoProperties.Replace(
    $Ancla,
    $Ancla + $SaltoLinea + $SaltoLinea + $BloqueCobranza
)

[System.IO.File]::WriteAllText(
    $RutaProperties,
    $ContenidoProperties,
    $Utf8SinBom
)

git add -- $Repositorio $Properties

if ($LASTEXITCODE -ne 0) {
    throw 'No fue posible preparar los dos archivos resueltos.'
}

$ConflictosPendientes = @(git diff --name-only --diff-filter=U)

if ($ConflictosPendientes.Count -gt 0) {
    Write-Host 'Todavía existen conflictos:' -ForegroundColor Red
    $ConflictosPendientes
    throw 'No se continuará el cherry-pick.'
}

$RepositorioFinal = [System.IO.File]::ReadAllText($RutaRepositorio)
$PropertiesFinal = [System.IO.File]::ReadAllText($RutaProperties)

$MetodosRequeridos = @(
    'existsByCRptIdUsuarioSolicitudAndCRptIdReporteAndCRptIdEmpresaAndCRptParamsAndCRptIdEstatus'
    'existsControlReporteGen'
    'findSolicitudesActivas'
)

foreach ($Metodo in $MetodosRequeridos) {
    if (-not $RepositorioFinal.Contains($Metodo)) {
        throw "Falta el método requerido: $Metodo"
    }
}

$PropiedadesRequeridas = @(
    'cobranza.queue.capacity=5'
    'cobranza.queue.lock-timeout-ms=30000'
    'cobranza.cache.worker.enabled=false'
    'odessa.administrador=${ODESSA_ADMINISTRADOR}'
)

foreach ($Propiedad in $PropiedadesRequeridas) {
    if (-not $PropertiesFinal.Contains($Propiedad)) {
        throw "Falta la propiedad requerida: $Propiedad"
    }
}

$Marcadores = @(
    Select-String `
        -LiteralPath $RutaRepositorio, $RutaProperties `
        -Pattern '^(<<<<<<<|=======|>>>>>>>)'
)

if ($Marcadores.Count -gt 0) {
    $Marcadores
    throw 'Todavía existen marcadores de conflicto.'
}

Write-Host ''
Write-Host 'Archivos preparados:' -ForegroundColor Cyan
git status --short
git --no-pager diff --cached --stat

git -c core.editor=true cherry-pick --continue

if ($LASTEXITCODE -ne 0) {
    throw 'No fue posible terminar el cherry-pick de 22f437e.'
}

Write-Host ''
Write-Host 'Commit 22f437e aplicado correctamente.' -ForegroundColor Green
git status
