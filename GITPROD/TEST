-----git branch --show-current
# ============================================================
# EXTRACCIÓN DE COMMITS: FRONT Y API REPORTS
# NO HACE FETCH, PULL, SWITCH, COMMIT, PUSH NI CHERRY-PICK
# ============================================================

$UsuarioGit = 'CristianLockton'

$Repositorios = @(
    @{
        Nombre = 'FRONT'
        Ruta   = 'C:\repo\reportes\FRONT'
        Rama   = 'issue-reportesabanaQA'
    },
    @{
        Nombre = 'API REPORTS'
        Ruta   = 'C:\repo\reportes\APIREPORTS'

        # Si se deja vacío, utilizará la rama actualmente seleccionada.
        Rama   = ''
    }
)

foreach ($Repo in $Repositorios) {
    Write-Host "`n============================================================" -ForegroundColor Cyan
    Write-Host "REPOSITORIO: $($Repo.Nombre)" -ForegroundColor Cyan
    Write-Host "RUTA: $($Repo.Ruta)"
    Write-Host '============================================================' -ForegroundColor Cyan

    if (-not (Test-Path -LiteralPath $Repo.Ruta -PathType Container)) {
        Write-Host "No existe la ruta: $($Repo.Ruta)" -ForegroundColor Red
        continue
    }

    Push-Location -LiteralPath $Repo.Ruta

    try {
        git rev-parse --is-inside-work-tree 2>$null | Out-Null

        if ($LASTEXITCODE -ne 0) {
            Write-Host "No es un repositorio Git: $($Repo.Ruta)" -ForegroundColor Red
            continue
        }

        $RamaActual = (git branch --show-current).Trim()

        if ([string]::IsNullOrWhiteSpace($Repo.Rama)) {
            $RamaConsultar = $RamaActual
        } else {
            $RamaConsultar = $Repo.Rama
        }

        # Prefiere la referencia remota si ya existe localmente.
        git show-ref --verify --quiet "refs/remotes/origin/$RamaConsultar"

        if ($LASTEXITCODE -eq 0) {
            $Referencia = "origin/$RamaConsultar"
        } else {
            git show-ref --verify --quiet "refs/heads/$RamaConsultar"

            if ($LASTEXITCODE -ne 0) {
                Write-Host "`nNo se encontró la rama: $RamaConsultar" -ForegroundColor Red
                Write-Host "`nRamas disponibles:" -ForegroundColor Yellow
                git branch -a
                continue
            }

            $Referencia = $RamaConsultar
        }

        Write-Host "`nRama local seleccionada: $RamaActual" -ForegroundColor Yellow
        Write-Host "Rama consultada:         $Referencia" -ForegroundColor Yellow
        Write-Host "Usuario Git filtrado:    $UsuarioGit" -ForegroundColor Yellow

        Write-Host "`n------------------------------------------------------------" -ForegroundColor Green
        Write-Host "COMMITS DEL USUARIO $UsuarioGit" -ForegroundColor Green
        Write-Host '------------------------------------------------------------' -ForegroundColor Green

        git --no-pager log `
            $Referencia `
            --author="$UsuarioGit" `
            --reverse `
            --date=format:'%Y-%m-%d %H:%M:%S' `
            --pretty=format:'COMMIT: %H%nFECHA: %ad%nAUTOR: %an <%ae>%nCOMMITTER: %cn <%ce>%nPADRES: %P%nTÍTULO: %s%nDESCRIPCIÓN:%n%b%nARCHIVOS:' `
            --name-status

        if ($LASTEXITCODE -ne 0) {
            Write-Host 'No fue posible consultar los commits.' -ForegroundColor Red
            continue
        }

        Write-Host "`n`n------------------------------------------------------------" -ForegroundColor Yellow
        Write-Host 'TODOS LOS COMMITS DE MERGE EN LA RAMA' -ForegroundColor Yellow
        Write-Host '------------------------------------------------------------' -ForegroundColor Yellow

        git --no-pager log `
            $Referencia `
            --first-parent `
            --merges `
            --reverse `
            --date=format:'%Y-%m-%d %H:%M:%S' `
            --pretty=format:'MERGE: %H%nFECHA: %ad%nAUTOR: %an <%ae>%nCOMMITTER: %cn <%ce>%nPADRES: %P%nTÍTULO: %s%nDESCRIPCIÓN:%n%b%n'

        Write-Host "`n`n------------------------------------------------------------" -ForegroundColor Magenta
        Write-Host 'HISTORIAL GRÁFICO PRINCIPAL DE LA RAMA' -ForegroundColor Magenta
        Write-Host '------------------------------------------------------------' -ForegroundColor Magenta

        git --no-pager log `
            $Referencia `
            --first-parent `
            --graph `
            --decorate=short `
            --date=format:'%Y-%m-%d %H:%M:%S' `
            --pretty=format:'%h | %ad | %an <%ae> | %s'

        Write-Host "`n"
    }
    finally {
        Pop-Location
    }
}
