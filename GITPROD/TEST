$ErrorActionPreference = 'Stop'

Set-Location 'C:\repo\reportes\APIREPORTS'

$RamaEsperada = 'PRE-MAIN-REPORTS'
$CantidadEsperada = 31

$RamaActual = (git branch --show-current).Trim()

if ($RamaActual -ne $RamaEsperada) {
    throw "La rama actual es $RamaActual; se esperaba $RamaEsperada."
}

$GitDir = (git rev-parse --git-dir).Trim()

if (Test-Path -LiteralPath (Join-Path $GitDir 'CHERRY_PICK_HEAD')) {
    throw 'Todavía existe un cherry-pick activo.'
}

$EstadoInicial = @(git status --porcelain)

if ($EstadoInicial.Count -gt 0) {
    git status --short
    throw 'API Reports no está limpio.'
}

Write-Host 'Buscando marcadores de conflicto...' -ForegroundColor Cyan

$Marcadores = @(
    git grep -n -E '^(<<<<<<<|>>>>>>>)' -- '*.java' '*.properties'
)

if ($LASTEXITCODE -notin @(0, 1)) {
    throw 'No fue posible buscar marcadores de conflicto.'
}

if ($Marcadores.Count -gt 0) {
    $Marcadores
    throw 'Se encontraron marcadores de conflicto.'
}

Write-Host ''
Write-Host 'Ejecutando pruebas de API Reports...' -ForegroundColor Cyan

if (Test-Path -LiteralPath '.\mvnw.cmd') {
    & .\mvnw.cmd test
}
elseif (Get-Command mvn -ErrorAction SilentlyContinue) {
    & mvn test
}
else {
    throw 'No se encontró mvnw.cmd ni Maven instalado.'
}

if ($LASTEXITCODE -ne 0) {
    throw 'Las pruebas de API Reports fallaron. No se hará push.'
}

$EstadoDespuesPruebas = @(git status --porcelain)

if ($EstadoDespuesPruebas.Count -gt 0) {
    git status --short
    throw 'Las pruebas dejaron cambios en el repositorio. No se hará push.'
}

Write-Host ''
Write-Host 'Actualizando referencia remota...' -ForegroundColor Cyan

git fetch origin

if ($LASTEXITCODE -ne 0) {
    throw 'No fue posible actualizar las referencias remotas.'
}

git rev-parse --verify "origin/$RamaEsperada" *> $null

if ($LASTEXITCODE -ne 0) {
    throw "No existe origin/$RamaEsperada."
}

$Comparacion = (
    (git rev-list --left-right --count "origin/$RamaEsperada...HEAD").Trim() `
        -split '\s+'
)

if ($Comparacion.Count -ne 2) {
    throw 'No fue posible calcular la diferencia con la rama remota.'
}

$CommitsSoloRemoto = [int]$Comparacion[0]
$CommitsSoloLocal = [int]$Comparacion[1]

if ($CommitsSoloRemoto -gt 0) {
    throw "El remoto contiene $CommitsSoloRemoto commits que no están localmente. No se hará push."
}

if ($CommitsSoloLocal -ne $CantidadEsperada) {
    throw "Se esperaban $CantidadEsperada commits locales, pero se encontraron $CommitsSoloLocal. No se hará push."
}

Write-Host ''
Write-Host "Validación correcta: $CommitsSoloLocal commits preparados." -ForegroundColor Green
Write-Host ''
Write-Host 'Commits que se publicarán:' -ForegroundColor Cyan

git --no-pager log `
    --oneline `
    --reverse `
    "origin/$RamaEsperada..HEAD"

Write-Host ''
git --no-pager diff --stat "origin/$RamaEsperada..HEAD"

Write-Host ''
$Confirmacion = Read-Host 'Escribe PUBLICAR API REPORTS para realizar el push'

if ($Confirmacion -cne 'PUBLICAR API REPORTS') {
    throw 'Publicación cancelada. No se hizo push.'
}

if ((git branch --show-current).Trim() -ne $RamaEsperada) {
    throw 'La rama cambió antes del push.'
}

if (@(git status --porcelain).Count -gt 0) {
    throw 'El repositorio dejó de estar limpio antes del push.'
}

git push --set-upstream origin $RamaEsperada

if ($LASTEXITCODE -ne 0) {
    throw 'Falló el push de API Reports.'
}

$CommitLocal = (git rev-parse HEAD).Trim()
$CommitRemoto = (git rev-parse "origin/$RamaEsperada").Trim()

if ($CommitLocal -ne $CommitRemoto) {
    throw 'El push terminó, pero la referencia remota no coincide con HEAD.'
}

Write-Host ''
Write-Host 'API REPORTS publicado correctamente.' -ForegroundColor Green
Write-Host "Rama: $RamaEsperada"
Write-Host "Commit final: $CommitLocal"

git status
