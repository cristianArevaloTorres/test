$ErrorActionPreference = 'Stop'

# ============================================================
# CONFIGURACIÓN
# ============================================================

$RepoFront = 'C:\repo\reportes\FRONT'
$RepoApiReports = 'C:\repo\reportes\APIREPORTS'

$RamaOrigenFront = 'origin/issue-reportesabanaQA'
$RamaDestino = 'PRE-MAIN-REPORTS'

$CommitEnConflicto = '282f2338c0a2b018a1e8d199407b4c73f7e02ea6'
$ArchivoGlobal = 'src/app/services/global.ts'

# API Reports ya está preparado localmente.
# Al terminar Front se publicarán ambos repositorios.
$HacerPushDeAmbos = $true

# Estos son únicamente los commits posteriores a 282f2338.
$CommitsRestantesFront = @(
    'a944ff6423d30f88721a8ff4871ccbf955e35171',
