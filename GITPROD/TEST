-----git branch --show-current
# ==========================================
# SOLO CONSULTA: FRONT Y API REPORTS
# ==========================================

$AutorGit = 'consultor.ti40@lockton.com'

$Repositorios = @(
    @{
        Nombre = 'FRONT'
        Ruta   = 'C:\repo\reportes\FRONT'
        Rama   = 'issue-reportesabanaQA'
    },
    @{
        Nombre = 'API REPORTS'
        Ruta   = 'C:\repo\reportes\APIREPORTS'
        Rama   = 'COLOCA_AQUI_LA_RAMA_DE_API_REPORTS'
    }
)

foreach ($Repo in $Repositorios) {
    Write-Host "`n========================================" -ForegroundColor Cyan
    Write-Host $Repo.Nombre -ForegroundColor Cyan
    Write-Host "Ruta: $($Repo.Ruta)"
    Write-Host "Rama: $($Repo.Rama)"
    Write-Host '========================================' -ForegroundColor Cyan

    Push-Location -LiteralPath $Repo.Ruta

    try {
        git rev-parse --is-inside-work-tree | Out-Null
        if ($LASTEXITCODE -ne 0) {
            throw "No es un repositorio Git: $($Repo.Ruta)"
        }

        # No cambia de rama. Determina si se consulta la referencia remota o local.
        git show-ref --verify --quiet "refs/remotes/origin/$($Repo.Rama)"
        if ($LASTEXITCODE -eq 0) {
            $Referencia = "origin/$($Repo.Rama)"
        } else {
            git show-ref --verify --quiet "refs/heads/$($Repo.Rama)"
            if ($LASTEXITCODE -ne 0) {
                Write-Host "No se encontró la rama $($Repo.Rama)." -ForegroundColor Red
                Write-Host 'Ramas disponibles:' -ForegroundColor Yellow
                git branch -a
                continue
            }

            $Referencia = $Repo.Rama
        }

        Write-Host "`nCOMMITS DE NUESTRO USUARIO" -ForegroundColor Green

        git log `
            $Referencia `
            --author="$AutorGit" `
            --date=format:'%Y-%m-%d %H:%M:%S' `
            --pretty=format:'COMMIT: %H%nFECHA: %ad%nAUTOR: %an <%ae>%nPADRES: %P%nTÍTULO: %s%nDESCRIPCIÓN:%n%b%n'

        Write-Host "`n`nTODOS LOS MERGES REALIZADOS SOBRE LA RAMA" -ForegroundColor Yellow

        git log `
            $Referencia `
            --first-parent `
            --merges `
            --date=format:'%Y-%m-%d %H:%M:%S' `
            --pretty=format:'MERGE: %H%nFECHA: %ad%nAUTOR: %an <%ae>%nPADRES: %P%nTÍTULO: %s%nDESCRIPCIÓN:%n%b%n'

        Write-Host "`n`nHISTORIAL GRÁFICO DE LA RAMA" -ForegroundColor Green

        git log `
            $Referencia `
            --first-parent `
            --graph `
            --decorate=short `
            --date=format:'%Y-%m-%d %H:%M:%S' `
            --pretty=format:'%h | %ad | %an <%ae> | %s'

        Write-Host "`n"
    }
    finally {
        Pop-Location
    }
}
