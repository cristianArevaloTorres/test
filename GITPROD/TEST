$ErrorActionPreference = 'Stop'

# ==============================
# PARÁMETROS
# ==============================

$RutaRepo   = 'C:\repo\reportes\FRONT'
$RamaFront  = 'issue-reportesabanaQA'
$UsuarioGit = 'CristianLockton'
$Salida     = 'C:\Users\sanel\Downloads\gitprod\COMMITS_FRONT.txt'

Set-Location -LiteralPath $RutaRepo

git rev-parse --is-inside-work-tree | Out-Null
if ($LASTEXITCODE -ne 0) {
    throw "No es un repositorio Git: $RutaRepo"
}

# Utiliza la rama remota si está disponible.
git show-ref --verify --quiet "refs/remotes/origin/$RamaFront"

if ($LASTEXITCODE -eq 0) {
    $Referencia = "origin/$RamaFront"
} else {
    git show-ref --verify --quiet "refs/heads/$RamaFront"

    if ($LASTEXITCODE -ne 0) {
        Write-Host 'Ramas disponibles:' -ForegroundColor Yellow
        git branch -a
        throw "No se encontró la rama $RamaFront."
    }

    $Referencia = $RamaFront
}

# Obtiene solamente commits directos del usuario.
# --first-parent excluye commits heredados mediante merges.
# --no-merges excluye los propios commits de merge.
$Resultado = @(
    git --no-pager log `
        $Referencia `
        --first-parent `
        --no-merges `
        --author="$UsuarioGit" `
        --reverse `
        --date=format:'%Y-%m-%d %H:%M:%S' `
        --pretty=format:'COMMIT: %H%nFECHA: %ad%nAUTOR: %an <%ae>%nCOMMITTER: %cn <%ce>%nPADRES: %P%nTÍTULO: %s%nDESCRIPCIÓN:%n%b%nARCHIVOS:' `
        --name-status
)

if ($LASTEXITCODE -ne 0) {
    throw 'No fue posible consultar los commits de Front.'
}

$Resultado | Out-File -LiteralPath $Salida -Encoding utf8

Write-Host "`nRama consultada: $Referencia" -ForegroundColor Cyan
Write-Host "Usuario:          $UsuarioGit" -ForegroundColor Cyan
Write-Host "Resultado:        $Salida" -ForegroundColor Green
Write-Host "`nCommits encontrados:" -ForegroundColor Yellow

git --no-pager log `
    $Referencia `
    --first-parent `
    --no-merges `
    --author="$UsuarioGit" `
    --reverse `
    --date=format:'%Y-%m-%d %H:%M:%S' `
    --pretty=format:'%H | %ad | %an <%ae> | %s'



