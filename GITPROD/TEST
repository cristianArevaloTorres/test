-----git branch --show-current
$AutorGit = 'consultor.ti40@lockton.com'
$RamaDestino = 'master'

$Repositorios = @(
    @{
        Nombre = 'FRONT'
        Ruta   = 'C:\repo\reportes\FRONT'
        Origen = 'issue-reportesabanaQA'
    },
    @{
        Nombre = 'API REPORTS'
        Ruta   = 'C:\repo\reportes\APIREPORTS'
        Origen = 'COLOCA_AQUI_LA_RAMA_DE_API_REPORTS'
    }
)

foreach ($Repo in $Repositorios) {
    Write-Host "`n========================================" -ForegroundColor Cyan
    Write-Host $Repo.Nombre -ForegroundColor Cyan
    Write-Host "Repositorio: $($Repo.Ruta)"
    Write-Host "Rama origen: $($Repo.Origen)"
    Write-Host "Comparación: origin/$RamaDestino..origin/$($Repo.Origen)"
    Write-Host "========================================" -ForegroundColor Cyan

    Push-Location -LiteralPath $Repo.Ruta

    try {
        git rev-parse --is-inside-work-tree | Out-Null
        if ($LASTEXITCODE -ne 0) {
            throw "No es un repositorio Git: $($Repo.Ruta)"
        }

        # Solo actualiza referencias remotas; no modifica archivos ni ramas.
        git fetch origin --prune
        if ($LASTEXITCODE -ne 0) {
            throw "No se pudo consultar origin en $($Repo.Nombre)."
        }

        git show-ref --verify --quiet "refs/remotes/origin/$($Repo.Origen)"
        if ($LASTEXITCODE -ne 0) {
            Write-Host 'La rama indicada no existe. Ramas disponibles:' -ForegroundColor Yellow
            git branch -r
            continue
        }

        git show-ref --verify --quiet "refs/remotes/origin/$RamaDestino"
        if ($LASTEXITCODE -ne 0) {
            throw "No existe origin/$RamaDestino."
        }

        Write-Host "`nRama local actual:" -ForegroundColor Yellow
        git branch --show-current

        Write-Host "`nCommits del usuario pendientes de master:" -ForegroundColor Green

        git log `
            "origin/$RamaDestino..origin/$($Repo.Origen)" `
            --author="$AutorGit" `
            --reverse `
            --date=format:'%Y-%m-%d %H:%M:%S' `
            --pretty=format:'COMMIT: %H%nFECHA: %ad%nAUTOR: %an <%ae>%nTÍTULO: %s%nDESCRIPCIÓN:%n%b%nARCHIVOS:' `
            --name-status

        Write-Host "`n`nEstado del repositorio:" -ForegroundColor Yellow
        git status --short
    }
    finally {
        Pop-Location
    }
}
