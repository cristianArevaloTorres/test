$ErrorActionPreference = 'Stop'

Set-Location 'C:\repo\reportes\APIREPORTS'

$RamaEsperada = 'PRE-MAIN-REPORTS'

$CommitsRestantes = @(
    'aa07c52c7bbb3759ed54ccce614064cf3d495d00'
    '02d7f3850ceac219110079132bc69001c63293df'
    'fa5da3c393d2d7a06e5638dfe9b2521ba041106f'
    '7e82654871a659da6b993664016cb73d01c4d625'
    '5631dfcc687b003d7f490d0c5ff26d4e8d393667'
    '63e1d4893c86174efb0e76ab2611153601f8b45e'
)

$RamaActual = (git branch --show-current).Trim()

if ($RamaActual -ne $RamaEsperada) {
    throw "La rama actual es $RamaActual; se esperaba $RamaEsperada."
}

$GitDir = (git rev-parse --git-dir).Trim()
$CherryPickHead = Join-Path $GitDir 'CHERRY_PICK_HEAD'

if (Test-Path -LiteralPath $CherryPickHead) {
    throw 'Todavía existe un cherry-pick activo. Revisa git status antes de continuar.'
}

$CambiosLocales = @(git status --porcelain)

if ($CambiosLocales.Count -gt 0) {
    Write-Host 'El repositorio no está limpio:' -ForegroundColor Red
    git status --short
    throw 'No se aplicarán los commits restantes.'
}

foreach ($Commit in $CommitsRestantes) {
    git cat-file -e "$Commit^{commit}"

    if ($LASTEXITCODE -ne 0) {
        throw "El commit $Commit no existe en el repositorio local."
    }

    Write-Host ''
    Write-Host "Aplicando $Commit..." -ForegroundColor Cyan

    git cherry-pick $Commit

    if ($LASTEXITCODE -ne 0) {
        Write-Host ''
        Write-Host "EL PROCESO SE DETUVO EN: $Commit" -ForegroundColor Red

        $Conflictos = @(git diff --name-only --diff-filter=U)

        if ($Conflictos.Count -gt 0) {
            Write-Host 'Conflictos pendientes:' -ForegroundColor Yellow
            git status --short
        }
        elseif (Test-Path -LiteralPath $CherryPickHead) {
            Write-Host 'El cherry-pick quedó activo, posiblemente porque el commit resultó vacío.' -ForegroundColor Yellow
            git status
        }
        else {
            git status
        }

        throw "No se pudo aplicar $Commit. No se hizo push."
    }

    Write-Host "Aplicado correctamente: $Commit" -ForegroundColor Green
}

$EstadoFinal = @(git status --porcelain)

if ($EstadoFinal.Count -gt 0) {
    git status --short
    throw 'Los commits terminaron, pero el repositorio no quedó limpio.'
}

Write-Host ''
Write-Host 'Los seis commits restantes fueron aplicados correctamente.' -ForegroundColor Green
Write-Host 'Todavía NO se hizo push.' -ForegroundColor Yellow

git status

Write-Host ''
Write-Host 'Commits locales pendientes de publicar:' -ForegroundColor Cyan
git --no-pager log `
    --oneline `
    --decorate `
    --max-count=40 `
    origin/PRE-MAIN-REPORTS..HEAD
