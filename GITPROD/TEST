$ErrorActionPreference = 'Stop'

Set-Location 'C:\repo\reportes\APIREPORTS'

$RamaDestino = 'PRE-MAIN-REPORTS'

$CommitsRestantes = @(
    'e2fea4173447a2eb0bfe01d8cf88180af7aea673',
    '20a20defa0954d617f304b8a1d0efb72d5c7541e',
    '9f75db1d6b072906b222056ae5722dccf648b007',
    '07804c9deaa6c4325ee3b5b10669e65cb817ecda',
    'd2605e23b93236abe4cb6b3b7bd039209391fe6c',
    '956c3669f459dc2bba620df905eeaf95038c7c04',
    '6586aab8ad82ad29a15b87f85440883b0061609e',
    'c902c38d1600625bd53319bac2409de095bc58d6',
    'ef3716c502dbd6b01b24b346c347a2075c70a5ea',
    '22f437eb62cc338429e479a3d571447eeb1d0d63',
    'aa07c52c7bbb3759ed54ccce614064cf3d495d00',
    '02d7f3850ceac219110079132bc69001c63293df',
    'fa5da3c393d2d7a06e5638dfe9b2521ba041106f',
    '7e82654871a659da6b993664016cb73d01c4d625',
    '5631dfcc687b003d7f490d0c5ff26d4e8d393667',
    '63e1d4893c86174efb0e76ab2611153601f8b45e'
)

$RamaActual = (git branch --show-current).Trim()

if ($RamaActual -ne $RamaDestino) {
    throw "Estás en $RamaActual y se esperaba $RamaDestino."
}

$GitDir = (git rev-parse --absolute-git-dir).Trim()

if (Test-Path -LiteralPath (Join-Path $GitDir 'CHERRY_PICK_HEAD')) {
    throw 'Todavía existe un cherry-pick pendiente.'
}

$Estado = git status --porcelain

if (-not [string]::IsNullOrWhiteSpace(($Estado | Out-String))) {
    git status --short
    throw 'El repositorio no está limpio.'
}

Write-Host 'COMMITS RESTANTES:' -ForegroundColor Cyan

foreach ($Commit in $CommitsRestantes) {
    git cat-file -e "${Commit}^{commit}"

    if ($LASTEXITCODE -ne 0) {
        throw "No existe localmente el commit $Commit."
    }

    $Registro = @(
        (git rev-list --parents -n 1 $Commit) -split '\s+'
    )

    if ($Registro.Count -ne 2) {
        throw "El commit $Commit es un merge."
    }

    git --no-pager show `
        --no-patch `
        --format='%h | %an | %s' `
        $Commit
}

$Confirmacion = Read-Host "`nEscribe CONTINUAR API REPORTS"

if ($Confirmacion -ne 'CONTINUAR API REPORTS') {
    throw 'Proceso cancelado.'
}

$Aplicados = 0
$Omitidos = 0

foreach ($Commit in $CommitsRestantes) {
    $Comparacion = (
        git cherry HEAD $Commit "$Commit^" | Out-String
    ).Trim()

    if ($Comparacion.StartsWith('-')) {
        Write-Host "Ya existe un cambio equivalente; se omite: $Commit" -ForegroundColor DarkYellow
        $Omitidos++
        continue
    }

    Write-Host ''
    Write-Host "Aplicando $Commit..." -ForegroundColor Cyan

    git cherry-pick --allow-empty $Commit

    if ($LASTEXITCODE -ne 0) {
        Write-Host ''
        Write-Host "CONFLICTO EN: $Commit" -ForegroundColor Red
        git status --short
        Write-Host 'No se hizo push.' -ForegroundColor Yellow
        throw "El proceso se detuvo en $Commit."
    }

    $Aplicados++
}

$EstadoFinal = git status --porcelain

if (-not [string]::IsNullOrWhiteSpace(($EstadoFinal | Out-String))) {
    git status --short
    throw 'Existen cambios pendientes; no se realizará el push.'
}

Write-Host ''
Write-Host 'API REPORTS TERMINADO' -ForegroundColor Green
Write-Host "Commits aplicados ahora: $Aplicados"
Write-Host "Cambios equivalentes omitidos: $Omitidos"

Write-Host ''
Write-Host 'Commits que se publicarán:' -ForegroundColor Cyan
git --no-pager log --oneline "origin/$RamaDestino..$RamaDestino"

$ConfirmarPush = Read-Host 'Escribe PUBLICAR API REPORTS'

if ($ConfirmarPush -ne 'PUBLICAR API REPORTS') {
    throw 'Los commits quedaron locales, pero no se hizo push.'
}

git push -u origin "$RamaDestino`:$RamaDestino"

if ($LASTEXITCODE -ne 0) {
    throw 'Falló el push de API Reports.'
}

Write-Host ''
Write-Host 'API REPORTS publicado correctamente.' -ForegroundColor Green
git status
