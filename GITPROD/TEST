-----git branch --show-current
# =========================
# PARÁMETROS
# =========================
$RutaRepo   = 'C:\repo\reportes\FRONT'
$RamaOrigen = 'origin/issue-reportesabanaQA'
$RamaQA     = 'origin/QA'
$RamaProd   = 'origin/master'
$AutorGit   = 'consultor.ti40@lockton.com'

Set-Location -LiteralPath $RutaRepo

Write-Host "`nMERGES EXISTENTES EN LA RAMA" -ForegroundColor Cyan

$Merges = @(git rev-list --first-parent --merges $RamaOrigen)

foreach ($Merge in $Merges) {
    $Datos = (git show -s --format='%H|%ad|%an <%ae>|%s|%P' --date=iso $Merge) -split '\|', 5
    $Padres = @($Datos[4] -split ' ')

    # En un merge normal, el segundo padre corresponde a la rama incorporada.
    $SegundoPadre = if ($Padres.Count -gt 1) { $Padres[1] } else { $null }
    $PosibleMergeQA = $false

    if ($SegundoPadre) {
        git merge-base --is-ancestor $SegundoPadre $RamaQA
        $PosibleMergeQA = ($LASTEXITCODE -eq 0)
    }

    Write-Host "`nMERGE: $($Datos[0])" -ForegroundColor Yellow
    Write-Host "Fecha: $($Datos[1])"
    Write-Host "Autor: $($Datos[2])"
    Write-Host "Título: $($Datos[3])"
    Write-Host "Padres: $($Datos[4])"
    Write-Host "Posible origen QA: $PosibleMergeQA"

    if ($SegundoPadre) {
        Write-Host 'Commits introducidos por este merge:' -ForegroundColor DarkCyan

        git log `
            "$($Padres[0])..$SegundoPadre" `
            --reverse `
            --date=format:'%Y-%m-%d %H:%M:%S' `
            --pretty=format:'  %H | %ad | %an <%ae> | %s'
    }
}

Write-Host "`n`nCANDIDATOS DE NUESTRO DESARROLLO" -ForegroundColor Green
Write-Host '(Excluye merges y commits heredados dentro de esos merges)'

git log `
    "$RamaProd..$RamaOrigen" `
    --first-parent `
    --no-merges `
    --author="$AutorGit" `
    --reverse `
    --date=format:'%Y-%m-%d %H:%M:%S' `
    --pretty=format:'%H | %ad | %an <%ae> | %s'
