$ErrorActionPreference = 'Stop'

Set-Location 'C:\repo\reportes\APIREPORTS'

$Rama = 'PRE-MAIN-REPORTS'
$CantidadEsperada = 31

if ((git branch --show-current).Trim() -ne $Rama) {
    throw "Debes estar en la rama $Rama."
}

$GitDir = (git rev-parse --git-dir).Trim()

if (Test-Path -LiteralPath (Join-Path $GitDir 'CHERRY_PICK_HEAD')) {
    throw 'Existe un cherry-pick activo.'
}

if (@(git status --porcelain).Count -gt 0) {
    git status --short
    throw 'El repositorio no está limpio.'
}

Write-Host 'Generando paquete sin ejecutar pruebas...' -ForegroundColor Cyan

& .\mvnw.cmd -DskipTests clean package

if ($LASTEXITCODE -ne 0) {
    throw 'La compilación o generación del paquete falló. No se hará push.'
}

if (@(git status --porcelain).Count -gt 0) {
    git status --short
    throw 'La compilación dejó cambios en archivos controlados.'
}

Write-Host ''
Write-Host 'Actualizando referencias remotas...' -ForegroundColor Cyan

git fetch origin

if ($LASTEXITCODE -ne 0) {
    throw 'No fue posible consultar el remoto.'
}

$Comparacion = (
    (git rev-list --left-right --count "origin/$Rama...HEAD").Trim() `
        -split '\s+'
)

$CommitsRemotos = [int]$Comparacion[0]
$CommitsLocales = [int]$Comparacion[1]

if ($CommitsRemotos -gt 0) {
    throw "El remoto tiene $CommitsRemotos commits que no están localmente."
}

if ($CommitsLocales -ne $CantidadEsperada) {
    throw "Se esperaban $CantidadEsperada commits para publicar, pero se encontraron $CommitsLocales."
}

Write-Host ''
Write-Host "BUILD correcto. Se publicarán $CommitsLocales commits." -ForegroundColor Green
Write-Host 'ADVERTENCIA: las pruebas no se ejecutaron por el fallo de Surefire.' -ForegroundColor Yellow

$Confirmacion = Read-Host 'Escribe PUBLICAR API REPORTS SIN PRUEBAS'

if ($Confirmacion -cne 'PUBLICAR API REPORTS SIN PRUEBAS') {
    throw 'Publicación cancelada.'
}

git push --set-upstream origin $Rama

if ($LASTEXITCODE -ne 0) {
    throw 'Falló el push de API Reports.'
}

$Local = (git rev-parse HEAD).Trim()
$Remoto = (git rev-parse "origin/$Rama").Trim()

if ($Local -ne $Remoto) {
    throw 'El remoto no coincide con el commit local.'
}

Write-Host ''
Write-Host 'API REPORTS publicado correctamente.' -ForegroundColor Green
Write-Host "Commit final: $Local"

git status
