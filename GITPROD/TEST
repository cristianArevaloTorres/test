foreach ($Entrega in $Entregas) {
    $Nombre       = $Entrega.Nombre
    $Ruta         = $Entrega.Ruta
    $RamaOrigen   = $Entrega.Origen
    $RamaDestino  = $Entrega.Destino
    $Commits      = @($Entrega.Commits)
    $OrigenRemoto = "origin/$RamaOrigen"
    $DestinoRemoto = "origin/$RamaDestino"

    Write-Host "`n============================================================" -ForegroundColor Cyan
    Write-Host "REPOSITORIO: $Nombre" -ForegroundColor Cyan
    Write-Host "ORIGEN:      $RamaOrigen"
    Write-Host "DESTINO:     $RamaDestino"
    Write-Host "COMMITS:     $($Commits.Count)"
    Write-Host '============================================================' -ForegroundColor Cyan

    if ($RamaDestino -like 'COLOCA_AQUI_*') {
        throw "Debes configurar la rama destino de $Nombre."
    }

    if (-not (Test-Path -LiteralPath $Ruta -PathType Container)) {
        throw "No existe el repositorio: $Ruta"
    }

    Push-Location -LiteralPath $Ruta

    try {
        git rev-parse --is-inside-work-tree | Out-Null
        if ($LASTEXITCODE -ne 0) {
            throw "No es un repositorio Git: $Ruta"
        }

        # Evita mezclar cambios locales con la entrega.
        $CambiosLocales = git status --porcelain

        if (-not [string]::IsNullOrWhiteSpace(($CambiosLocales | Out-String))) {
            Write-Host 'Existen cambios locales:' -ForegroundColor Red
            $CambiosLocales
            throw "El repositorio $Nombre no está limpio."
        }

        git fetch origin --prune
        if ($LASTEXITCODE -ne 0) {
            throw "Falló git fetch en $Nombre."
        }

        git show-ref --verify --quiet "refs/remotes/$OrigenRemoto"
        if ($LASTEXITCODE -ne 0) {
            Write-Host 'Ramas remotas disponibles:' -ForegroundColor Yellow
            git branch -r
            throw "No existe la rama origen $OrigenRemoto."
        }

        git show-ref --verify --quiet "refs/remotes/$DestinoRemoto"
        if ($LASTEXITCODE -ne 0) {
            Write-Host 'Ramas remotas disponibles:' -ForegroundColor Yellow
            git branch -r
            throw "No existe la rama destino $DestinoRemoto."
        }

        Write-Host "`nValidando commits..." -ForegroundColor Cyan

        foreach ($Commit in $Commits) {
            git cat-file -e "${Commit}^{commit}"
            if ($LASTEXITCODE -ne 0) {
                throw "No se encontró el commit $Commit."
            }

            git merge-base --is-ancestor $Commit $OrigenRemoto
            if ($LASTEXITCODE -ne 0) {
                throw "El commit $Commit no pertenece a $OrigenRemoto."
            }

            $Registro = @(
                (git rev-list --parents -n 1 $Commit) -split '\s+'
            )

            # Un commit normal contiene: hash actual + un padre.
            # Los commits vacíos siguen cumpliendo esta condición.
            if ($Registro.Count -ne 2) {
                throw "El commit $Commit es un merge y no puede incluirse."
            }
        }

        Write-Host "`nCOMMITS QUE SE APLICARÁN:" -ForegroundColor Green

        foreach ($Commit in $Commits) {
            git --no-pager show `
                --no-patch `
                --date=format:'%Y-%m-%d %H:%M:%S' `
                --format='%H | %ad | %an <%ae> | %s' `
                $Commit
        }

        $Confirmacion = Read-Host "`nEscribe APLICAR $Nombre para continuar"

        if ($Confirmacion -ne "APLICAR $Nombre") {
            Write-Host "Se omitió $Nombre." -ForegroundColor Yellow
            continue
        }

        # ====================================================
        # CAMBIAR A LA RAMA DESTINO
        # ====================================================

        git show-ref --verify --quiet "refs/heads/$RamaDestino"

        if ($LASTEXITCODE -eq 0) {
            git switch $RamaDestino
        } else {
            git switch --track -c $RamaDestino $DestinoRemoto
        }

        if ($LASTEXITCODE -ne 0) {
            throw "No fue posible cambiar a $RamaDestino."
        }

        git pull --ff-only origin $RamaDestino
        if ($LASTEXITCODE -ne 0) {
            throw "No fue posible actualizar $RamaDestino."
        }

        # ====================================================
        # CHERRY-PICK EN EL ORDEN ORIGINAL
        # ====================================================

        $Aplicados = 0

        foreach ($Commit in $Commits) {
            # Omite únicamente cuando el hash exacto ya forma parte
            # de la rama destino.
            git merge-base --is-ancestor $Commit HEAD

            if ($LASTEXITCODE -eq 0) {
                Write-Host "Ya existe en destino: $Commit" -ForegroundColor DarkYellow
                continue
            }

            Write-Host "`nAplicando $Commit..." -ForegroundColor Cyan

            # --allow-empty conserva los tres commits vacíos de Front.
            git cherry-pick --allow-empty $Commit

            if ($LASTEXITCODE -ne 0) {
                Write-Host "`nEL PROCESO SE DETUVO EN: $Commit" -ForegroundColor Red
                Write-Host 'Después de resolver los conflictos:' -ForegroundColor Yellow
                Write-Host '  git add -- <archivos-resueltos>'
                Write-Host '  git cherry-pick --continue'
                Write-Host ''
                Write-Host 'Para cancelar el cherry-pick actual:'
                Write-Host '  git cherry-pick --abort'

                throw "Conflicto durante el cherry-pick de $Commit."
            }

            $Aplicados++
        }

        Write-Host "`n$Nombre TERMINADO" -ForegroundColor Green
        Write-Host "Commits aplicados: $Aplicados"
        git status --short

        Write-Host "`nÚltimos commits de la rama destino:" -ForegroundColor Cyan
        git --no-pager log --oneline -n $Commits.Count

        if ($HacerPush) {
            git push -u origin $RamaDestino

            if ($LASTEXITCODE -ne 0) {
                throw "Los commits quedaron localmente, pero falló el push de $Nombre."
            }

            Write-Host "Publicado correctamente en origin/$RamaDestino." -ForegroundColor Green
        } else {
            Write-Host "`nNo se hizo push porque `$HacerPush está en `$false." -ForegroundColor Yellow
            Write-Host 'Después de validar, publica con:' -ForegroundColor Yellow
            Write-Host "git push -u origin $RamaDestino"
        }
    }
    finally {
        Pop-Location
    }
}






