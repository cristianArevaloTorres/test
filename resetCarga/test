$BackendRepo = "C:\repo\resertCarga\back"

Set-Location $BackendRepo

$RamaActual = (git branch --show-current).Trim()

if ($RamaActual -eq "QA") {
    git switch -c CargaDefaulteo

    if ($LASTEXITCODE -ne 0) {
        throw "No fue posible crear la rama CargaDefaulteo."
    }
}
elseif ($RamaActual -ne "CargaDefaulteo") {
    throw "Debes estar en QA o CargaDefaulteo. Rama actual: $RamaActual"
}

Write-Host "Rama correcta: CargaDefaulteo" -ForegroundColor Green

$BackendFiles = @(
    "src/main/java/com/lockton/WSBeFlex/AsyncConfig.java"
    "src/main/java/com/lockton/WSBeFlex/DAO/FfCargaMasivaDAO.java"
    "src/main/java/com/lockton/WSBeFlex/DAO/JDBCFfCargaMasiva.java"
    "src/main/java/com/lockton/WSBeFlex/POJO/Especiales/FfCOpcionesCargaMasiva.java"
    "src/main/java/com/lockton/WSBeFlex/REST/WSTitularesAdm.java"
)

$EliminarBackend = @(
    "database/001_catalogo_y_flujo_carga_masiva.sql"
    "database/009_infraestructura_cadena_ws_ford.sql"
    "src/main/java/com/lockton/WSBeFlex/Config/CargaMasivaTraceFilter.java"
    "src/main/java/com/lockton/WSBeFlex/DAO/CargaCadenaWsDAO.java"
    "src/main/java/com/lockton/WSBeFlex/DAO/CargaMasivaB2DAO.java"
    "src/main/java/com/lockton/WSBeFlex/DAO/CargaMasivaFlujoDAO.java"
    "src/main/java/com/lockton/WSBeFlex/DAO/JDBCCargaMasivaFlujo.java"
    "src/main/java/com/lockton/WSBeFlex/POJO/Especiales/FFConfiguracionFlujoCargaMasiva.java"
    "src/main/java/com/lockton/WSBeFlex/REST/WSCargaMasivaB2.java"
    "src/main/java/com/lockton/WSBeFlex/REST/WSCargaMasivaCadenaWs.java"
    "src/main/java/com/lockton/WSBeFlex/REST/WSCargaMasivaFlujo.java"
    "src/main/java/com/lockton/WSBeFlex/Services/CadenaWs"
    "src/main/java/com/lockton/WSBeFlex/Services/CargaMasivaB2"
    "src/main/java/com/lockton/WSBeFlex/Services/CargaMasivaFlujoService.java"
    "src/test/java/com/lockton/WSBeFlex/Config/CargaMasivaTraceFilterTest.java"
    "src/test/java/com/lockton/WSBeFlex/DAO/JDBCFfCargaMasivaTest.java"
    "src/test/java/com/lockton/WSBeFlex/Services/CadenaWs"
    "src/test/java/com/lockton/WSBeFlex/Services/CargaMasivaB2"
)

# Agregar los archivos restaurados
git add -- $BackendFiles

if ($LASTEXITCODE -ne 0) {
    throw "No fue posible agregar los archivos restaurados."
}

# Eliminar y registrar los archivos versionados
git rm -r --ignore-unmatch -- $EliminarBackend

if ($LASTEXITCODE -ne 0) {
    throw "No fue posible registrar las eliminaciones."
}

# Eliminar únicamente restos no versionados de esas mismas rutas.
# Esto evita que Maven los compile localmente aunque no pertenezcan al commit.
$RestosNoVersionados = @(git clean -nd -- $EliminarBackend)

if ($RestosNoVersionados.Count -gt 0) {
    Write-Host "Se eliminaran estos restos no versionados:" -ForegroundColor Yellow
    $RestosNoVersionados | ForEach-Object { Write-Host $_ }

    git clean -fd -- $EliminarBackend

    if ($LASTEXITCODE -ne 0) {
        throw "No fue posible limpiar los archivos no versionados."
    }
}

# Los avisos de espacios son heredados de producción y no bloquean el reset
git diff --cached --check

if ($LASTEXITCODE -ne 0) {
    Write-Warning "Hay espacios finales heredados de produccion. Se conservaran para no alterar los archivos originales."
}

# Mostrar cambios sin abrir paginador
git --no-pager diff --cached --name-status

# Confirmar que realmente existen cambios preparados
git diff --cached --quiet
$ResultadoCambios = $LASTEXITCODE

if ($ResultadoCambios -eq 0) {
    throw "No hay cambios preparados para confirmar."
}

if ($ResultadoCambios -ne 1) {
    throw "No fue posible comprobar los cambios preparados."
}

git commit -m "Reset de carga masiva a la version productiva"

if ($LASTEXITCODE -ne 0) {
    throw "No fue posible crear el commit."
}

git push -u origin CargaDefaulteo

if ($LASTEXITCODE -ne 0) {
    throw "No fue posible enviar la rama CargaDefaulteo."
}

Write-Host "Reset enviado correctamente a origin/CargaDefaulteo." -ForegroundColor Green
